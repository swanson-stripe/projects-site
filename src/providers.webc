---
layout: "main.webc"
title: "Providers"
seoTitle: "Stripe Projects: Providers"
ogTitle: "Stripe Projects: Providers"
seoDesc: "Browse all supported providers in the Stripe Projects catalog. Provision hosting, databases, auth, AI, analytics, and more from the CLI."
ogDesc: "Browse all supported providers in the Stripe Projects catalog. Provision hosting, databases, auth, AI, analytics, and more from the CLI."
ogImage: "/assets/images/og/default.jpg"
ogImageAlt: ""
changefreq: "weekly"
wave: false
---

<div class="relative w-full">

    <!--- Header --->
    <header class="relative w-full flex items-center justify-center px-16 z-50">
        <helm-container class="relative pt-24 pb-12 flex items-center justify-center">
            <a href="/" class="relative flex items-center h-40 gap-4">
                <div class="relative flex items-center gap-8 h-full px-10 -ml-9">
                    <icon-logo class="h-[1em] w-auto text-headline"></icon-logo>
                    <span class="text-16 font-normal text-headline">Stripe Projects</span>
                </div>
            </a>
        </helm-container>
    </header>

    <main id="main">

        <!--- Page header --->
        <helm-section class="relative z-10">
            <helm-container class="pt-24 sm:pt-48 pb-32">
                <h1 class="text-36/110 sm:text-48/110 tracking-tighter text-headline mb-8">Providers</h1>
                <p class="text-16 sm:text-18/150 text-content">Browse and provision services from supported providers. Click any install command to copy it.</p>
            </helm-container>
        </helm-section>

        <!--- Info cards --->
        <helm-section class="relative z-10">
            <helm-container class="flex flex-col sm:flex-row gap-16 pb-32">
                <!--- Install command --->
                <div class="flex-1 rounded-6 border border-edge p-24">
                    <h2 class="text-16 font-normal text-headline mb-8">Install command</h2>
                    <div class="rounded-4 bg-foreground p-12 font-mono text-12 text-detail shadow-inset-border overflow-x-auto">
                        <span class="text-detail select-none">$ </span>stripe projects add &lt;provider&gt;/&lt;service&gt;
                    </div>
                </div>
                <!--- Links --->
                <div class="flex-1 flex flex-col gap-8">
                        <a href="/llm.txt" target="_blank" class="flex items-center justify-between gap-8 px-12 py-8 rounded-4 border border-edge hover:bg-highlight transition-colors duration-150 group">
                            <div>
                                <div class="text-14 font-normal text-headline">llms.txt</div>
                                <div class="text-12 text-detail">Service discovery for agents</div>
                            </div>
                            <icon-arrowanimate @size="sm" class="text-detail group-hover:text-headline transition-colors duration-150"></icon-arrowanimate>
                        </a>
                        <a href="https://docs.stripe.com/projects" target="_blank" rel="noopener" class="flex items-center justify-between gap-8 px-12 py-8 rounded-4 border border-edge hover:bg-highlight transition-colors duration-150 group">
                            <div>
                                <div class="text-14 font-normal text-headline">Projects docs</div>
                                <div class="text-12 text-detail">Full documentation</div>
                            </div>
                            <icon-arrowanimate @size="sm" class="text-detail group-hover:text-headline transition-colors duration-150"></icon-arrowanimate>
                        </a>
                        <a href="https://docs.stripe.com/stripe-cli" target="_blank" rel="noopener" class="flex items-center justify-between gap-8 px-12 py-8 rounded-4 border border-edge hover:bg-highlight transition-colors duration-150 group">
                            <div>
                                <div class="text-14 font-normal text-headline">Stripe CLI</div>
                                <div class="text-12 text-detail">Install and setup guide</div>
                            </div>
                            <icon-arrowanimate @size="sm" class="text-detail group-hover:text-headline transition-colors duration-150"></icon-arrowanimate>
                        </a>
                </div>
                <!--- Suggest provider --->
                <div class="flex-1 rounded-6 border border-edge p-24">
                    <h2 class="text-16 font-normal text-headline mb-8">Missing a provider?</h2>
                    <p class="text-14 text-content leading-140 mb-16">Let us know what services we should add next.</p>
                    <a href="mailto:provider-request@stripe.com?subject=Provider%20Request" class="relative flex items-center gap-6 text-14 font-normal text-primary hover:text-primary-hover transition-colors duration-250 cursor-pointer group outline-none">
                        <span class="pb-1">Suggest a provider</span>
                        <icon-arrowanimate @size="sm" class=""></icon-arrowanimate>
                    </a>
                </div>
            </helm-container>
        </helm-section>

        <!--- Provider table --->
        <helm-section class="relative z-10 pb-64">
            <helm-container>

                <!--- Search + filter --->
                <div class="relative flex flex-col sm:flex-row gap-12 mb-24">
                        <div class="relative flex-1">
                            <input data-provider-search type="text" placeholder="Search providers..." class="w-full h-40 px-12 bg-highlight rounded-6 shadow-inset-border text-14 text-headline placeholder:text-detail outline-none focus:shadow-focus transition-shadow duration-200">
                        </div>
                        <div data-category-pills class="relative flex items-center gap-6 flex-wrap">
                            <button data-category="all" class="provider-pill active px-12 h-32 rounded-full text-12 font-normal cursor-pointer outline-none transition-all duration-150 whitespace-nowrap">All</button>
                            <button data-category="hosting" class="provider-pill px-12 h-32 rounded-full text-12 font-normal cursor-pointer outline-none transition-all duration-150 whitespace-nowrap">Hosting</button>
                            <button data-category="database" class="provider-pill px-12 h-32 rounded-full text-12 font-normal cursor-pointer outline-none transition-all duration-150 whitespace-nowrap">Database</button>
                            <button data-category="sandbox" class="provider-pill px-12 h-32 rounded-full text-12 font-normal cursor-pointer outline-none transition-all duration-150 whitespace-nowrap">Sandbox</button>
                            <button data-category="auth" class="provider-pill px-12 h-32 rounded-full text-12 font-normal cursor-pointer outline-none transition-all duration-150 whitespace-nowrap">Auth</button>
                            <button data-category="analytics" class="provider-pill px-12 h-32 rounded-full text-12 font-normal cursor-pointer outline-none transition-all duration-150 whitespace-nowrap">Analytics</button>
                            <button data-category="ai" class="provider-pill px-12 h-32 rounded-full text-12 font-normal cursor-pointer outline-none transition-all duration-150 whitespace-nowrap">AI</button>
                            <button data-category="search" class="provider-pill px-12 h-32 rounded-full text-12 font-normal cursor-pointer outline-none transition-all duration-150 whitespace-nowrap">Search</button>
                        </div>
                    </div>

                    <!--- Provider table --->
                    <table class="w-full border-collapse rounded-6 border border-edge overflow-hidden text-left">
                        <thead>
                            <tr class="bg-foreground border-b border-edge text-12 text-detail uppercase tracking-wider">
                                <th class="font-normal px-16 py-10" style="width:18%">Provider</th>
                                <th class="font-normal px-16 py-10" style="width:12%">Category</th>
                                <th class="font-normal px-16 py-10">Description</th>
                                <th class="font-normal px-16 py-10 whitespace-nowrap">Install command</th>
                            </tr>
                        </thead>
                        <tbody data-provider-list>
                            <tr data-provider-row data-name="amplitude" data-category="analytics" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">Amplitude</td>
                                <td class="px-16 py-12 text-14 text-content capitalize align-top">Analytics</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">Digital analytics platform for understanding user behavior, building funnels, measuring retention, and running A/B experiments to drive product growth.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add amplitude/analytics" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add amplitude/analytics</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="chroma" data-category="database" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">Chroma</td>
                                <td class="px-16 py-12 text-14 text-content capitalize align-top">Database</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">AI-native vector database. Fast, serverless search supporting vector, full-text, regex, and metadata queries.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add chroma/database" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add chroma/database</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="clerk" data-category="auth" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">Clerk</td>
                                <td class="px-16 py-12 text-14 text-content capitalize align-top">Auth</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">Drop-in authentication with social login, magic links, MFA, and full user management UI.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add clerk/auth" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add clerk/auth</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="cloudflare" data-category="hosting" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">Cloudflare</td>
                                <td class="px-16 py-12 text-14 text-content capitalize align-top">Hosting</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">Edge platform for running, securing, and accelerating apps without managing infrastructure. Global network with routing, protection, and performance built in.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add cloudflare/worker" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add cloudflare/worker</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="firecrawl" data-category="search" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">Firecrawl</td>
                                <td class="px-16 py-12 text-14 text-content capitalize align-top">Search</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">Web scraping and crawling API that turns any website into clean, structured data for AI apps. Supports JS rendering, markdown output, and LLM-ready formatting.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add firecrawl/api" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add firecrawl/api</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="fly.io" data-category="hosting" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">Fly.io</td>
                                <td class="px-16 py-12 text-14 text-content capitalize align-top">Hosting</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">Deploy full-stack apps and databases globally on fast hardware with low-latency networking and built-in Postgres and Redis.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add flyio/app" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add flyio/app</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="hugging face" data-category="ai" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">Hugging Face</td>
                                <td class="px-16 py-12 text-14 text-content align-top">AI</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">ML platform for hosting, training, and deploying models and datasets. Access thousands of open-source models and run inference with a simple API.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add huggingface/platform" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add huggingface/platform</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="inngest" data-category="ai" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">Inngest</td>
                                <td class="px-16 py-12 text-14 text-content align-top">AI</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">Event-driven platform for background jobs, scheduled tasks, and long-running AI workflows with built-in retries, step functions, and full observability.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add inngest/app" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add inngest/app</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="mixpanel" data-category="analytics" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">Mixpanel</td>
                                <td class="px-16 py-12 text-14 text-content capitalize align-top">Analytics</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">Event-based analytics for tracking user actions, building conversion funnels, and measuring retention to make data-driven product decisions.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add mixpanel/analytics" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add mixpanel/analytics</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="neon" data-category="database" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">Neon</td>
                                <td class="px-16 py-12 text-14 text-content capitalize align-top">Database</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">Serverless Postgres with instant provisioning, autoscaling, and database branching.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add neon/postgres" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add neon/postgres</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="openrouter" data-category="ai" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">OpenRouter</td>
                                <td class="px-16 py-12 text-14 text-content align-top">AI</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">Single API to access hundreds of models from OpenAI, Anthropic, Google, Meta, and more. Route to the best model for cost, speed, or capability automatically.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add openrouter/api" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add openrouter/api</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="planetscale" data-category="database" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">PlanetScale</td>
                                <td class="px-16 py-12 text-14 text-content capitalize align-top">Database</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">Serverless MySQL platform with NVMe-backed performance, horizontal sharding, and enterprise-grade reliability.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add planetscale/postgresql" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add planetscale/postgresql</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="posthog" data-category="analytics" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">PostHog</td>
                                <td class="px-16 py-12 text-14 text-content capitalize align-top">Analytics</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">Product analytics with session replay, feature flags, A/B testing, data warehouse, and CDP in one platform.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add posthog/analytics" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add posthog/analytics</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="railway" data-category="hosting" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">Railway</td>
                                <td class="px-16 py-12 text-14 text-content capitalize align-top">Hosting</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">Infrastructure for devs. Deploy servers, databases, and cron jobs with zero ops overhead.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add railway/hosting" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add railway/hosting</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="runloop" data-category="sandbox" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">Runloop</td>
                                <td class="px-16 py-12 text-14 text-content align-top">Sandbox</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">Secure execution infrastructure for AI agents. Isolated micro-VM sandboxes for safe code execution and tool use.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add runloop/sandbox" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add runloop/sandbox</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="supabase" data-category="database" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">Supabase</td>
                                <td class="px-16 py-12 text-14 text-content capitalize align-top">Database</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">Open source Firebase alternative with managed Postgres, Auth, Storage, Edge Functions, Realtime, and Vector search.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add supabase/supabase:free" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add supabase/supabase:free</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="turso" data-category="database" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">Turso</td>
                                <td class="px-16 py-12 text-14 text-content capitalize align-top">Database</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">SQLite for the agentic era. Lightweight, replicated databases with built-in vector search and automatic sync.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add turso/database" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add turso/database</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="vercel" data-category="hosting" class="hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">Vercel</td>
                                <td class="px-16 py-12 text-14 text-content capitalize align-top">Hosting</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">Frontend cloud platform. Deploy to the edge with automatic CI/CD, edge functions, and global CDN.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add vercel/project" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add vercel/project</span></button></td>
                            </tr>
                        </tbody>
                    </table>
                    <div data-provider-empty class="hidden flex-col items-center justify-center py-48 text-detail text-14">
                        <p>No providers match your search.</p>
                    </div>

            </helm-container>
        </helm-section>

    </main>

    <!--- Copy toast --->
    <div data-copy-toast class="fixed bottom-24 left-1/2 -translate-x-1/2 z-50 flex items-center gap-8 px-16 h-40 bg-headline text-highlight rounded-8 text-14 font-normal shadow-lg pointer-events-none" style="opacity:0;visibility:hidden;">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-14 h-14 text-[#4ade80] shrink-0"><path fill-rule="evenodd" d="M12.416 3.376a.75.75 0 0 1 .208 1.04l-5 7.5a.75.75 0 0 1-1.154.114l-3-3a.75.75 0 0 1 1.06-1.06l2.353 2.353 4.493-6.74a.75.75 0 0 1 1.04-.207Z" clip-rule="evenodd"/></svg>
        <span data-copy-toast-label>Command copied</span>
    </div>

    <!--- Footer --->
    <footer class="w-full flex items-center justify-center flex-col px-16">
        <helm-container class="relative flex flex-col sm:flex-row sm:items-center sm:justify-between gap-16 py-24 border-t border-edge">
            <p class="text-14/150 text-detail" @text="`© ` + base.currentYear() + ` Stripe`"></p>
            <div class="flex flex-col sm:flex-row sm:items-center gap-16 sm:gap-24">
                <a href="https://stripe.com/privacy" class="text-14/150 font-normal text-primary hover:text-primary-hover transition-colors duration-250 outline-none">Privacy &amp; Terms</a>
                <a href="https://stripe.com" class="text-14/150 font-normal text-primary hover:text-primary-hover transition-colors duration-250 outline-none">Go to Stripe</a>
            </div>
        </helm-container>
    </footer>

</div>

<style>
    @media (max-width: 39.99rem) {
        table, thead, tbody, tr, th, td {
            display: block;
        }
        thead {
            display: none;
        }
        tr[data-provider-row] {
            padding: 0.75rem 1rem;
        }
        tr[data-provider-row] td {
            padding: 0;
        }
        tr[data-provider-row] td:first-child {
            padding-bottom: 0.125rem;
        }
        tr[data-provider-row] td:nth-child(2) {
            padding-bottom: 0.375rem;
        }
        tr[data-provider-row] td:nth-child(3) {
            padding-bottom: 0.375rem;
        }
    }
    .provider-pill {
        background-color: var(--color-foreground);
        color: var(--color-detail);
        border: 1px solid var(--color-edge);
    }
    .provider-pill:hover {
        background-color: var(--color-highlight);
        color: var(--color-headline);
    }
    .provider-pill.active {
        background-color: var(--color-primary);
        color: var(--color-highlight);
        border-color: var(--color-primary);
    }
    .provider-pill:focus-visible {
        box-shadow: var(--shadow-focus);
    }
</style>

<script>
    // Toast
    function showCopyToast(message) {
        const toast = document.querySelector('[data-copy-toast]');
        const label = document.querySelector('[data-copy-toast-label]');
        if (!toast) return;
        if (label) label.textContent = message;
        gsap.killTweensOf(toast);
        gsap.fromTo(toast,
            { autoAlpha: 0, y: 8 },
            { autoAlpha: 1, y: 0, duration: 0.2, ease: 'power2.out' }
        );
        clearTimeout(toast._timer);
        toast._timer = setTimeout(() => {
            gsap.to(toast, { autoAlpha: 0, y: 8, duration: 0.25, ease: 'power2.in' });
        }, 2500);
    }

    // Copy provider command
    document.querySelectorAll('[data-copy-provider]').forEach(btn => {
        btn.addEventListener('click', () => {
            const command = btn.getAttribute('data-copy-provider');
            navigator.clipboard.writeText(command);
            showCopyToast('Command copied');
        });
    });

    // Search + filter
    (function providerFilter() {
        const searchInput = document.querySelector('[data-provider-search]');
        const pills = document.querySelectorAll('.provider-pill');
        const rows = document.querySelectorAll('[data-provider-row]');
        const emptyState = document.querySelector('[data-provider-empty]');
        let activeCategory = 'all';

        function filterRows() {
            const query = (searchInput?.value || '').toLowerCase().trim();
            let visibleCount = 0;

            rows.forEach(row => {
                const name = row.getAttribute('data-name') || '';
                const category = row.getAttribute('data-category') || '';
                const matchesCategory = activeCategory === 'all' || category === activeCategory;
                const matchesSearch = !query || name.includes(query);
                const visible = matchesCategory && matchesSearch;
                row.style.display = visible ? '' : 'none';
                if (visible) visibleCount++;
            });

            if (emptyState) {
                emptyState.style.display = visibleCount === 0 ? 'flex' : 'none';
            }
        }

        if (searchInput) {
            searchInput.addEventListener('input', filterRows);
        }

        pills.forEach(pill => {
            pill.addEventListener('click', () => {
                pills.forEach(p => p.classList.remove('active'));
                pill.classList.add('active');
                activeCategory = pill.getAttribute('data-category') || 'all';
                filterRows();
            });
        });
    })();
</script>
