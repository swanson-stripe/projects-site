---
layout: "main.webc"
title: "Providers"
seoTitle: "Stripe Projects: Providers"
ogTitle: "Stripe Projects: Providers"
seoDesc: "Browse all supported providers in the Stripe Projects catalog. Provision hosting, databases, auth, AI, analytics, and more from the CLI."
ogDesc: "Browse all supported providers in the Stripe Projects catalog. Provision hosting, databases, auth, AI, analytics, and more from the CLI."
ogImage: "/assets/images/og/default.jpg"
ogImageAlt: ""
changefreq: "weekly"
wave: false
---

<div class="relative w-full">

    <!--- Header --->
    <header class="relative w-full flex items-center justify-center px-16 z-50">
        <helm-container class="relative pt-24 pb-12 grid grid-cols-3 items-center">
            <div></div>
            <a href="/" class="relative flex items-center justify-center h-40 gap-4">
                <div class="relative flex items-center gap-8 h-full px-10 whitespace-nowrap">
                    <icon-logo class="h-[1em] w-auto text-headline shrink-0"></icon-logo>
                    <span class="text-16 font-normal text-headline">Stripe Projects</span>
                </div>
            </a>
            <div></div>
        </helm-container>
    </header>

    <main id="main">

        <!--- Page header --->
        <helm-section class="relative z-10">
            <helm-container class="pt-24 sm:pt-48 pb-32">
                <h1 class="text-36/110 sm:text-48/110 tracking-tighter text-headline mb-8">Providers</h1>
                <p class="text-16 sm:text-18/150 text-content">Browse and provision services from supported providers. Click any install command to copy it.</p>
            </helm-container>
        </helm-section>

        <!--- Info cards --->
        <helm-section class="relative z-10">
            <helm-container class="flex flex-col sm:flex-row gap-16 pb-32">
                <!--- Install command --->
                <div class="flex-1 rounded-6 border border-edge p-24">
                    <h2 class="text-16 font-normal text-headline mb-8">Install command</h2>
                    <div class="rounded-4 bg-foreground p-12 font-mono text-12 text-detail shadow-inset-border overflow-x-auto">
                        <span class="text-detail select-none">$ </span>stripe projects add &lt;provider&gt;/&lt;service&gt;
                    </div>
                </div>
                <!--- Links --->
                <div class="flex-1 flex flex-col gap-8">
                        <a href="/llms.txt" target="_blank" class="flex items-center justify-between gap-8 px-12 py-8 rounded-4 border border-edge hover:bg-highlight transition-colors duration-150 group">
                            <div>
                                <div class="text-14 font-normal text-headline">llms.txt</div>
                                <div class="text-12 text-detail">Service discovery for agents</div>
                            </div>
                            <icon-arrowanimate @size="sm" class="text-detail group-hover:text-headline transition-colors duration-150"></icon-arrowanimate>
                        </a>
                        <a href="https://docs.stripe.com/projects" target="_blank" rel="noopener" class="flex items-center justify-between gap-8 px-12 py-8 rounded-4 border border-edge hover:bg-highlight transition-colors duration-150 group">
                            <div>
                                <div class="text-14 font-normal text-headline">Projects docs</div>
                                <div class="text-12 text-detail">Full documentation</div>
                            </div>
                            <icon-arrowanimate @size="sm" class="text-detail group-hover:text-headline transition-colors duration-150"></icon-arrowanimate>
                        </a>
                        <a href="https://docs.stripe.com/stripe-cli" target="_blank" rel="noopener" class="flex items-center justify-between gap-8 px-12 py-8 rounded-4 border border-edge hover:bg-highlight transition-colors duration-150 group">
                            <div>
                                <div class="text-14 font-normal text-headline">Stripe CLI</div>
                                <div class="text-12 text-detail">Install and setup guide</div>
                            </div>
                            <icon-arrowanimate @size="sm" class="text-detail group-hover:text-headline transition-colors duration-150"></icon-arrowanimate>
                        </a>
                </div>
                <!--- Suggest provider --->
                <div class="flex-1 rounded-6 border border-edge p-24">
                    <h2 class="text-16 font-normal text-headline mb-8">Missing a provider?</h2>
                    <p class="text-14 text-content leading-140 mb-16">Let us know what services we should add next.</p>
                    <a href="mailto:provider-request@stripe.com?subject=Provider%20Request" class="relative flex items-center gap-6 text-14 font-normal text-primary hover:text-primary-hover transition-colors duration-250 cursor-pointer group outline-none">
                        <span class="pb-1">Suggest a provider</span>
                        <icon-arrowanimate @size="sm" class=""></icon-arrowanimate>
                    </a>
                </div>
            </helm-container>
        </helm-section>

        <!--- Provider table --->
        <helm-section class="relative z-10 pb-64">
            <helm-container>

                <!--- Search + filter. Search sits on its own row: there are 22 category
                      pills now that every real category has one, and they need the full
                      width to wrap. --->
                <div class="relative flex flex-col gap-12 mb-24">
                        <div class="relative w-full sm:w-240">
                            <input data-provider-search type="text" placeholder="Search providers and categories..." class="w-full h-32 px-12 bg-highlight rounded-6 shadow-inset-border text-14 text-headline placeholder:text-detail outline-none focus:shadow-focus transition-shadow duration-200">
                        </div>
                        <!--- Pills come from the catalog (src/_data/providerRows.js) so they
                              cannot drift from it — every id here is a real category you can
                              also pass to `stripe projects catalog <category>`. --->
                        <div data-category-pills class="relative flex items-center gap-6 flex-wrap">
                            <button webc:for="pill of providerRows.pills" :data-category="pill.id" :class="`provider-pill px-12 h-32 rounded-full text-12 font-normal cursor-pointer outline-none transition-all duration-150 whitespace-nowrap${pill.id === 'all' ? ' active' : ''}`"><span @text="pill.label"></span> <span class="opacity-60" @text="pill.count"></span></button>
                        </div>
                    </div>

                    <!--- Provider table --->
                    <table class="w-full border-collapse rounded-6 border border-edge overflow-hidden text-left">
                        <thead>
                            <tr class="bg-foreground border-b border-edge text-12 text-detail uppercase tracking-wider">
                                <th class="font-normal px-16 py-10" style="width:16%">Provider</th>
                                <th class="font-normal px-16 py-10" style="width:18%">Categories</th>
                                <th class="font-normal px-16 py-10">Description</th>
                                <th class="font-normal px-16 py-10 whitespace-nowrap">Install command</th>
                            </tr>
                        </thead>
                        <tbody data-provider-list>
                            <!--- Rows are generated from src/_data/providerRows.js: editorial copy
                                  from _data/providers.js joined to the generated catalog for the
                                  full category set. data-categories carries every category, so a
                                  filter matches categories the +N chip hides. --->
                            <tr webc:for="row of providerRows.rows" data-provider-row :data-url="row.url" :data-name="row.anchor" :data-categories="row.dataCategories" :data-search="row.searchText" class="border-b border-edge last:border-b-0 hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top"><a :href="row.url" target="_blank" rel="noopener" class="text-headline hover:text-primary transition-colors duration-150" @text="row.name"></a></td>
                                <td class="px-16 py-12 align-top">
                                    <span class="flex flex-wrap items-center gap-4">
                                        <span webc:for="chip of row.chips" class="inline-flex items-center h-24 px-8 rounded-full bg-foreground border border-edge text-11 text-detail whitespace-nowrap" @text="chip.label"></span>
                                        <!--- role="note" so the aria-label is actually exposed:
                                              a bare span is generic and screen readers drop the
                                              label, which would leave "+6" with no meaning. --->
                                        <span webc:if="row.overflowCount > 0" role="note" class="inline-flex items-center h-24 px-8 rounded-full bg-foreground border border-edge border-dotted text-11 text-detail whitespace-nowrap cursor-help" :title="row.overflowLabels" :aria-label="`Also in ${row.overflowLabels}`" @text="`+${row.overflowCount}`"></span>
                                    </span>
                                </td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top" @text="row.description"></td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button :data-copy-provider="row.installCommand" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span @text="row.installCommand"></span></button></td>
                            </tr>
                        </tbody>
                    </table>
                    <div data-provider-empty class="hidden flex-col items-center justify-center py-48 text-detail text-14">
                        <p>No providers match your search.</p>
                    </div>

            </helm-container>
        </helm-section>

    </main>

    <!--- Copy toast --->
    <div data-copy-toast class="fixed bottom-24 left-1/2 -translate-x-1/2 z-50 flex items-center gap-8 px-16 h-40 bg-headline text-highlight rounded-8 text-14 font-normal shadow-lg pointer-events-none" style="opacity:0;visibility:hidden;">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-14 h-14 text-[#4ade80] shrink-0"><path fill-rule="evenodd" d="M12.416 3.376a.75.75 0 0 1 .208 1.04l-5 7.5a.75.75 0 0 1-1.154.114l-3-3a.75.75 0 0 1 1.06-1.06l2.353 2.353 4.493-6.74a.75.75 0 0 1 1.04-.207Z" clip-rule="evenodd"/></svg>
        <span data-copy-toast-label>Command copied</span>
    </div>

    <!--- Footer --->
    <footer class="w-full flex items-center justify-center flex-col px-16">
        <helm-container class="relative flex flex-col sm:flex-row sm:items-center sm:justify-between gap-16 py-24 border-t border-edge">
            <p class="text-14/150 text-detail" @text="`© ` + base.currentYear() + ` Stripe`"></p>
            <div class="flex flex-col sm:flex-row sm:items-center gap-16 sm:gap-24">
                <a href="/developers/" class="text-14/150 font-normal text-primary hover:text-primary-hover transition-colors duration-250 outline-none">Developers</a>
                <a href="https://stripe.com/privacy" class="text-14/150 font-normal text-primary hover:text-primary-hover transition-colors duration-250 outline-none">Privacy &amp; Terms</a>
                <a href="https://stripe.com" class="text-14/150 font-normal text-primary hover:text-primary-hover transition-colors duration-250 outline-none">Go to Stripe</a>
            </div>
        </helm-container>
    </footer>

</div>

<style>
    @media (max-width: 39.99rem) {
        table, thead, tbody, tr, th, td {
            display: block;
        }
        thead {
            display: none;
        }
        tr[data-provider-row] {
            padding: 0.75rem 1rem;
        }
        tr[data-provider-row] td {
            padding: 0;
        }
        tr[data-provider-row] td:first-child {
            padding-bottom: 0.125rem;
        }
        tr[data-provider-row] td:nth-child(2) {
            padding-bottom: 0.375rem;
        }
        tr[data-provider-row] td:nth-child(3) {
            padding-bottom: 0.375rem;
        }
    }
    .provider-pill {
        background-color: var(--color-foreground);
        color: var(--color-detail);
        border: 1px solid var(--color-edge);
    }
    .provider-pill:hover {
        background-color: var(--color-highlight);
        color: var(--color-headline);
    }
    .provider-pill.active {
        background-color: var(--color-primary);
        color: var(--color-highlight);
        border-color: var(--color-primary);
    }
    .provider-pill:focus-visible {
        box-shadow: var(--shadow-focus);
    }
</style>

<script>
    // Toast
    function showCopyToast(message) {
        const toast = document.querySelector('[data-copy-toast]');
        const label = document.querySelector('[data-copy-toast-label]');
        if (!toast) return;
        if (label) label.textContent = message;
        gsap.killTweensOf(toast);
        gsap.fromTo(toast,
            { autoAlpha: 0, y: 8 },
            { autoAlpha: 1, y: 0, duration: 0.2, ease: 'power2.out' }
        );
        clearTimeout(toast._timer);
        toast._timer = setTimeout(() => {
            gsap.to(toast, { autoAlpha: 0, y: 8, duration: 0.25, ease: 'power2.in' });
        }, 2500);
    }

    // Copy provider command
    document.querySelectorAll('[data-copy-provider]').forEach(btn => {
        btn.addEventListener('click', () => {
            const command = btn.getAttribute('data-copy-provider');
            navigator.clipboard.writeText(command);
            showCopyToast('Command copied');
        });
    });

    // Search + filter
    (function providerFilter() {
        const searchInput = document.querySelector('[data-provider-search]');
        const pills = document.querySelectorAll('.provider-pill');
        const rows = document.querySelectorAll('[data-provider-row]');
        const emptyState = document.querySelector('[data-provider-empty]');
        let activeCategory = 'all';

        function filterRows() {
            const query = (searchInput?.value || '').toLowerCase().trim();
            let visibleCount = 0;

            rows.forEach(row => {
                // Providers sit in more than one category, so match the whole
                // set — including the ones the +N chip collapses.
                const categories = (row.getAttribute('data-categories') || '').split(' ');
                const matchesCategory = activeCategory === 'all' || categories.includes(activeCategory);
                // data-search holds the name plus category ids AND labels, so
                // "hosting" finds Vercel even though the id is "compute".
                const haystack = row.getAttribute('data-search') || '';
                const matchesSearch = !query || haystack.includes(query);
                const visible = matchesCategory && matchesSearch;
                row.style.display = visible ? '' : 'none';
                if (visible) visibleCount++;
            });

            if (emptyState) {
                emptyState.style.display = visibleCount === 0 ? 'flex' : 'none';
            }
        }

        if (searchInput) {
            searchInput.addEventListener('input', filterRows);
        }

        pills.forEach(pill => {
            pill.addEventListener('click', () => {
                pills.forEach(p => p.classList.remove('active'));
                pill.classList.add('active');
                activeCategory = pill.getAttribute('data-category') || 'all';
                filterRows();
            });
        });

        function highlightRow(name) {
            const match = document.querySelector(`[data-provider-row][data-name="${CSS.escape(name.toLowerCase())}"]`);
            if (match) {
                match.scrollIntoView({ behavior: 'smooth', block: 'center' });
                gsap.fromTo(match,
                    { backgroundColor: 'rgba(83, 58, 253, 0.12)' },
                    { backgroundColor: 'rgba(83, 58, 253, 0)', duration: 2, ease: 'power2.out', delay: 0.3 }
                );
            }
        }

        const hash = window.location.hash.slice(1);
        if (hash) {
            highlightRow(decodeURIComponent(hash));
        } else {
            const params = new URLSearchParams(window.location.search);
            const q = params.get('q');
            if (q && searchInput) {
                searchInput.value = q;
                filterRows();
                highlightRow(q);
            }
        }
    })();
</script>
