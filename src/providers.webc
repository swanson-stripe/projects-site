---
layout: "main.webc"
title: "Providers"
seoTitle: "Stripe Projects: Providers"
ogTitle: "Stripe Projects: Providers"
seoDesc: "Browse all supported providers in the Stripe Projects catalog. Provision hosting, databases, auth, AI, analytics, and more from the CLI."
ogDesc: "Browse all supported providers in the Stripe Projects catalog. Provision hosting, databases, auth, AI, analytics, and more from the CLI."
ogImage: "/assets/images/og/default.jpg"
ogImageAlt: ""
changefreq: "weekly"
wave: false
---

<div class="relative w-full">

    <!--- Header --->
    <header class="relative w-full flex items-center justify-center px-16 z-50">
        <helm-container class="relative pt-24 pb-12 grid grid-cols-3 items-center">
            <div></div>
            <a href="/" class="relative flex items-center justify-center h-40 gap-4">
                <div class="relative flex items-center gap-8 h-full px-10 whitespace-nowrap">
                    <icon-logo class="h-[1em] w-auto text-headline shrink-0"></icon-logo>
                    <span class="text-16 font-normal text-headline">Stripe Projects</span>
                </div>
            </a>
            <div></div>
        </helm-container>
    </header>

    <main id="main">

        <!--- Page header --->
        <helm-section class="relative z-10">
            <helm-container class="pt-24 sm:pt-48 pb-32">
                <h1 class="text-36/110 sm:text-48/110 tracking-tighter text-headline mb-8">Providers</h1>
                <p class="text-16 sm:text-18/150 text-content">Browse and provision services from supported providers. Click any install command to copy it.</p>
            </helm-container>
        </helm-section>

        <!--- Info cards --->
        <helm-section class="relative z-10">
            <helm-container class="flex flex-col sm:flex-row gap-16 pb-32">
                <!--- Install command --->
                <div class="flex-1 rounded-6 border border-edge p-24">
                    <h2 class="text-16 font-normal text-headline mb-8">Install command</h2>
                    <div class="rounded-4 bg-foreground p-12 font-mono text-12 text-detail shadow-inset-border overflow-x-auto">
                        <span class="text-detail select-none">$ </span>stripe projects add &lt;provider&gt;/&lt;service&gt;
                    </div>
                </div>
                <!--- Links --->
                <div class="flex-1 flex flex-col gap-8">
                        <a href="/llm.txt" target="_blank" class="flex items-center justify-between gap-8 px-12 py-8 rounded-4 border border-edge hover:bg-highlight transition-colors duration-150 group">
                            <div>
                                <div class="text-14 font-normal text-headline">llms.txt</div>
                                <div class="text-12 text-detail">Service discovery for agents</div>
                            </div>
                            <icon-arrowanimate @size="sm" class="text-detail group-hover:text-headline transition-colors duration-150"></icon-arrowanimate>
                        </a>
                        <a href="https://docs.stripe.com/projects" target="_blank" rel="noopener" class="flex items-center justify-between gap-8 px-12 py-8 rounded-4 border border-edge hover:bg-highlight transition-colors duration-150 group">
                            <div>
                                <div class="text-14 font-normal text-headline">Projects docs</div>
                                <div class="text-12 text-detail">Full documentation</div>
                            </div>
                            <icon-arrowanimate @size="sm" class="text-detail group-hover:text-headline transition-colors duration-150"></icon-arrowanimate>
                        </a>
                        <a href="https://docs.stripe.com/stripe-cli" target="_blank" rel="noopener" class="flex items-center justify-between gap-8 px-12 py-8 rounded-4 border border-edge hover:bg-highlight transition-colors duration-150 group">
                            <div>
                                <div class="text-14 font-normal text-headline">Stripe CLI</div>
                                <div class="text-12 text-detail">Install and setup guide</div>
                            </div>
                            <icon-arrowanimate @size="sm" class="text-detail group-hover:text-headline transition-colors duration-150"></icon-arrowanimate>
                        </a>
                </div>
                <!--- Suggest provider --->
                <div class="flex-1 rounded-6 border border-edge p-24">
                    <h2 class="text-16 font-normal text-headline mb-8">Missing a provider?</h2>
                    <p class="text-14 text-content leading-140 mb-16">Let us know what services we should add next.</p>
                    <a href="mailto:provider-request@stripe.com?subject=Provider%20Request" class="relative flex items-center gap-6 text-14 font-normal text-primary hover:text-primary-hover transition-colors duration-250 cursor-pointer group outline-none">
                        <span class="pb-1">Suggest a provider</span>
                        <icon-arrowanimate @size="sm" class=""></icon-arrowanimate>
                    </a>
                </div>
            </helm-container>
        </helm-section>

        <!--- Provider table --->
        <helm-section class="relative z-10 pb-64">
            <helm-container>

                <!--- Search + filter --->
                <div class="relative flex flex-col sm:flex-row gap-12 mb-24">
                        <div class="relative flex-1">
                            <input data-provider-search type="text" placeholder="Search providers..." class="w-full h-40 px-12 bg-highlight rounded-6 shadow-inset-border text-14 text-headline placeholder:text-detail outline-none focus:shadow-focus transition-shadow duration-200">
                        </div>
                        <div data-category-pills class="relative flex items-center gap-6 flex-wrap">
                            <button data-category="all" class="provider-pill active px-12 h-32 rounded-full text-12 font-normal cursor-pointer outline-none transition-all duration-150 whitespace-nowrap">All</button>
                            <button data-category="hosting" class="provider-pill px-12 h-32 rounded-full text-12 font-normal cursor-pointer outline-none transition-all duration-150 whitespace-nowrap">Hosting</button>
                            <button data-category="database" class="provider-pill px-12 h-32 rounded-full text-12 font-normal cursor-pointer outline-none transition-all duration-150 whitespace-nowrap">Database</button>
                            <button data-category="sandbox" class="provider-pill px-12 h-32 rounded-full text-12 font-normal cursor-pointer outline-none transition-all duration-150 whitespace-nowrap">Sandbox</button>
                            <button data-category="auth" class="provider-pill px-12 h-32 rounded-full text-12 font-normal cursor-pointer outline-none transition-all duration-150 whitespace-nowrap">Auth</button>
                            <button data-category="analytics" class="provider-pill px-12 h-32 rounded-full text-12 font-normal cursor-pointer outline-none transition-all duration-150 whitespace-nowrap">Analytics</button>
                            <button data-category="ai" class="provider-pill px-12 h-32 rounded-full text-12 font-normal cursor-pointer outline-none transition-all duration-150 whitespace-nowrap">AI</button>
                            <button data-category="search" class="provider-pill px-12 h-32 rounded-full text-12 font-normal cursor-pointer outline-none transition-all duration-150 whitespace-nowrap">Search</button>
                            <button data-category="communications" class="provider-pill px-12 h-32 rounded-full text-12 font-normal cursor-pointer outline-none transition-all duration-150 whitespace-nowrap">Communications</button>
                            <button data-category="browser" class="provider-pill px-12 h-32 rounded-full text-12 font-normal cursor-pointer outline-none transition-all duration-150 whitespace-nowrap">Browser</button>
                            <button data-category="ci-cd" class="provider-pill px-12 h-32 rounded-full text-12 font-normal cursor-pointer outline-none transition-all duration-150 whitespace-nowrap">CI/CD</button>
                            <button data-category="observability" class="provider-pill px-12 h-32 rounded-full text-12 font-normal cursor-pointer outline-none transition-all duration-150 whitespace-nowrap">Observability</button>
                            <button data-category="payments" class="provider-pill px-12 h-32 rounded-full text-12 font-normal cursor-pointer outline-none transition-all duration-150 whitespace-nowrap">Payments</button>
                            <button data-category="cache" class="provider-pill px-12 h-32 rounded-full text-12 font-normal cursor-pointer outline-none transition-all duration-150 whitespace-nowrap">Cache</button>
                            <button data-category="domains" class="provider-pill px-12 h-32 rounded-full text-12 font-normal cursor-pointer outline-none transition-all duration-150 whitespace-nowrap">Domains</button>
                        </div>
                    </div>

                    <!--- Provider table --->
                    <table class="w-full border-collapse rounded-6 border border-edge overflow-hidden text-left">
                        <thead>
                            <tr class="bg-foreground border-b border-edge text-12 text-detail uppercase tracking-wider">
                                <th class="font-normal px-16 py-10" style="width:18%">Provider</th>
                                <th class="font-normal px-16 py-10" style="width:12%">Category</th>
                                <th class="font-normal px-16 py-10">Description</th>
                                <th class="font-normal px-16 py-10 whitespace-nowrap">Install command</th>
                            </tr>
                        </thead>
                        <tbody data-provider-list>
                            <tr data-provider-row data-name="agentmail" data-category="communications" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">AgentMail</td>
                                <td class="px-16 py-12 text-14 text-content capitalize align-top">Communications</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">The email inbox API for AI agents. Agents can communicate with any internet user and authenticate with any internet service.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add agentmail/api" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add agentmail/api</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="agentphone" data-category="communications" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">AgentPhone</td>
                                <td class="px-16 py-12 text-14 text-content capitalize align-top">Communications</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">Programmable phone numbers for AI agents. Make and receive calls, handle voicemail, and route conversations autonomously.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add agentphone/number" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add agentphone/number</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="algolia" data-category="search" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">Algolia</td>
                                <td class="px-16 py-12 text-14 text-content capitalize align-top">Search</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">AI Search and Retrieval platform with a unified keyword and vector engine, enabling companies to build agentic, generative, and search experiences.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add algolia/application" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add algolia/application</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="amplitude" data-category="analytics" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">Amplitude</td>
                                <td class="px-16 py-12 text-14 text-content capitalize align-top">Analytics</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">Digital analytics platform for understanding user behavior, building funnels, measuring retention, and running A/B experiments to drive product growth.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add amplitude/analytics" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add amplitude/analytics</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="auth0" data-category="auth" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">Auth0/Okta</td>
                                <td class="px-16 py-12 text-14 text-content capitalize align-top">Auth</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">Secure users, AI agents, and more with an easy-to-implement, scalable, and adaptable authentication and authorization platform.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add auth0/client" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add auth0/client</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="base 44" data-category="hosting" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">Base 44</td>
                                <td class="px-16 py-12 text-14 text-content capitalize align-top">Hosting</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">Full-stack app platform with hosting, database, and AI built in. Ship complete applications from a single environment.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add base44_projects/app" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add base44_projects/app</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="blaxel" data-category="hosting" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">Blaxel</td>
                                <td class="px-16 py-12 text-14 text-content capitalize align-top">Hosting</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">Serverless platform for deploying and running AI agents with built-in sandboxed execution environments.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add blaxel/sandbox" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add blaxel/sandbox</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="browserbase" data-category="ai" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">Browserbase</td>
                                <td class="px-16 py-12 text-14 text-content align-top">AI</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">Platform for building and deploying browser agents that interact with the web like humans. Spin up thousands of headless browsers in milliseconds, globally.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add browserbase/project" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add browserbase/project</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="chroma" data-category="database" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">Chroma</td>
                                <td class="px-16 py-12 text-14 text-content capitalize align-top">Database</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">AI-native vector database. Fast, serverless search supporting vector, full-text, regex, and metadata queries.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add chroma/database" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add chroma/database</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="clerk" data-category="auth" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">Clerk</td>
                                <td class="px-16 py-12 text-14 text-content capitalize align-top">Auth</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">Drop-in authentication with social login, magic links, MFA, and full user management UI.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add clerk/auth" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add clerk/auth</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="clickhouse" data-category="database" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">ClickHouse</td>
                                <td class="px-16 py-12 text-14 text-content capitalize align-top">Database</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">Open-source columnar database for real-time analytics. Process billions of rows in milliseconds with SQL.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add clickhouse/clickhouse" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add clickhouse/clickhouse</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="cloudflare" data-category="hosting" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">Cloudflare</td>
                                <td class="px-16 py-12 text-14 text-content capitalize align-top">Hosting</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">Edge platform for running, securing, and accelerating apps without managing infrastructure. Global network with routing, protection, and performance built in.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add cloudflare/worker" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add cloudflare/worker</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="daytona" data-category="sandbox" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">Daytona</td>
                                <td class="px-16 py-12 text-14 text-content capitalize align-top">Sandbox</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">Secure, elastic sandbox infrastructure for AI agents. Complete, isolated, and fully programmable environments spun up on demand for agentic workflows and pipelines at scale.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add daytona/sandbox" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add daytona/sandbox</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="e2b" data-category="hosting" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">E2B</td>
                                <td class="px-16 py-12 text-14 text-content capitalize align-top">Hosting</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">Cloud sandboxes for AI agents and apps. Spin up secure, isolated environments for code execution in milliseconds.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add e2b/sandboxes" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add e2b/sandboxes</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="elevenlabs" data-category="ai" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">ElevenLabs</td>
                                <td class="px-16 py-12 text-14 text-content align-top">AI</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">AI tools for generating human-like speech, voice cloning, and audio content to make communication and creation seamless.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add elevenlabs/tts" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add elevenlabs/tts</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="exa" data-category="search" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">Exa</td>
                                <td class="px-16 py-12 text-14 text-content capitalize align-top">Search</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">AI-native search engine that understands meaning, not just keywords. Build search and retrieval into AI applications.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add exa/api" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add exa/api</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="firecrawl" data-category="search" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">Firecrawl</td>
                                <td class="px-16 py-12 text-14 text-content capitalize align-top">Search</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">Web scraping and crawling API that turns any website into clean, structured data for AI apps. Supports JS rendering, markdown output, and LLM-ready formatting.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add firecrawl/api" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add firecrawl/api</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="fly.io" data-category="hosting" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">Fly.io</td>
                                <td class="px-16 py-12 text-14 text-content capitalize align-top">Hosting</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">Deploy full-stack apps and databases globally on fast hardware with low-latency networking and built-in Postgres and Redis.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add flyio/app" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add flyio/app</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="gitlab" data-category="ci-cd" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">GitLab</td>
                                <td class="px-16 py-12 text-14 text-content align-top">CI/CD</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">Intelligent DevSecOps orchestration platform that increases developer productivity, improves operational efficiency, and reduces security and compliance risk.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add gitlab/project" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add gitlab/project</span></button></td>
                            </tr>
                            <tr data-provider-row data-name="heygen" data-category="ai" class="border-b border-edge hover:bg-foreground transition-colors duration-100">
                                <td class="px-16 py-12 text-headline font-normal text-16 leading-130 align-top">HeyGen</td>
                                <td class="px-16 py-12 text-14 text-content align-top">AI</td>
                                <td class="px-16 py-12 text-14 text-content leading-140 align-top">AI video generation platform for creating personalized talking-head videos, avatars, and translations at scale.</td>
                                <td class="px-16 py-12 align-top whitespace-nowrap"><button data-copy-provider="stripe projects add heygen/api" class="flex items-center gap-6 font-mono text-12 text-detail hover:text-headline cursor-pointer outline-none transition-colors duration-150"><span>stripe projects add heygen/api</span></button></td>
