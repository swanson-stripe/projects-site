                        <button data-copy-cli="stripe projects catalog" data-container-hover-follow class="relative w-full h-64 p-1 rounded-4 overflow-hidden group cursor-pointer text-left outline-none focus-visible:shadow-focus transition-all duration-400 ease-in-out" style="background:rgba(255,255,255,0.05)">
                            <div class="relative w-full h-full rounded-3 border border-transparent group-hover:border-neutral-0/20 transition-all duration-400" style="background:rgba(255,255,255,0.03)">
