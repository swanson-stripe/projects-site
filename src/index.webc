                                    </div>
                                </div>
                            </div>
                        </button>
                    </div>
                </div>
            </helm-container>
        </helm-section>

        <!--- Content --->
        <helm-section class="relative pt-32 pb-32 md:pt-64 md:pb-64 z-10">
            <helm-container class="relative flex flex-col relative text-pretty">
                <h2 class="relative text-headline text-28/110 sm:text-36/110 tracking-[-0.0375em] max-w-416 mb-32 sm:mb-48">
                    Fast, secure, and portable infrastructure provisioning
                </h2>
                <ul class="relative w-full grid sm:grid-cols-2 gap-x-16 gap-y-32 sm:gap-y-48 leading-150 text-headline text-16 sm:text-18/150">
                    <li class="relative flex flex-col items-start gap-12 pr-48 group/feature">
                        <div class="text-12 font-normal text-neutral-0 flex items-center justify-center w-40 h-40 bg-linear-to-b from-brand-500 to-brand-700 rounded-12 shrink-0 tabular-nums relative overflow-hidden">
                            <div class="absolute inset-0 animate-icon-gradient opacity-0 group-hover/feature:opacity-100 transition-opacity duration-500"></div>
                            <icon-apps class="relative z-10 w-16 h-16"></icon-apps>
                        </div>
                        <div>
                            <h3 class="text-headline leading-130 font-normal mb-4">
                                Programmatic provisioning
                            </h3>
                            <p class="text-content">
                                Provision and manage multiple services from the command line. No more juggling multiple dashboards or stitching together tools manually.
                            </p>
                        </div>
                    </li>
                    <li class="relative flex flex-col items-start gap-12 pr-48 group/feature">
                        <div class="text-12 font-normal text-neutral-0 flex items-center justify-center w-40 h-40 bg-linear-to-b from-brand-500 to-brand-700 rounded-12 shrink-0 tabular-nums relative overflow-hidden">
                            <div class="absolute inset-0 animate-icon-gradient opacity-0 group-hover/feature:opacity-100 transition-opacity duration-500"></div>
                            <svg mlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 17" width="16" height="17" class="relative z-10 w-18 h-18">
                                <path d="M13.25 7.52a2.248 2.248 0 0 1 .75 4.368v1.632h1.5v1.5H14v1h-1.5v-4.132a2.248 2.248 0 0 1 .75-4.368m-3.187 2.98H5.5A3.5 3.5 0 0 0 2 14v.5h9.063V16H.5v-2a5 5 0 0 1 4.743-4.993L5.5 9h4.563zm3.187-1.48a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5M8 0a4 4 0 1 1 0 8 4 4 0 0 1 0-8m0 1.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5"/>
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-headline leading-130 font-normal mb-4">
                                Securely create and store keys
                            </h3>
                            <p class="text-content">
                                Generate, store, and return credentials that both developers and agents can use safely and securely. 
                            </p>
                        </div>
                    </li>
                    <li class="relative flex flex-col items-start gap-12 pr-48 group/feature">
                        <div class="text-12 font-normal text-neutral-0 flex items-center justify-center w-40 h-40 bg-linear-to-b from-brand-500 to-brand-700 rounded-12 shrink-0 tabular-nums relative overflow-hidden">
                            <div class="absolute inset-0 animate-icon-gradient opacity-0 group-hover/feature:opacity-100 transition-opacity duration-500"></div>
                            <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" class="relative z-10 w-16 h-16">
                                <path d="M7.25 1a.75.75 0 0 1 1.5 0v7.19l2.22-2.22a.75.75 0 1 1 1.06 1.06l-3.5 3.5a.75.75 0 0 1-1.06 0l-3.5-3.5a.75.75 0 0 1 1.06-1.06l2.22 2.22V1z"/>
                                <path d="M2.75 11a.75.75 0 0 1 .75.75v1.5c0 .14.11.25.25.25h8.5c.14 0 .25-.11.25-.25v-1.5a.75.75 0 0 1 1.5 0v1.5A1.75 1.75 0 0 1 12.25 15h-8.5A1.75 1.75 0 0 1 2 12.75v-1.5a.75.75 0 0 1 .75-.75z"/>
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-headline leading-130 font-normal mb-4">
                                Keep your stack portable
                            </h3>
                            <p class="text-content">
                                Work directly in provider accounts you own, with configuration that stays auditable and easy to move.
                            </p>
                        </div>
                    </li>
                    <li class="relative flex flex-col items-start gap-12 pr-48 group/feature">
                        <div class="text-12 font-normal text-neutral-0 flex items-center justify-center w-40 h-40 bg-linear-to-b from-brand-500 to-brand-700 rounded-12 shrink-0 tabular-nums relative overflow-hidden">
                            <div class="absolute inset-0 animate-icon-gradient opacity-0 group-hover/feature:opacity-100 transition-opacity duration-500"></div>
                            <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="16" height="16" class="relative z-10 w-16 h-16">
                                <path d="m6.792 8.354-.506.552-1.783 1.945H11.4a2.25 2.25 0 0 0 2.25-2.25v-.818h1.5v.818a3.75 3.75 0 0 1-3.75 3.75H4.505l1.78 1.942.507.553-1.106 1.013-.506-.553-2.932-3.2-.465-.506.465-.507 2.931-3.2.507-.553zm4.029-7.66 2.931 3.2.465.506-.465.507-2.932 3.2-.506.552-1.106-1.013.506-.553 1.783-1.944H4.6A2.25 2.25 0 0 0 2.35 7.4v.817H.85v-.817A3.75 3.75 0 0 1 4.6 3.65h6.895l-1.78-1.942-.507-.554L10.314.141z"/>
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-headline leading-130 font-normal mb-4">
                                Manage payments, in one place
                            </h3>
                            <p class="text-content">
                                Set up your billing details once and reuse them across providers. You can manage tiers, usage, and subscriptions from your CLI.
                            </p>
                        </div>
                    </li>
                </ul>
            </helm-container>
        </helm-section>

        <!--- CTAs --->
        <helm-section class="relative mt-32 lg:mt-0 lg:pt-64 bg-foreground border-t border-edge lg:border-none lg:bg-transparent">
            <helm-container class="relative py-72 lg:py-96 grid-cols-1 sm:grid-cols-2 grid md:grid-cols-4 leading-140 bg-foreground lg:rounded-6 lg:border lg:border-edge lg:px-48">
                <!--- Headline --->
                <div class="relative sm:col-span-2 mb-48">
                    <h2 class="text-32/110 tracking-[-0.02em] mb-16">
                        Get started
                    </h2>
                    <p class="text-16 sm:text-18 text-detail text-balance mb-32">
                        Install Stripe Projects to try it locally. For more information, check out the docs to see how provisioning works.
                    </p>
                    <!--- CTAs --->
                    <div class="relative grid grid-cols-1 gap-8 w-auto min-[448px]:grid-cols-2 sm:flex flex-col sm:flex-row justify-start gap-8">
                        <!--- CTA --->
                        <button data-copy-cli="brew install stripe/stripe-cli/stripe && stripe plugin install projects" class="relative flex items-center justify-center px-24 h-48 bg-primary text-neutral-0 font-normal rounded-4 group overflow-hidden hover:bg-primary-hover focus-visible:bg-primary-hover focus-visible:shadow-focus transition-all duration-250 cursor-pointer outline-none">
                            <div data-copy-cli-default class="relative flex items-center gap-8">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 12 12" class="w-16 h-16 mb-1">
                                    <path fill-rule="evenodd" d="M9.75 1.88h-7.5A1.13 1.13 0 0 0 1.13 3v6a1.13 1.13 0 0 0 1.12 1.13h7.5A1.1 1.1 0 0 0 10.88 9V3a1.1 1.1 0 0 0-1.13-1.12M2.25.75A2.25 2.25 0 0 0 0 3v6a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 12 9V3A2.25 2.25 0 0 0 9.75.75z" clip-rule="evenodd"/>
                                    <path fill-rule="evenodd" d="M2.57 3.38a.56.56 0 0 1 .8-.06l2.62 2.25a.56.56 0 0 1 0 .86L3.37 8.68a.56.56 0 1 1-.74-.86L4.76 6 2.63 4.18a.56.56 0 0 1-.06-.8M6 8.06a.56.56 0 0 1 .56-.56H9.2a.56.56 0 1 1 0 1.12H6.56A.56.56 0 0 1 6 8.06" clip-rule="evenodd"/>
                                </svg>
                                <span class="pb-2">
                                    Install CLI
                                </span>
                            </div>
                            <div data-copy-cli-clicked class="absolute translate-y-24 scale-75 opacity-0 invisible">
                                <div class="-translate-y-1">
                                    Command copied
                                </div>
                            </div>
                        </button>
                        <!--- CTA --->
                        <link-btn size="48" color="outline" href="https://docs.stripe.com/stripe-projects">
                            <span slot="label">View docs</span>
                            <icon-arrowanimate slot="icon-right" @size="md" class=""></icon-arrowanimate>
                        </link-btn>
                    </div>
                </div>
                <!--- Item --->
                <div class="relative flex flex-col items-start justify-center sm:pr-16 md:pr-32 md:-mt-10 sm:h-full mb-32 sm:mb-0 group/feature">
                    <div class="relative w-40 flex items-center justify-center aspect-square text-primary bg-linear-to-b from-brand-75 to-brand-100 rounded-12 mb-16 overflow-hidden">
                        <div class="absolute inset-0 animate-icon-gradient opacity-0 group-hover/feature:opacity-100 transition-opacity duration-500"></div>
                        <icon-add @size="16" weight="strong" class="relative z-10"></icon-add>
                    </div>
                    <h3 class="font-normal mb-4">
                        We're adding more providers
                    </h3>
                    <p class="text-content text-balance mb-16">
                        Recommend a provider for Stripe Projects.
                    </p>
                    <a href="mailto:provider-request@stripe.com?subject=Provider%20Request" target="_blank" class="relative flex items-center justify-center gap-6 text-16 font-normal text-primary rounded-4 hover:text-primary-hover focus-visible:text-primary-hover focus-visible:shadow-focus transition-all duration-250 cursor-pointer group outline-none">
                        <span class="pb-2">
                            Suggest a provider
                        </span>
                        <icon-arrowanimate @size="md" class=""></icon-arrowanimate>
                    </a>
                </div>
                <!--- Item --->
                <div class="relative flex flex-col items-start justify-center sm:pr-16 md:pr-32 md:-mt-10 sm:h-full group/feature">
                    <div class="relative w-40 flex items-center justify-center aspect-square text-primary bg-linear-to-b from-brand-75 to-brand-100 rounded-12 mb-16 overflow-hidden">
                        <div class="absolute inset-0 animate-icon-gradient opacity-0 group-hover/feature:opacity-100 transition-opacity duration-500"></div>
                        <icon-rocket @size="16" weight="strong" class="relative z-10 translate-y-0.5"></icon-rocket>
                    </div>
                    <h3 class="font-normal mb-4">
                        Want to become a provider?
                    </h3>
                    <p class="text-content text-balance mb-16">
                        Join the growing list of providers for Stripe Projects.
                    </p>
                    <a href="mailto:provider-request@stripe.com?subject=Provider%20Partnership" target="_blank" class="relative flex items-center justify-center gap-6 text-16 font-normal text-primary rounded-4 hover:text-primary-hover focus-visible:text-primary-hover focus-visible:shadow-focus transition-all duration-250 cursor-pointer group outline-none">
                        <span class="pb-2">
                            Become a provider
                        </span>
                        <icon-arrowanimate @size="md" class=""></icon-arrowanimate>
                    </a>
                </div>
            </helm-container>
        </helm-section>

    </main>

    <!--- Footer --->
    <footer class="w-full flex items-center justify-center flex-col px-16 lg:pt-96">
        <helm-container class="relative flex items-center justify-between py-24 border-t border-edge">
            <div class="flex items-center">
                <icon-wordmark class="relative h-14 w-[116px]"></icon-wordmark>
            </div>
            <div class="flex items-center gap-16">
                <a href="https://stripe.com" class="text-14/150 text-primary hover:text-primary-hover transition-colors duration-250 outline-none">Go to Stripe</a>
                <a href="https://stripe.com/privacy" class="text-14/150 text-primary hover:text-primary-hover transition-colors duration-250 outline-none">Privacy &amp; Terms</a>
                <p class="text-14/150 text-detail" @text="`©` + base.currentYear() + ` Stripe`"></p>
            </div>
        </helm-container>
    </footer>

</div>

<script>

    // Copy install
    function copyInstall() {
        const install = document.querySelector('[data-install-text]').textContent;
        navigator.clipboard.writeText(install);
        console.log(install);
        const tl = gsap.timeline({
            onStart: () => {
                document.querySelector('[data-copy-install]').classList.add('pointer-events-none');
            },
            onComplete: () => {
                document.querySelector('[data-copy-install]').classList.remove('pointer-events-none');
            }
        });
        tl
        .to('[data-copy-install-copy]', { y: -32, autoAlpha: 0, scale:0.75, duration: 0.25, ease: 'power3.out' })
        .to('[data-copy-install-copied]', { y: 0, autoAlpha: 1, scale:1, duration: 0.25, ease: 'power3.out' }, 0)
        .to('[data-copy-install-copy]', { y: 0, autoAlpha: 1, scale:1, duration: 0.25, ease: 'power3.out' }, 3)
        .to('[data-copy-install-copied]', { y: 32, autoAlpha: 0, scale:0.75, duration: 0.25, ease: 'power3.out' }, 3)
    }
    
    // Copy install hero events
    document.querySelector('[data-copy-install]').addEventListener('click', () => { copyInstall(); });
    document.querySelector('[data-checkbox="show-install"]').addEventListener('change', (e) => { if (e.target.checked) copyInstall(); });

    // Copy CLI
    function copyCLI(el) {
        const defaultContent = el.querySelector('[data-copy-cli-default]');
        const clickedContent = el.querySelector('[data-copy-cli-clicked]');
        const command = el.dataset.copyCli;
        navigator.clipboard.writeText(command);
        console.log(command);
        const tl = gsap.timeline({});
        tl
        .to(defaultContent, { y: -24, autoAlpha: 0, scale:0.75, duration: 0.25, ease: 'power3.inOut' })
        .to(clickedContent, { y: 0, autoAlpha: 1, scale:1, duration: 0.25, ease: 'power3.inOut' }, 0)
        .to(defaultContent, { y: 0, autoAlpha: 1, scale:1, duration: 0.25, ease: 'power3.inOut' }, 2)
        .to(clickedContent, { y: 24, autoAlpha: 0, scale:0.75, duration: 0.25, ease: 'power3.inOut' }, 2)
    }

    // Copy CLI events
    document.querySelectorAll('[data-copy-cli]').forEach((el) => {
        el.addEventListener('click', () => { copyCLI(el); });
    });

    // Hero typing
    function heroTyping() {
        const el = document.querySelector('[data-hero-type]');
        const providers = [
            { slug: 'vercel/hosting',       name: 'Vercel' },
            { slug: 'railway/hosting',      name: 'Railway' },
            { slug: 'planetscale/database', name: 'PlanetScale' },
            { slug: 'neon/database',        name: 'Neon' },
            { slug: 'turso/database',       name: 'Turso' },
            { slug: 'chroma/vector-db',     name: 'Chroma' },
            { slug: 'runloop/ai',           name: 'Runloop' },
            { slug: 'clerk/auth',           name: 'Clerk' },
            { slug: 'supabase/storage',     name: 'Supabase' },
            { slug: 'posthog/analytics',    name: 'PostHog' },
            { slug: 'sentry/monitoring',    name: 'Sentry' },
        ];
        let idx = 1; // vercel/hosting already shown as initial text

        function next() {
            const tl = gsap.timeline({ onComplete: next });
            const current = el.textContent;
            const { slug, name } = providers[idx];
            idx = (idx + 1) % providers.length;

            tl.to({ len: current.length }, {
                len: 0,
                duration: Math.max(0.3, current.length * 0.04),
                ease: 'none',
                snap: { len: 1 },
                onUpdate() { el.textContent = current.substring(0, this.targets()[0].len); }
            }, '+=3')
            .to('[data-hero-type]', { text: slug, duration: slug.length * 0.07, ease: 'none' })
            .call(() => {
            });
        }

        next();
    }
    heroTyping();

    // Terminal tier keyboard navigation
    (function() {
        const terminal = document.querySelector('[data-hero="terminal"]');
        if (!terminal) return;
        const tiers = ['Starter', 'Hobby', 'Pro'];
        let selectedIdx = 0;
        let focused = false;

        function updateTiers() {
            terminal.querySelectorAll('[data-tier-name]').forEach((el, i) => {
                if (i === selectedIdx) {
                    el.className = 'text-primary';
                    el.textContent = tiers[i] + ' ‹';
                } else {
                    el.className = 'text-detail';
                    el.textContent = tiers[i];
                }
            });
        }

        terminal.addEventListener('click', () => { focused = true; });
        document.addEventListener('click', (e) => {
            if (!terminal.contains(e.target)) focused = false;
        });
        document.addEventListener('keydown', (e) => {
            if (!focused) return;
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                selectedIdx = (selectedIdx + 1) % tiers.length;
                updateTiers();
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                selectedIdx = (selectedIdx - 1 + tiers.length) % tiers.length;
                updateTiers();
            }
        });
    })();

    // Logo carousel
    function responsiveLogos() {
        const mediaQuery = window.matchMedia('(min-width: 640px)');

        function logoAnimate() {
            const tl = gsap.timeline({ repeat: -1, repeatDelay: 2 });
            tl
            .to('[data-logo-wall="1"]', { y: -48, autoAlpha: 0, duration: 0.5, stagger: 0.05, ease: 'power3.in' }, 0)
            .to('[data-logo-wall="2"]', { y: 0, autoAlpha: 1, duration: 0.75, stagger: 0.05, ease: 'power3.out' }, 0.375)
            .set('[data-logo-wall="1"]', { y: 48, autoAlpha: 0}, 1.25)
            .to('[data-logo-wall="2"]', { y: -48, autoAlpha: 0, duration: 0.5, stagger: 0.05, ease: 'power3.in' }, 3)
            .to('[data-logo-wall="1"]', { y: 0, autoAlpha: 1, duration: 0.75, stagger: 0.05, ease: 'power3.out' }, 3.375);
            return tl;
        }

        let logoTl;
        if (mediaQuery.matches) {
            logoTl = logoAnimate();
        }

        mediaQuery.addEventListener('change', (e) => {
            if (e.matches) {
                logoTl = logoAnimate();
            } else if (logoTl) {
                logoTl.kill();
                gsap.set('[data-logo-wall="1"]', { clearProps: 'all' });
                gsap.set('[data-logo-wall="2"]', { clearProps: 'all' });
                logoTl = null;
            }
        });
    }
    responsiveLogos();

    // Input gradient follow cursor (supports multiple [data-container-hover-follow] elements)
    function followCursorOnHover() {
        const containers = document.querySelectorAll('[data-container-hover-follow]');
        if (!containers.length) return;

        const ease = 0.12;

        containers.forEach((container) => {
            const follower = container.querySelector('[data-hover-follow]');
            if (!follower) return;

            let currentX = 0;
            let currentY = 0;
            let targetX = 0;
            let targetY = 0;
            let isHovering = false;
            let animationId = null;

            function getFollowerSize() {
                const r = follower.getBoundingClientRect();
                return { width: r.width, height: r.height };
            }

            function updatePosition() {
                const { width: followerWidth, height: followerHeight } = getFollowerSize();
                if (!isHovering && Math.abs(targetX - currentX) < 0.5 && Math.abs(targetY - currentY) < 0.5) {
                    cancelAnimationFrame(animationId);
                    animationId = null;
                    return;
                }
                currentX += (targetX - currentX) * ease;
                currentY += (targetY - currentY) * ease;
                follower.style.transform = `translate(${currentX - followerWidth / 2}px, ${currentY - followerHeight / 2}px)`;
                animationId = requestAnimationFrame(updatePosition);
            }

            container.addEventListener('mouseenter', (e) => {
                isHovering = true;
                const rect = container.getBoundingClientRect();
                targetX = e.clientX - rect.left;
                targetY = e.clientY - rect.top;
                currentX = targetX;
                currentY = targetY;
                const { width: followerWidth, height: followerHeight } = getFollowerSize();
                follower.style.transform = `translate(${currentX - followerWidth / 2}px, ${currentY - followerHeight / 2}px)`;
                follower.style.transition = 'opacity 0.3s ease-out';
                follower.style.opacity = '1';
                if (!animationId) {
                    animationId = requestAnimationFrame(updatePosition);
                }
            });

            container.addEventListener('mousemove', (e) => {
                const rect = container.getBoundingClientRect();
                targetX = e.clientX - rect.left;
                targetY = e.clientY - rect.top;
                if (!animationId) {
                    animationId = requestAnimationFrame(updatePosition);
                }
            });

            container.addEventListener('mouseleave', () => {
                isHovering = false;
                follower.style.transition = 'opacity 0.4s ease-out';
                follower.style.opacity = '0';
            });
        });
    }
    followCursorOnHover();

</script>