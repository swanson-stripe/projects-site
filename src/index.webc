                                                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" class="relative w-14 h-14 shrink-0"><path d="M13 0a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-1.5v1a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V5.25c0-.97.78-1.75 1.75-1.75a.75.75 0 0 1 0 1.5.25.25 0 0 0-.25.25V14c0 .28.22.5.5.5h6.5a.5.5 0 0 0 .5-.5v-1H6.5a2 2 0 0 1-2-2V2c0-1.1.9-2 2-2zM6.5 1.5A.5.5 0 0 0 6 2v9c0 .28.22.5.5.5H13a.5.5 0 0 0 .5-.5V2a.5.5 0 0 0-.5-.5z"/></svg>
                                            </div>
                                            <div data-copy-cli-clicked class="absolute flex items-center justify-center translate-y-24 scale-75 opacity-0 invisible">
                                                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" class="relative w-14 h-14 shrink-0"><path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.75.75 0 0 1 1.06-1.06L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0z"/></svg>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </button>
                        <!--- CLI command --->
                        <button data-copy-cli="stripe projects add <provider>/<service>" data-container-hover-follow class="relative w-full h-64 p-1 rounded-4 overflow-hidden group cursor-pointer text-left outline-none focus-visible:shadow-focus transition-all duration-400 ease-in-out" style="background:rgba(255,255,255,0.05)">
                            <div class="relative w-full h-full rounded-3 border border-transparent group-hover:border-neutral-0/20 transition-all duration-400" style="background:rgba(255,255,255,0.03)">
                                <div class="relative w-full h-full flex items-center justify-between rounded-3 transition-all duration-400 ease-in-out group-hover:bg-white/5">
                                    <div class="flex-1 min-w-0 flex flex-col justify-center pl-16 gap-4">
                                        <div class="text-12 transition-colors duration-300 group-hover:!text-neutral-0" style="color:rgba(255,255,255,0.6)">Add provider</div>
                                        <div class="font-mono text-14 whitespace-nowrap overflow-hidden transition-colors duration-300 group-hover:!text-neutral-0" style="color:rgba(255,255,255,0.92)">
                                            stripe projects add &lt;provider&gt;/&lt;service&gt;
                                        </div>
                                    </div>
                                    <div class="relative flex items-center shrink-0 pr-12">
                                        <div class="relative flex items-center justify-center w-32 h-32 bg-transparent overflow-hidden opacity-0 group-hover:opacity-100 transition-all duration-400 ease-in-out" style="color:rgba(255,255,255,0.35)">
                                            <div data-copy-cli-default class="flex items-center justify-center">
                                                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" class="relative w-14 h-14 shrink-0"><path d="M13 0a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-1.5v1a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V5.25c0-.97.78-1.75 1.75-1.75a.75.75 0 0 1 0 1.5.25.25 0 0 0-.25.25V14c0 .28.22.5.5.5h6.5a.5.5 0 0 0 .5-.5v-1H6.5a2 2 0 0 1-2-2V2c0-1.1.9-2 2-2zM6.5 1.5A.5.5 0 0 0 6 2v9c0 .28.22.5.5.5H13a.5.5 0 0 0 .5-.5V2a.5.5 0 0 0-.5-.5z"/></svg>
                                            </div>
                                            <div data-copy-cli-clicked class="absolute flex items-center justify-center translate-y-24 scale-75 opacity-0 invisible">
                                                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" class="relative w-14 h-14 shrink-0"><path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.75.75 0 0 1 1.06-1.06L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0z"/></svg>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </button>
                        <!--- CLI command --->
                        <button data-copy-cli="stripe projects --help" data-container-hover-follow class="relative w-full h-64 p-1 rounded-4 overflow-hidden group cursor-pointer text-left outline-none focus-visible:shadow-focus transition-all duration-400 ease-in-out" style="background:rgba(255,255,255,0.05)">
                            <div class="relative w-full h-full rounded-3 border border-transparent group-hover:border-neutral-0/20 transition-all duration-400" style="background:rgba(255,255,255,0.03)">
                                <div class="relative w-full h-full flex items-center justify-between rounded-3 transition-all duration-400 ease-in-out group-hover:bg-white/5">
                                    <div class="flex-1 min-w-0 flex flex-col justify-center pl-16 gap-4">
                                        <div class="text-12 transition-colors duration-300 group-hover:!text-neutral-0" style="color:rgba(255,255,255,0.6)">Get help</div>
                                        <div class="font-mono text-14 transition-colors duration-300 group-hover:!text-neutral-0" style="color:rgba(255,255,255,0.92)">
                                            stripe projects --help
                                        </div>
                                    </div>
                                    <div class="relative flex items-center shrink-0 pr-12">
                                        <div class="relative flex items-center justify-center w-32 h-32 bg-transparent overflow-hidden opacity-0 group-hover:opacity-100 transition-all duration-400 ease-in-out" style="color:rgba(255,255,255,0.35)">
                                            <div data-copy-cli-default class="flex items-center justify-center">
                                                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" class="relative w-14 h-14 shrink-0"><path d="M13 0a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-1.5v1a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V5.25c0-.97.78-1.75 1.75-1.75a.75.75 0 0 1 0 1.5.25.25 0 0 0-.25.25V14c0 .28.22.5.5.5h6.5a.5.5 0 0 0 .5-.5v-1H6.5a2 2 0 0 1-2-2V2c0-1.1.9-2 2-2zM6.5 1.5A.5.5 0 0 0 6 2v9c0 .28.22.5.5.5H13a.5.5 0 0 0 .5-.5V2a.5.5 0 0 0-.5-.5z"/></svg>
                                            </div>
                                            <div data-copy-cli-clicked class="absolute flex items-center justify-center translate-y-24 scale-75 opacity-0 invisible">
                                                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" class="relative w-14 h-14 shrink-0"><path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.75.75 0 0 1 1.06-1.06L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0z"/></svg>
                                            </div>
