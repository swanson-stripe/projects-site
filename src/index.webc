---
layout: "main.webc"
title: "Home"
seoTitle: "Stripe Projects | Provision and Manage Services from the CLI"
ogTitle: "Stripe Projects | Provision and Manage Services from the CLI"
seoDesc: "Enable you or your agents to provision hosting, databases, auth, AI, and more from the CLI. Generate credentials and manage usage and billing in one place."
ogDesc: "Enable you or your agents to provision hosting, databases, auth, AI, and more from the CLI. Generate credentials and manage usage and billing in one place."
ogImage: "/assets/images/og/og.jpg"
ogImageAlt: "Stripe Projects — Provision your stack from the CLI"
twitterImage: "/assets/images/og/twitter-large.jpg"
changefreq: "weekly"
---

<!--- Page --->
<div class="relative w-full">

    <!--- Header --->
    <header class="relative w-full flex items-center justify-center px-16 z-50 group/header">
        <helm-container class="relative pt-24 pb-0 grid grid-cols-3 items-center">
            <div></div>
            <div data-header="logo" class="relative flex items-center justify-center h-40 gap-4">
                <div class="relative flex items-center gap-8 h-full px-10 whitespace-nowrap">
                    <icon-logo class="h-[1em] w-auto text-headline shrink-0"></icon-logo>
                    <span class="text-16 font-normal text-headline">Stripe Projects</span>
                </div>
            </div>
            <a href="/providers/" class="hidden sm:flex items-center justify-end gap-6 text-14 font-normal text-primary hover:text-primary-hover transition-colors duration-200 group">
                <span>View providers</span>
                <icon-arrowanimate @size="sm" class=""></icon-arrowanimate>
            </a>
        </helm-container>
    </header>

    <!--- Page contents --->
    <main id="main" class="group/main">

        <!--- Hero --->
        <helm-section class="relative z-20">
            <helm-container class="relative flex flex-col items-center pt-12 sm:pt-12">
                <span class="inline-flex items-center px-8 py-4 rounded-full text-10 tracking-widest uppercase text-neutral-0 whitespace-nowrap bg-cover bg-center mb-40" style="background-image: url('/assets/images/badge-bg.png');">Developer Preview</span>
            </helm-container>
            <helm-container class="relative flex flex-col pt-0">
                <!--- Content --->
                <div class="relative flex flex-col items-center text-center md:px-16 mb-64 sm:mb-80">
                    <div class="mb-28 max-w-896 flex flex-col items-center justify-center">
                        <h1 data-hero="headline" class="relative text-[10vw]/100 min-[640px]:text-[9vw]/100 min-[768px]:text-64/100 tracking-tighter mb-18 text-balance min-[1024px]:text-pretty">
                            Provision and manage services from the CLI
                        </h1>
                        <p data-hero="description" class="text-16/150 sm:text-18 sm:text-18/150 text-content text-balance md:text-pretty">
                            Stripe Projects lets you or your agents provision multiple services, generate and store credentials, and manage usage and billing from the CLI. Set up hosting, databases, auth, AI, analytics, and more in a few commands.
                        </p>
                    </div>
                    <!--- CTAs --->
                    <div data-hero="cta" class="relative flex flex-col min-[448px]:flex-row items-center gap-8">
                        <!--- Install skill CTA (primary) --->
                        <button data-copy-cli="npx skill add https://docs.stripe.com --skill stripe-projects -g -y" class="relative flex items-center justify-center gap-6 px-24 h-48 bg-primary text-neutral-0 font-normal rounded-4 group overflow-hidden hover:bg-primary-hover focus-visible:bg-primary-hover focus-visible:shadow-focus transition-all duration-250 cursor-pointer outline-none">
                            <div data-copy-cli-default class="relative flex items-center gap-8">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" class="w-16 h-16">
                                    <path d="M7.25 1a.75.75 0 0 1 1.5 0v7.19l2.22-2.22a.75.75 0 1 1 1.06 1.06l-3.5 3.5a.75.75 0 0 1-1.06 0l-3.5-3.5a.75.75 0 0 1 1.06-1.06l2.22 2.22V1z"/>
                                    <path d="M2.75 11a.75.75 0 0 1 .75.75v1.5c0 .14.11.25.25.25h8.5c.14 0 .25-.11.25-.25v-1.5a.75.75 0 0 1 1.5 0v1.5A1.75 1.75 0 0 1 12.25 15h-8.5A1.75 1.75 0 0 1 2 12.75v-1.5a.75.75 0 0 1 .75-.75z"/>
                                </svg>
                                <span class="pb-2">Install skill</span>
                            </div>
                            <div data-copy-cli-clicked class="absolute translate-y-24 scale-75 opacity-0 invisible">
                                <div class="-translate-y-1">Copied</div>
                            </div>
                        </button>
                        <!--- Variant: request-docs --->
                        <link-btn webc:if="base.ctaMode === 'request-docs'" size="48" color="outline" href="https://docs.stripe.com/projects">
                            <span slot="label">Request access</span>
                            <icon-arrowanimate slot="icon-right" @size="md" class=""></icon-arrowanimate>
                        </link-btn>
                        <!--- Variant: request-modal --->
                        <button webc:if="base.ctaMode === 'request-modal'" onclick="openRequestModal()" class="relative flex items-center justify-center gap-6 px-24 h-48 bg-foreground text-headline font-normal rounded-4 border border-edge group hover:bg-highlight focus-visible:bg-highlight focus-visible:shadow-focus transition-all duration-250 cursor-pointer outline-none">
                            <span class="pb-2">Request access</span>
                            <icon-arrowanimate @size="md" class=""></icon-arrowanimate>
                        </button>
                        <!--- Secondary CTA (all variants) --->
                        <link-btn size="48" color="outline" href="https://docs.stripe.com/projects">
                            <span slot="label">View docs</span>
                            <icon-arrowanimate slot="icon-right" @size="md" class=""></icon-arrowanimate>
                        </link-btn>
                    </div>
                    <!--- Example prompt (rotating) --->
                    <button data-prompt-rotate class="relative flex items-center gap-8 mt-16 px-16 h-40 bg-foreground rounded-8 border border-edge cursor-pointer outline-none group hover:bg-highlight focus-visible:shadow-focus transition-all duration-200 overflow-hidden">
                        <div data-prompt-rotate-default class="relative flex items-center gap-8">
                            <span class="font-mono text-14 text-content whitespace-nowrap"><span class="text-detail">Try prompt:</span> use Stripe Projects to add <span data-prompt-rotate-provider class="text-primary">neon postgres</span></span>
                            <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" class="w-14 h-14 text-detail shrink-0 opacity-0 group-hover:opacity-100 transition-opacity duration-200"><path d="M13 0a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-1.5v1a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V5.25c0-.97.78-1.75 1.75-1.75a.75.75 0 0 1 0 1.5.25.25 0 0 0-.25.25V14c0 .28.22.5.5.5h6.5a.5.5 0 0 0 .5-.5v-1H6.5a2 2 0 0 1-2-2V2c0-1.1.9-2 2-2zM6.5 1.5A.5.5 0 0 0 6 2v9c0 .28.22.5.5.5H13a.5.5 0 0 0 .5-.5V2a.5.5 0 0 0-.5-.5z"/></svg>
                        </div>
                        <div data-prompt-rotate-clicked class="absolute inset-0 flex items-center justify-center translate-y-24 scale-75 opacity-0 invisible">
                            <span class="text-14">Copied</span>
                        </div>
                    </button>
                </div>
                <!--- Visual --->
                <div class="relative w-full">
                    <!--- Install bar: simple flow bar on mobile, absolute card on sm+ --->
                    <!--- Mobile bar --->
                    <div webc:if="base.ctaMode === 'install'" class="sm:hidden relative w-screen left-1/2 -translate-x-1/2 flex items-center h-48 px-16 bg-foreground">
                        <button data-copy-bar class="relative flex items-center justify-between w-full min-w-0 h-32 px-12 bg-highlight rounded-6 shadow-inset-border cursor-pointer outline-none group gap-8">
                            <div class="relative min-w-0 font-mono text-14 truncate">
                                <span class="text-detail select-none">$ </span>brew install <span class="text-primary">stripe/stripe-cli/stripe</span> && <span class="text-primary">stripe</span> plugin install <span class="text-primary">projects</span>
                            </div>
                            <div class="relative flex items-center justify-center w-16 h-16 shrink-0 text-detail">
                                <div data-copy-bar-icon class="flex items-center justify-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" class="w-16 h-16"><path d="M13 0a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-1.5v1a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V5.25c0-.97.78-1.75 1.75-1.75a.75.75 0 0 1 0 1.5.25.25 0 0 0-.25.25V14c0 .28.22.5.5.5h6.5a.5.5 0 0 0 .5-.5v-1H6.5a2 2 0 0 1-2-2V2c0-1.1.9-2 2-2zM6.5 1.5A.5.5 0 0 0 6 2v9c0 .28.22.5.5.5H13a.5.5 0 0 0 .5-.5V2a.5.5 0 0 0-.5-.5z"/></svg>
                                </div>
                                <div data-copy-bar-check class="absolute flex items-center justify-center opacity-0 invisible text-[#006F3A]">
                                    <icon-check @size="12" @weight="strong"></icon-check>
                                </div>
                            </div>
                        </button>
                    </div>
                    <!--- Desktop card (sm+) --->
                    <div webc:if="base.ctaMode === 'install'" class="hidden sm:flex absolute top-0 left-0 rounded-12 bg-foreground border border-edge -mb-6 pb-6 -translate-y-48 -translate-x-8 w-[calc(100%+1rem)] h-[calc(100%+3.5rem)]">
                        <div class="absolute top-0 left-0 w-full flex gap-8 h-48 px-8 overflow-hidden">
                            <button data-copy-bar class="relative flex items-center w-full min-w-0 h-32 mt-8 px-8 bg-highlight rounded-6 shadow-inset-border cursor-pointer outline-none text-left group">
                                <div class="relative flex items-center justify-between w-full min-w-0 h-32 gap-8">
                                    <div class="relative min-w-0 font-mono text-14 truncate">
                                        <span class="text-detail select-none">$ </span>brew install <span class="text-primary">stripe/stripe-cli/stripe</span> && <span class="text-primary">stripe</span> plugin install <span class="text-primary">projects</span>
                                    </div>
                                    <div class="relative flex items-center justify-center w-16 h-16 shrink-0 text-detail">
                                        <div data-copy-bar-icon class="flex items-center justify-center">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" class="w-16 h-16"><path d="M13 0a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-1.5v1a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V5.25c0-.97.78-1.75 1.75-1.75a.75.75 0 0 1 0 1.5.25.25 0 0 0-.25.25V14c0 .28.22.5.5.5h6.5a.5.5 0 0 0 .5-.5v-1H6.5a2 2 0 0 1-2-2V2c0-1.1.9-2 2-2zM6.5 1.5A.5.5 0 0 0 6 2v9c0 .28.22.5.5.5H13a.5.5 0 0 0 .5-.5V2a.5.5 0 0 0-.5-.5z"/></svg>
                                        </div>
                                        <div data-copy-bar-check class="absolute flex items-center justify-center opacity-0 invisible text-[#006F3A]">
                                            <icon-check @size="12" @weight="strong"></icon-check>
                                        </div>
                                    </div>
                                </div>
                            </button>
                            <div class="relative flex items-center gap-8 h-full shrink-0">
                                <a href="https://docs.stripe.com/stripe-cli/install?install-method=homebrew#install" target="_blank" rel="noopener" class="relative flex items-center justify-center gap-4 px-16 h-32 rounded-4 text-14 font-normal text-content bg-highlight/50 shadow-inset-border hover:bg-highlight focus-visible:shadow-focus transition-all duration-200 ease-out cursor-pointer outline-none whitespace-nowrap group">
                                    <span class="-translate-y-px">More CLI install options</span>
                                    <icon-arrowanimate @size="md" class=""></icon-arrowanimate>
                                </a>
                            </div>
                        </div>
                    </div>
                    <!--- Graphics --->
                    <div class="relative flex items-center justify-center -ml-16 w-[calc(100%+2rem)] py-8 px-8 sm:py-24 min-[48rem]:py-48 md:py-96 sm:px-24 sm:ml-0 sm:w-full bg-foreground overflow-hidden sm:w-full sm:rounded-6">
                        <!--- Wave --->
                        <div class="absolute top-0 left-0 w-full h-full pointer-events-none">
                            <img src="/assets/images/home/wave-fallback.jpg" alt="" width="2528" height="1580" class="absolute top-0 left-0 w-full flex h-full object-cover object-center">
                            <div data-js-target="nouveau-bloom-wave" class="relative w-full h-full" data-position-x="500" data-position-y="100" data-blur="0" data-camera-zoom="1.5" data-wave-rotation="-85" data-color-offset="0" data-dither-gradient="2" data-dither-scale="3" data-dither-full="true"></div>
                            <div class="absolute top-0 left-0 w-full h-full border border-headline/15 rounded-6 z-10"></div>
                        </div>
                        <!--- UI Content --->
                        <div class="relative flex flex-col items-center justify-center w-600 z-10 overflow-hidden">
                            <!--- Terminal --->
                            <div data-hero="terminal" class="relative flex w-full p-6 bg-linear-to-b from-highlight/20 to-highlight/10 border border-highlight/30 backdrop-blur-md rounded-12 shadow-xl overflow-hidden">
                                <div class="relative w-full h-full bg-neutral-25 rounded-6 shadow-lg overflow-hidden">
                                    <!--- Terminal window controls --->
                                    <div aria-hidden="true" class="relative shrink-0 flex items-center justify-between w-full h-32 border-b border-headline/4">
                                        <!--- Left --->
                                        <div class="flex items-center gap-4">
                                            <div class="flex gap-4 px-8">
                                                <div class="w-10 h-10 rounded-full bg-headline/4 shadow-inset-border hover:bg-[#E85E59] transition duration-200 ease-out"></div>
                                                <div class="w-10 h-10 rounded-full bg-headline/4 shadow-inset-border hover:bg-[#EFC334] transition duration-200 ease-out"></div>
                                                <div class="w-10 h-10 rounded-full bg-headline/4 shadow-inset-border hover:bg-[#5CBC58] transition duration-200 ease-out"></div>
                                            </div>
                                            <div class="flex items-center gap-4 text-detail text-14"></div>
                                        </div>
                                    </div>
                                    <!--- Terminal contents --->
                                    <div class="relative w-full h-full font-mono text-10 sm:text-14 px-16 pt-10 pb-24 whitespace-nowrap tracking-normal">
                                        <!--- Command line (always visible) --->
                                        <div class="relative w-full pb-6">
                                            <span class="text-detail">›</span>
                                            <span><span>stripe projects</span> <span>add</span> <span data-hero-type>vercel/project</span></span>
                                            <span data-term-cursor class="inline-block w-[0.69em] h-[1.32em] bg-primary animate-carat -ml-[0.54em] [vertical-align:-0.24em]"></span>
                                        </div>
                                        <!--- Provisioning block --->
                                        <div data-term="provisioning">
                                            <div data-term-line class="relative w-full text-detail pb-6">
                                                ○ Provisioning service...
                                            </div>
                                            <div data-term-line class="relative pb-6 text-detail">
                                                <div class="absolute -top-[0.25em] left-[2ch] w-[1ch] h-[1em] border-l border-b border-neutral-100"></div>
                                                <span>&nbsp;&nbsp;&nbsp;&nbsp;<span class="relative inline-block w-[1em] h-[1em] sm:w-[0.75em] sm:h-[0.75em] mr-[1ch] translate-y-[0.125em] sm:translate-y-0 shrink-0"><span data-check-dot class="absolute inset-0 flex items-center leading-none text-detail">○</span><span data-check-icon class="absolute inset-0 text-[#006F3A]" style="visibility:hidden"><icon-check size="var"></icon-check></span></span>Configuration complete</span>
                                            </div>
                                            <div data-term-line class="relative pb-6 text-detail">
                                                <div class="absolute -top-[1.25em] left-[2ch] w-[1ch] h-[2em] border-l border-b border-neutral-100"></div>
                                                <span class="inline-block pl-[4ch]"><span class="relative inline-block w-[1em] h-[1em] sm:w-[0.75em] sm:h-[0.75em] mr-[1ch] translate-y-[0.125em] sm:translate-y-0 shrink-0"><span data-check-dot class="absolute inset-0 flex items-center leading-none text-detail">○</span><span data-check-icon class="absolute inset-0 text-[#006F3A]" style="visibility:hidden"><icon-check size="var"></icon-check></span></span>Credentials generated &amp; synced</span>
                                            </div>
                                        </div>
                                        <!--- Provider ready block --->
                                        <div data-term="ready">
                                            <div data-term-line class="relative w-full text-headline pb-6">
                                                <div class="inline-block w-[1ch] h-[1ch] bg-[#006F3A] rounded-full mr-[1ch]"></div><span class="text-[#006F3A]">Provider</span> <span>ready</span>
                                            </div>
                                            <div data-term-line class="relative pb-6">
                                                <div class="absolute -top-[0.25em] left-[2ch] w-[1ch] h-[1em] border-l border-b border-neutral-100"></div>
                                                <span class="inline-block pl-[4ch]"><span class="relative inline-block w-[1em] h-[1em] sm:w-[0.75em] sm:h-[0.75em] mr-[1ch] translate-y-[0.125em] sm:translate-y-0 shrink-0"><span data-check-dot class="absolute inset-0 flex items-center leading-none text-detail">○</span><span data-check-icon class="absolute inset-0 text-[#006F3A]" style="visibility:hidden"><icon-check size="var"></icon-check></span></span>Created</span>
                                            </div>
                                            <div data-term-line class="relative pb-6">
                                                <div class="absolute -top-[1.25em] left-[2ch] w-[1ch] h-[2em] border-l border-b border-neutral-100"></div>
                                                <span class="inline-block pl-[4ch]"><span class="relative inline-block w-[1em] h-[1em] sm:w-[0.75em] sm:h-[0.75em] mr-[1ch] translate-y-[0.125em] sm:translate-y-0 shrink-0"><span data-check-dot class="absolute inset-0 flex items-center leading-none text-detail">○</span><span data-check-icon class="absolute inset-0 text-[#006F3A]" style="visibility:hidden"><icon-check size="var"></icon-check></span></span>Added 4 environment variables in <span class="text-primary">.env</span></span>
                                            </div>
                                            <div data-term-line class="relative">
                                                <div class="absolute -top-[1.25em] left-[2ch] w-[1ch] h-[2em] border-l border-b border-neutral-100"></div>
                                                <span class="inline-block pl-[4ch]"><span class="relative inline-block w-[1em] h-[1em] sm:w-[0.75em] sm:h-[0.75em] mr-[1ch] translate-y-[0.125em] sm:translate-y-0 shrink-0"><span data-check-dot class="absolute inset-0 flex items-center leading-none text-detail">○</span><span data-check-icon class="absolute inset-0 text-[#006F3A]" style="visibility:hidden"><icon-check size="var"></icon-check></span></span>Modified <span class="text-primary">.projects/vault/vault.json</span></span>
                                            </div>
                                        </div>
                                        <!--- Upgrade block --->
                                        <div data-term="upgrade">
                                            <div data-upgrade-cmd class="relative w-full pb-6 mt-6">
                                                <span class="text-detail">›</span>
                                                <span><span data-upgrade-type></span></span>
                                                <span data-upgrade-cursor class="inline-block w-[0.69em] h-[1.32em] bg-primary animate-carat -ml-[0.54em] [vertical-align:-0.24em]"></span>
                                            </div>
                                            <div data-upgrade-select>
                                                <div data-select-header class="relative w-full text-detail pb-6">
                                                    <span data-blink-dot class="inline-block mr-[0.5ch]">○</span> Select a service
                                                </div>
                                                <div data-tier-item="0" class="relative pb-2">
                                                    <div class="absolute -top-[0.25em] left-[2ch] w-[1ch] h-[1em] border-l border-b border-neutral-100"></div>
                                                    <span class="inline-block pl-[4ch]"><span class="text-primary">Starter ‹</span></span>
                                                </div>
                                                <div data-tier-item="1" class="relative pb-2">
                                                    <div class="absolute -top-[1.25em] left-[2ch] w-[1ch] h-[2em] border-l border-b border-neutral-100"></div>
                                                    <span class="inline-block pl-[4ch]"><span class="text-detail">Hobby</span></span>
                                                </div>
                                                <div data-tier-item="2" class="relative">
                                                    <div class="absolute -top-[1.25em] left-[2ch] w-[1ch] h-[2em] border-l border-b border-neutral-100"></div>
                                                    <span class="inline-block pl-[4ch]"><span class="text-detail">Pro</span></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </helm-container>
        </helm-section>

        <!--- Logos --->
        <helm-section class="relative z-10 pt-32 sm:pt-40 pb-36 md:pb-0 overflow-hidden">
            <helm-container class="relative flex flex-col items-center gap-24">
                <!--- Label --->
                <div class="relative flex flex-col sm:flex-row items-center gap-8">
                    <span class="uppercase text-detail text-12 tracking-widest whitespace-nowrap">Supported providers</span>
                    <span class="inline-flex items-center px-8 py-4 rounded-full bg-foreground text-10 tracking-widest uppercase text-detail whitespace-nowrap">+ More soon</span>
                </div>
                <!--- Logo grid: 2 cols default, 4 cols sm+; last row spanned and flex-centered (reliable vs col-start if root .webc not in Tailwind @source) --->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-y-24 gap-x-16 w-full max-w-896">
                    <div class="flex items-center justify-center h-40">
                        <logo-agentmail data-provider-slug="agentmail/api" class="h-16 sm:h-24 w-auto max-w-full cursor-pointer"></logo-agentmail>
                    </div>
                    <div class="flex items-center justify-center h-40">
                        <logo-algolia data-provider-slug="algolia/application" class="h-18 sm:h-25 w-auto max-w-full cursor-pointer"></logo-algolia>
                    </div>
                    <div class="flex items-center justify-center h-40">
                        <logo-amplitude data-provider-slug="amplitude/analytics" class="h-18 sm:h-24 w-auto max-w-full cursor-pointer"></logo-amplitude>
                    </div>
                    <div class="flex items-center justify-center h-40">
                        <logo-auth0 data-provider-slug="auth0/client" class="h-20 sm:h-28 w-auto max-w-full cursor-pointer"></logo-auth0>
                    </div>
                    <div class="flex items-center justify-center h-40">
                        <logo-browserbase data-provider-slug="browserbase/project" class="h-21 sm:h-31 w-auto max-w-full cursor-pointer"></logo-browserbase>
                    </div>
                    <div class="flex items-center justify-center h-40">
                        <logo-chroma data-provider-slug="chroma/database" class="h-28 sm:h-40 w-auto max-w-full cursor-pointer"></logo-chroma>
                    </div>
                    <div class="flex items-center justify-center h-40">
                        <logo-clerk data-provider-slug="clerk/auth" class="h-36 sm:h-48 w-auto max-w-full cursor-pointer"></logo-clerk>
                    </div>
                    <div class="flex items-center justify-center h-40">
                        <logo-cloudflare data-provider-slug="cloudflare/worker" class="h-14 sm:h-20 w-auto max-w-full cursor-pointer"></logo-cloudflare>
                    </div>
                    <div class="flex items-center justify-center h-40">
                        <logo-daytona data-provider-slug="daytona/sandbox" class="h-20 sm:h-29 w-auto max-w-full cursor-pointer"></logo-daytona>
                    </div>
                    <div class="flex items-center justify-center h-40">
                        <logo-elevenlabs data-provider-slug="elevenlabs/tts" class="h-12 sm:h-18 w-auto max-w-full cursor-pointer"></logo-elevenlabs>
                    </div>
                    <div class="flex items-center justify-center h-40">
                        <logo-firecrawl data-provider-slug="firecrawl/api" class="h-20 sm:h-28 w-auto max-w-full cursor-pointer"></logo-firecrawl>
                    </div>
                    <div class="flex items-center justify-center h-40">
                        <logo-flyio data-provider-slug="flyio/app" class="h-18 sm:h-28 w-auto max-w-full cursor-pointer"></logo-flyio>
                    </div>
                    <div class="flex items-center justify-center h-40">
                        <logo-gitlab data-provider-slug="gitlab/project" class="h-29 sm:h-43 w-auto max-w-full cursor-pointer"></logo-gitlab>
                    </div>
                    <div class="flex items-center justify-center h-40">
                        <logo-huggingface data-provider-slug="huggingface/platform" class="h-22 sm:h-36 w-auto max-w-full cursor-pointer"></logo-huggingface>
                    </div>
                    <div class="flex items-center justify-center h-40">
                        <logo-inngest data-provider-slug="inngest/app" class="h-12 sm:h-18 w-auto max-w-full cursor-pointer"></logo-inngest>
                    </div>
                    <div class="flex items-center justify-center h-40">
                        <logo-mixpanel data-provider-slug="mixpanel/analytics" class="h-16 sm:h-24 w-auto max-w-full cursor-pointer"></logo-mixpanel>
                    </div>
                    <div class="flex items-center justify-center h-40">
                        <logo-neon data-provider-slug="neon/postgres" class="h-28 sm:h-40 w-auto max-w-full cursor-pointer"></logo-neon>
                    </div>
                    <div class="flex items-center justify-center h-40">
                        <logo-netlify data-provider-slug="netlify/project" class="h-28 sm:h-40 w-auto max-w-full cursor-pointer"></logo-netlify>
                    </div>
                    <div class="flex items-center justify-center h-40">
                        <logo-openrouter data-provider-slug="openrouter/api" class="h-14 sm:h-20 w-auto max-w-full cursor-pointer"></logo-openrouter>
                    </div>
                    <div class="flex items-center justify-center h-40">
                        <logo-planetscale data-provider-slug="planetscale/postgresql" class="h-28 sm:h-40 w-auto max-w-full cursor-pointer"></logo-planetscale>
                    </div>
                    <div class="flex items-center justify-center h-40">
                        <logo-posthog data-provider-slug="posthog/analytics" class="h-28 sm:h-40 w-auto max-w-full cursor-pointer"></logo-posthog>
                    </div>
                    <div class="flex items-center justify-center h-40">
                        <logo-privy data-provider-slug="privy/app" class="h-9 sm:h-22 w-auto max-w-full cursor-pointer"></logo-privy>
                    </div>
                    <div class="flex items-center justify-center h-40">
                        <logo-railway data-provider-slug="railway/hosting" class="h-28 sm:h-40 w-auto max-w-full cursor-pointer"></logo-railway>
                    </div>
                    <div class="flex items-center justify-center h-40">
                        <logo-render data-provider-slug="render/static-site" class="h-14 sm:h-20 w-auto max-w-full cursor-pointer"></logo-render>
                    </div>
                    <div class="flex items-center justify-center h-40">
                        <logo-runloop data-provider-slug="runloop/sandbox" class="h-28 sm:h-40 w-auto max-w-full cursor-pointer"></logo-runloop>
                    </div>
                    <div class="flex items-center justify-center h-40">
                        <logo-sentry data-provider-slug="sentry/project" class="h-19 sm:h-29 w-auto max-w-full cursor-pointer"></logo-sentry>
                    </div>
                    <div class="flex items-center justify-center h-40">
                        <logo-supabase data-provider-slug="supabase/project" class="h-28 sm:h-40 w-auto max-w-full cursor-pointer"></logo-supabase>
                    </div>
                    <div class="flex items-center justify-center h-40">
                        <logo-turso data-provider-slug="turso/database" class="h-24 sm:h-36 w-auto max-w-full cursor-pointer"></logo-turso>
                    </div>
                    <div class="flex items-center justify-center h-40">
                        <logo-twilio data-provider-slug="twilio/email" class="h-28 sm:h-40 w-auto max-w-full cursor-pointer"></logo-twilio>
                    </div>
                    <div class="flex items-center justify-center h-40">
                        <logo-upstash data-provider-slug="upstash/redis" class="h-18 sm:h-28 w-auto max-w-full cursor-pointer"></logo-upstash>
                    </div>
                    <div class="flex items-center justify-center h-40">
                        <logo-vercel data-provider-slug="vercel/project" class="h-28 sm:h-40 w-auto max-w-full cursor-pointer"></logo-vercel>
                    </div>
                    <div class="flex items-center justify-center h-40">
                        <logo-workos data-provider-slug="workos/auth" class="h-14 sm:h-24 w-auto max-w-full cursor-pointer"></logo-workos>
                    </div>
                </div>
                <!--- View providers link: mobile only (header has it on sm+) --->
                <a href="/providers/" class="flex sm:hidden items-center gap-6 text-14 font-normal text-primary hover:text-primary-hover transition-colors duration-200 group">
                    <span>View providers</span>
                    <icon-arrowanimate @size="sm" class=""></icon-arrowanimate>
                </a>
            </helm-container>
        </helm-section>

        <!--- Content --->
        <helm-section class="relative md:pb-64 z-10" style="padding-top: 80px;">
            <helm-container class="relative text-pretty md:grid md:grid-cols-2 gap-16 items-start">
                <!--- Headline --->
                <h2 class="text-28/110 sm:text-36/110 tracking-[-0.0375em] text-headline mb-16 md:mb-0">
                    Code generation got fast.<br>Provisioning didn’t.
                </h2>
                <p class="text-16 sm:text-18 text-content">
                    Provisioning your app stack is still too manual: signing up for multiple services, managing accounts, securing API keys, jumping between dashboards, and clicking configuration pages. Stripe Projects lets you (or your agents) create and manage your software stack from the command line.
                </p>
            </helm-container>
        </helm-section>

        <!--- Content --->
        <helm-section class="relative pt-64 pb-32 md:pt-64 md:pb-64 z-10">
            <helm-container class="md:grid md:grid-cols-2 items-center relative text-pretty">
                <!--- Content col --->
                <div class="relative flex flex-col items-start text-16 sm:text-18/150 text-content md:pr-80">
                    <h2 class="text-headline text-28/110 sm:text-36/110 tracking-[-0.0375em] mb-16">
                        Prompt to provision
                    </h2>
                    <p class="md:mb-24">
                        Add the services your app needs from the CLI—or let your agent do it. Resources are provisioned in accounts you own, credentials sync back to your environment, and changes are auditable and repeatable.
                    </p>
                </div>
                <!--- Commands col -->
                <div class="relative hidden md:block pb-6">
                    <div class="sticky top-48 w-full flex flex-col gap-4 rounded-6 border border-edge bg-foreground p-4">
                        <!--- Terminal title --->
                        <div class="relative w-full flex items-center justify-center px-4 py-4">
                            <div class="text-14 text-detail shrink-0 whitespace-nowrap">
                                Key commands
                            </div>
                        </div>
                        <!--- CLI command --->
                        <button data-copy-cli="stripe projects init" data-container-hover-follow class="relative w-full h-64 rounded-4 group cursor-pointer text-left outline-none focus-visible:shadow-focus border border-edge hover:bg-highlight transition-[background-color] duration-50 ease-in-out">
                            <div class="relative w-full h-full flex items-center justify-between">
                                    <div class="flex-1 min-w-0 flex flex-col justify-center pl-16 gap-4">
                                        <div class="text-12 text-detail">Create project</div>
                                        <div class="font-mono text-14 text-headline">
                                            stripe projects <span style="color:#635BFF">init</span>
                                        </div>
                                    </div>
                                    <div class="relative flex items-center shrink-0 pr-12">
                                        <div class="relative flex items-center justify-center w-32 h-32 bg-transparent overflow-hidden opacity-0 group-hover:opacity-100 transition-all duration-400 ease-in-out text-detail">
                                            <div data-copy-cli-default class="flex items-center justify-center">
                                                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" class="relative w-14 h-14 shrink-0"><path d="M13 0a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-1.5v1a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V5.25c0-.97.78-1.75 1.75-1.75a.75.75 0 0 1 0 1.5.25.25 0 0 0-.25.25V14c0 .28.22.5.5.5h6.5a.5.5 0 0 0 .5-.5v-1H6.5a2 2 0 0 1-2-2V2c0-1.1.9-2 2-2zM6.5 1.5A.5.5 0 0 0 6 2v9c0 .28.22.5.5.5H13a.5.5 0 0 0 .5-.5V2a.5.5 0 0 0-.5-.5z"/></svg>
                                            </div>
                                            <div data-copy-cli-clicked class="absolute flex items-center justify-center translate-y-24 scale-75 opacity-0 invisible">
                                                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" class="relative w-14 h-14 shrink-0"><path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.75.75 0 0 1 1.06-1.06L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0z"/></svg>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                        </button>
                        <!--- CLI command --->
                        <button data-copy-cli="stripe projects catalog" data-container-hover-follow class="relative w-full h-64 rounded-4 group cursor-pointer text-left outline-none focus-visible:shadow-focus border border-edge hover:bg-highlight transition-[background-color] duration-50 ease-in-out">
                            <div class="relative w-full h-full flex items-center justify-between">
                                    <div class="flex-1 min-w-0 flex flex-col justify-center pl-16 gap-4">
                                        <div class="text-12 text-detail">View all providers</div>
                                        <div class="font-mono text-14 text-headline">
                                            stripe projects <span style="color:#635BFF">catalog</span>
                                        </div>
                                    </div>
                                    <div class="relative flex items-center shrink-0 pr-12">
                                        <div class="relative flex items-center justify-center w-32 h-32 bg-transparent overflow-hidden opacity-0 group-hover:opacity-100 transition-all duration-400 ease-in-out text-detail">
                                            <div data-copy-cli-default class="flex items-center justify-center">
                                                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" class="relative w-14 h-14 shrink-0"><path d="M13 0a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-1.5v1a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V5.25c0-.97.78-1.75 1.75-1.75a.75.75 0 0 1 0 1.5.25.25 0 0 0-.25.25V14c0 .28.22.5.5.5h6.5a.5.5 0 0 0 .5-.5v-1H6.5a2 2 0 0 1-2-2V2c0-1.1.9-2 2-2zM6.5 1.5A.5.5 0 0 0 6 2v9c0 .28.22.5.5.5H13a.5.5 0 0 0 .5-.5V2a.5.5 0 0 0-.5-.5z"/></svg>
                                            </div>
                                            <div data-copy-cli-clicked class="absolute flex items-center justify-center translate-y-24 scale-75 opacity-0 invisible">
                                                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" class="relative w-14 h-14 shrink-0"><path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.75.75 0 0 1 1.06-1.06L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0z"/></svg>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                        </button>
                        <!--- CLI command --->
                        <button data-copy-cli="stripe projects add <provider>" data-container-hover-follow class="relative w-full h-64 rounded-4 group cursor-pointer text-left outline-none focus-visible:shadow-focus border border-edge hover:bg-highlight transition-[background-color] duration-50 ease-in-out">
                            <div class="relative w-full h-full flex items-center justify-between">
                                    <div class="flex-1 min-w-0 flex flex-col justify-center pl-16 gap-4">
                                        <div class="text-12 text-detail">Add provider</div>
                                        <div class="font-mono text-14 text-headline whitespace-nowrap overflow-hidden">
                                            stripe projects <span style="color:#635BFF">add &lt;provider&gt;/&lt;service&gt;</span>
                                        </div>
                                    </div>
                                    <div class="relative flex items-center shrink-0 pr-12">
                                        <div class="relative flex items-center justify-center w-32 h-32 bg-transparent overflow-hidden opacity-0 group-hover:opacity-100 transition-all duration-400 ease-in-out text-detail">
                                            <div data-copy-cli-default class="flex items-center justify-center">
                                                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" class="relative w-14 h-14 shrink-0"><path d="M13 0a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-1.5v1a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V5.25c0-.97.78-1.75 1.75-1.75a.75.75 0 0 1 0 1.5.25.25 0 0 0-.25.25V14c0 .28.22.5.5.5h6.5a.5.5 0 0 0 .5-.5v-1H6.5a2 2 0 0 1-2-2V2c0-1.1.9-2 2-2zM6.5 1.5A.5.5 0 0 0 6 2v9c0 .28.22.5.5.5H13a.5.5 0 0 0 .5-.5V2a.5.5 0 0 0-.5-.5z"/></svg>
                                            </div>
                                            <div data-copy-cli-clicked class="absolute flex items-center justify-center translate-y-24 scale-75 opacity-0 invisible">
                                                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" class="relative w-14 h-14 shrink-0"><path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.75.75 0 0 1 1.06-1.06L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0z"/></svg>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                        </button>
                        <!--- CLI command --->
                        <button data-copy-cli="stripe projects upgrade <provider>" data-container-hover-follow class="relative w-full h-64 rounded-4 group cursor-pointer text-left outline-none focus-visible:shadow-focus border border-edge hover:bg-highlight transition-[background-color] duration-50 ease-in-out">
                            <div class="relative w-full h-full flex items-center justify-between">
                                    <div class="flex-1 min-w-0 flex flex-col justify-center pl-16 gap-4">
                                        <div class="text-12 text-detail">Upgrade provider</div>
                                        <div class="font-mono text-14 text-headline whitespace-nowrap overflow-hidden">
                                            stripe projects <span style="color:#635BFF">upgrade &lt;provider&gt;</span>
                                        </div>
                                    </div>
                                    <div class="relative flex items-center shrink-0 pr-12">
                                        <div class="relative flex items-center justify-center w-32 h-32 bg-transparent overflow-hidden opacity-0 group-hover:opacity-100 transition-all duration-400 ease-in-out text-detail">
                                            <div data-copy-cli-default class="flex items-center justify-center">
                                                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" class="relative w-14 h-14 shrink-0"><path d="M13 0a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-1.5v1a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V5.25c0-.97.78-1.75 1.75-1.75a.75.75 0 0 1 0 1.5.25.25 0 0 0-.25.25V14c0 .28.22.5.5.5h6.5a.5.5 0 0 0 .5-.5v-1H6.5a2 2 0 0 1-2-2V2c0-1.1.9-2 2-2zM6.5 1.5A.5.5 0 0 0 6 2v9c0 .28.22.5.5.5H13a.5.5 0 0 0 .5-.5V2a.5.5 0 0 0-.5-.5z"/></svg>
                                            </div>
                                            <div data-copy-cli-clicked class="absolute flex items-center justify-center translate-y-24 scale-75 opacity-0 invisible">
                                                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" class="relative w-14 h-14 shrink-0"><path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.75.75 0 0 1 1.06-1.06L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0z"/></svg>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                        </button>
                    </div>
                </div>
            </helm-container>
        </helm-section>

        <!--- Content --->
        <helm-section class="relative pt-32 pb-32 md:pt-64 md:pb-64 z-10">
            <helm-container class="relative flex flex-col relative text-pretty">
                <h2 class="relative text-headline text-28/110 sm:text-36/110 tracking-[-0.0375em] mb-32 sm:mb-48 md:whitespace-nowrap">
                    Fast, secure, and portable infrastructure provisioning
                </h2>
                <ul class="relative w-full grid sm:grid-cols-2 gap-x-16 gap-y-32 sm:gap-y-48 leading-150 text-headline text-16 sm:text-18/150">
                    <li class="relative flex flex-col items-start gap-16 pr-48 group/feature">
                        <div class="text-neutral-0 flex items-center justify-center w-40 h-40 rounded-4 shrink-0 bg-primary">
                            <icon-apps class="w-16 h-16"></icon-apps>
                        </div>
                        <div>
                            <h3 class="text-headline leading-130 font-normal mb-4">
                                Programmatic
                            </h3>
                            <p class="text-content">
                                One workflow to provision services, manage credentials, and upgrade plans, instead of different tools and workflows for every provider.
                            </p>
                        </div>
                    </li>
                    <li class="relative flex flex-col items-start gap-16 pr-48 group/feature">
                        <div class="text-neutral-0 flex items-center justify-center w-40 h-40 rounded-4 shrink-0 bg-primary">
                            <svg mlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 17" width="16" height="17" class="relative z-10 w-18 h-18">
                                <path d="M13.25 7.52a2.248 2.248 0 0 1 .75 4.368v1.632h1.5v1.5H14v1h-1.5v-4.132a2.248 2.248 0 0 1 .75-4.368m-3.187 2.98H5.5A3.5 3.5 0 0 0 2 14v.5h9.063V16H.5v-2a5 5 0 0 1 4.743-4.993L5.5 9h4.563zm3.187-1.48a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5M8 0a4 4 0 1 1 0 8 4 4 0 0 1 0-8m0 1.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5"/>
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-headline leading-130 font-normal mb-4">
                                Billing
                            </h3>
                            <p class="text-content">
                                Set up your billing details once and securely share them with your SaaS stack. Upgrade and downgrade tiers, monitor usage, and manage subscriptions from the CLI.
                            </p>
                        </div>
                    </li>
                    <li class="relative flex flex-col items-start gap-16 pr-48 group/feature">
                        <div class="text-neutral-0 flex items-center justify-center w-40 h-40 rounded-4 shrink-0 bg-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" class="w-16 h-16">
                                <path d="M7.25 1a.75.75 0 0 1 1.5 0v7.19l2.22-2.22a.75.75 0 1 1 1.06 1.06l-3.5 3.5a.75.75 0 0 1-1.06 0l-3.5-3.5a.75.75 0 0 1 1.06-1.06l2.22 2.22V1z"/>
                                <path d="M2.75 11a.75.75 0 0 1 .75.75v1.5c0 .14.11.25.25.25h8.5c.14 0 .25-.11.25-.25v-1.5a.75.75 0 0 1 1.5 0v1.5A1.75 1.75 0 0 1 12.25 15h-8.5A1.75 1.75 0 0 1 2 12.75v-1.5a.75.75 0 0 1 .75-.75z"/>
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-headline leading-130 font-normal mb-4">
                                Portable
                            </h3>
                            <p class="text-content">
                                Keep environment variables portable across local setups, machines, teammates, and agents.
                            </p>
                        </div>
                    </li>
                    <li class="relative flex flex-col items-start gap-16 pr-48 group/feature">
                        <div class="text-neutral-0 flex items-center justify-center w-40 h-40 rounded-4 shrink-0 bg-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="16" height="16" class="w-16 h-16">
                                <path d="m6.792 8.354-.506.552-1.783 1.945H11.4a2.25 2.25 0 0 0 2.25-2.25v-.818h1.5v.818a3.75 3.75 0 0 1-3.75 3.75H4.505l1.78 1.942.507.553-1.106 1.013-.506-.553-2.932-3.2-.465-.506.465-.507 2.931-3.2.507-.553zm4.029-7.66 2.931 3.2.465.506-.465.507-2.932 3.2-.506.552-1.106-1.013.506-.553 1.783-1.944H4.6A2.25 2.25 0 0 0 2.35 7.4v.817H.85v-.817A3.75 3.75 0 0 1 4.6 3.65h6.895l-1.78-1.942-.507-.554L10.314.141z"/>
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-headline leading-130 font-normal mb-4">
                                Secure
                            </h3>
                            <p class="text-content">
                                Generate, store, and return service credentials for both developers and agents.
                            </p>
                        </div>
                    </li>
                </ul>
            </helm-container>
        </helm-section>

        <!--- Blog --->
        <helm-section class="relative pt-64 pb-32 md:pt-96 md:pb-64 z-10">
            <helm-container class="relative flex flex-col">
                <div class="flex items-center justify-between mb-32 sm:mb-48">
                    <h2 class="text-28/110 sm:text-36/110 tracking-[-0.0375em] text-headline">From the blog</h2>
                    <a href="/blog/" class="flex items-center gap-6 text-14 font-normal text-primary hover:text-primary-hover transition-colors duration-200 group">
                        <span>View all</span>
                        <icon-arrowanimate @size="sm" class=""></icon-arrowanimate>
                    </a>
                </div>
                <div class="grid sm:grid-cols-3 gap-16">
                    <template webc:type="11ty" 11ty:type="liquid">
                        {% assign posts = collections.blog | slice: 0, 3 %}
                        {% for post in posts %}
                        <a href="/blog/{{ post.data.slug }}/" class="group relative flex flex-col justify-between gap-16 p-24 rounded-8 border border-edge hover:border-primary/40 hover:bg-foreground transition-all duration-200">
                            <div class="flex flex-col gap-12">
                                <span class="text-12 text-detail uppercase tracking-widest">{{ post.data.postDate }}</span>
                                <h3 class="text-18/130 tracking-[-0.01em] text-headline group-hover:text-primary transition-colors duration-200">{{ post.data.title }}</h3>
                                <p class="text-14/150 text-content line-clamp-2">{{ post.data.description }}</p>
                            </div>
                            <div class="flex items-center justify-between pt-12 border-t border-edge">
                                <span class="text-12 text-detail">{{ post.data.author }}</span>
                                <span class="text-primary opacity-0 group-hover:opacity-100 transition-opacity duration-200 translate-x-0 group-hover:translate-x-2 transition-transform">→</span>
                            </div>
                        </a>
                        {% endfor %}
                    </template>
                </div>
            </helm-container>
        </helm-section>

        <!--- CTAs --->
        <helm-section class="relative mt-32 lg:mt-0 lg:pt-64 bg-foreground border-t border-edge lg:border-none lg:bg-transparent lg:px-16">
            <div class="w-full max-w-[calc(79.125rem+6rem)] mx-auto bg-foreground lg:rounded-6 lg:border lg:border-edge overflow-hidden">
            <helm-container class="mx-auto relative py-72 min-[88rem]:py-96 px-16 sm:px-24 grid-cols-1 sm:grid-cols-2 grid min-[88rem]:grid-cols-4 leading-140">
                <!--- Headline --->
                <div class="relative sm:col-span-2 mb-48">
                    <h2 class="text-32/110 tracking-[-0.02em] mb-16">
                        Get started
                    </h2>
                    <p webc:if="base.ctaMode === 'install'" class="text-16 sm:text-18 text-detail text-balance mb-32">
                        Install Stripe Projects CLI.
                    </p>
                    <p webc:if="base.ctaMode !== 'install'" class="text-16 sm:text-18 text-detail text-balance mb-32">
                        Get early access to Stripe Projects.
                    </p>
                    <!--- CTAs --->
                    <div class="relative flex flex-col min-[448px]:flex-row items-start gap-8">
                        <!--- Variant: install --->
                        <button webc:if="base.ctaMode === 'install'" data-copy-cli="brew install stripe/stripe-cli/stripe && stripe plugin install projects" class="relative flex items-center justify-center px-24 h-48 bg-primary text-neutral-0 font-normal rounded-4 group overflow-hidden hover:bg-primary-hover focus-visible:bg-primary-hover focus-visible:shadow-focus transition-all duration-250 cursor-pointer outline-none">
                            <div data-copy-cli-default class="relative flex items-center gap-8">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 12 12" class="w-16 h-16 mb-1">
                                    <path fill-rule="evenodd" d="M9.75 1.88h-7.5A1.13 1.13 0 0 0 1.13 3v6a1.13 1.13 0 0 0 1.12 1.13h7.5A1.1 1.1 0 0 0 10.88 9V3a1.1 1.1 0 0 0-1.13-1.12M2.25.75A2.25 2.25 0 0 0 0 3v6a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 12 9V3A2.25 2.25 0 0 0 9.75.75z" clip-rule="evenodd"/>
                                    <path fill-rule="evenodd" d="M2.57 3.38a.56.56 0 0 1 .8-.06l2.62 2.25a.56.56 0 0 1 0 .86L3.37 8.68a.56.56 0 1 1-.74-.86L4.76 6 2.63 4.18a.56.56 0 0 1-.06-.8M6 8.06a.56.56 0 0 1 .56-.56H9.2a.56.56 0 1 1 0 1.12H6.56A.56.56 0 0 1 6 8.06" clip-rule="evenodd"/>
                                </svg>
                                <span class="pb-2">
                                    Install CLI
                                </span>
                            </div>
                            <div data-copy-cli-clicked class="absolute translate-y-24 scale-75 opacity-0 invisible">
                                <div class="-translate-y-1">
                                    Command copied
                                </div>
                            </div>
                        </button>
                        <!--- Variant: request-docs --->
                        <link-btn webc:if="base.ctaMode === 'request-docs'" size="48" color="primary" href="https://docs.stripe.com/projects">
                            <span slot="label">Request access</span>
                            <icon-arrowanimate slot="icon-right" @size="md" class=""></icon-arrowanimate>
                        </link-btn>
                        <!--- Variant: request-modal --->
                        <button webc:if="base.ctaMode === 'request-modal'" onclick="openRequestModal()" class="relative flex items-center justify-center gap-6 px-24 h-48 bg-primary text-neutral-0 font-normal rounded-4 group hover:bg-primary-hover focus-visible:bg-primary-hover focus-visible:shadow-focus transition-all duration-250 cursor-pointer outline-none">
                            <span class="pb-2">Request access</span>
                            <icon-arrowanimate @size="md" class=""></icon-arrowanimate>
                        </button>
                        <!--- Secondary CTA (all variants) --->
                        <link-btn size="48" color="outline" href="https://docs.stripe.com/projects">
                            <span slot="label">View docs</span>
                            <icon-arrowanimate slot="icon-right" @size="md" class=""></icon-arrowanimate>
                        </link-btn>
                    </div>
                </div>
                <!--- Item --->
                <div class="relative flex flex-col items-start justify-center sm:pr-16 min-[88rem]:pr-32 min-[88rem]:-mt-10 sm:h-full mb-32 sm:mb-0 group/feature">
                    <div class="w-40 flex items-center justify-center aspect-square text-neutral-0 rounded-4 mb-16 bg-primary">
                        <icon-add @size="16" weight="strong"></icon-add>
                    </div>
                    <h3 class="font-normal mb-4">
                        Recommend a provider
                    </h3>
                    <p class="text-content text-balance mb-16">
                        Let us know what services we should add next.
                    </p>
                    <a href="mailto:provider-request@stripe.com?subject=Provider%20Request" target="_blank" class="relative flex items-center justify-center gap-6 text-16 font-normal text-primary rounded-4 hover:text-primary-hover focus-visible:text-primary-hover focus-visible:shadow-focus transition-all duration-250 cursor-pointer group outline-none">
                        <span class="pb-2">
                            Suggest a provider
                        </span>
                        <icon-arrowanimate @size="md" class=""></icon-arrowanimate>
                    </a>
                </div>
                <!--- Item --->
                <div class="relative flex flex-col items-start justify-center sm:pr-16 min-[88rem]:pr-32 min-[88rem]:-mt-10 sm:h-full group/feature">
                    <div class="w-40 flex items-center justify-center aspect-square text-neutral-0 rounded-4 mb-16 bg-primary">
                        <icon-rocket @size="16" weight="strong" class="translate-y-0.5"></icon-rocket>
                    </div>
                    <h3 class="font-normal mb-4">
                        Join us!
                    </h3>
                    <p class="text-content text-balance mb-16">
                        Stripe Projects helps providers programmatically reach developers.
                    </p>
                    <a href="mailto:provider-request@stripe.com?subject=Provider%20Partnership" target="_blank" class="relative flex items-center justify-center gap-6 text-16 font-normal text-primary rounded-4 hover:text-primary-hover focus-visible:text-primary-hover focus-visible:shadow-focus transition-all duration-250 cursor-pointer group outline-none">
                        <span class="pb-2">
                            Become a provider
                        </span>
                        <icon-arrowanimate @size="md" class=""></icon-arrowanimate>
                    </a>
                </div>
            </helm-container>
            </div>
        </helm-section>

    </main>

    <!--- Copy toast --->
    <div data-copy-toast class="fixed bottom-24 left-1/2 -translate-x-1/2 z-50 flex items-center gap-8 px-16 h-40 bg-headline text-highlight rounded-8 text-14 font-normal shadow-lg pointer-events-none" style="opacity:0;visibility:hidden;">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-14 h-14 text-[#4ade80] shrink-0"><path fill-rule="evenodd" d="M12.416 3.376a.75.75 0 0 1 .208 1.04l-5 7.5a.75.75 0 0 1-1.154.114l-3-3a.75.75 0 0 1 1.06-1.06l2.353 2.353 4.493-6.74a.75.75 0 0 1 1.04-.207Z" clip-rule="evenodd"/></svg>
        <span data-copy-toast-label>Command copied</span>
    </div>

    <!--- Footer --->
    <footer class="w-full flex items-center justify-center flex-col px-16 lg:pt-96">
        <helm-container class="relative flex flex-col sm:flex-row sm:items-center sm:justify-between gap-16 py-24 border-t border-edge">
            <p class="text-14/150 text-detail" @text="`© ` + base.currentYear() + ` Stripe`"></p>
            <div class="flex flex-col sm:flex-row sm:items-center gap-16 sm:gap-24">
                <a href="https://stripe.com/privacy" class="text-14/150 font-normal text-primary hover:text-primary-hover transition-colors duration-250 outline-none">Privacy &amp; Terms</a>
                <a href="https://stripe.com" class="text-14/150 font-normal text-primary hover:text-primary-hover transition-colors duration-250 outline-none">Go to Stripe</a>
            </div>
        </helm-container>
    </footer>

</div>


<script>

    // Hero Install CLI button — copies plain text install command
    (function heroInstallCopy() {
        const btn = document.querySelector('[data-copy-install-cmd]');
        if (!btn) return;
        const command = 'brew install stripe/stripe-cli/stripe && stripe plugin install projects';
        btn.addEventListener('click', () => {
            navigator.clipboard.writeText(command);
            const defaultEl = btn.querySelector('[data-copy-install-cmd-default]');
            const clickedEl = btn.querySelector('[data-copy-install-cmd-clicked]');
            const tl = gsap.timeline({
                onStart: () => btn.classList.add('pointer-events-none'),
                onComplete: () => btn.classList.remove('pointer-events-none')
            });
            tl
            .to(defaultEl, { y: -24, autoAlpha: 0, scale: 0.75, duration: 0.25, ease: 'power3.inOut' })
            .to(clickedEl, { y: 0, autoAlpha: 1, scale: 1, duration: 0.25, ease: 'power3.inOut' }, 0)
            .to(defaultEl, { y: 0, autoAlpha: 1, scale: 1, duration: 0.25, ease: 'power3.inOut' }, 2)
            .to(clickedEl, { y: 24, autoAlpha: 0, scale: 0.75, duration: 0.25, ease: 'power3.inOut' }, 2);
        });
    })();

    // Shared toast
    function showCopyToast(message) {
        const toast = document.querySelector('[data-copy-toast]');
        const label = document.querySelector('[data-copy-toast-label]');
        if (!toast) return;
        if (label) label.textContent = message;
        gsap.killTweensOf(toast);
        gsap.fromTo(toast,
            { autoAlpha: 0, y: 8 },
            { autoAlpha: 1, y: 0, duration: 0.2, ease: 'power2.out' }
        );
        clearTimeout(toast._timer);
        toast._timer = setTimeout(() => {
            gsap.to(toast, { autoAlpha: 0, y: 8, duration: 0.25, ease: 'power2.in' });
        }, 2500);
    }

    // Copy bar (install command bar — mobile + desktop)
    (function copyBarSetup() {
        const command = 'brew install stripe/stripe-cli/stripe && stripe plugin install projects';
        document.querySelectorAll('[data-copy-bar]').forEach(btn => {
            btn.addEventListener('click', () => {
                navigator.clipboard.writeText(command);
                showCopyToast('Command copied');
                const icon = btn.querySelector('[data-copy-bar-icon]');
                const check = btn.querySelector('[data-copy-bar-check]');
                const tl = gsap.timeline({
                    onStart: () => btn.classList.add('pointer-events-none'),
                    onComplete: () => btn.classList.remove('pointer-events-none')
                });
                tl
                .to(icon, { autoAlpha: 0, scale: 0.75, duration: 0.2, ease: 'power3.inOut' })
                .to(check, { autoAlpha: 1, scale: 1, duration: 0.2, ease: 'power3.inOut' }, 0)
                .to(icon, { autoAlpha: 1, scale: 1, duration: 0.2, ease: 'power3.inOut' }, 2)
                .to(check, { autoAlpha: 0, scale: 0.75, duration: 0.2, ease: 'power3.inOut' }, 2);
            });
        });
    })();

    // Copy CLI
    function copyCLI(el) {
        const defaultContent = el.querySelector('[data-copy-cli-default]');
        const clickedContent = el.querySelector('[data-copy-cli-clicked]');
        const command = el.dataset.copyCli;
        navigator.clipboard.writeText(command);
        console.log(command);
        const tl = gsap.timeline({});
        tl
        .to(defaultContent, { y: -24, autoAlpha: 0, scale:0.75, duration: 0.25, ease: 'power3.inOut' })
        .to(clickedContent, { y: 0, autoAlpha: 1, scale:1, duration: 0.25, ease: 'power3.inOut' }, 0)
        .to(defaultContent, { y: 0, autoAlpha: 1, scale:1, duration: 0.25, ease: 'power3.inOut' }, 2)
        .to(clickedContent, { y: 24, autoAlpha: 0, scale:0.75, duration: 0.25, ease: 'power3.inOut' }, 2)
    }

    // Copy CLI events
    document.querySelectorAll('[data-copy-cli]').forEach((el) => {
        el.addEventListener('click', () => { copyCLI(el); });
    });

    // Terminal sequence
    function terminalSequence() {
        const typeEl     = document.querySelector('[data-hero-type]');
        const provBlock  = document.querySelector('[data-term="provisioning"]');
        const readyBlock = document.querySelector('[data-term="ready"]');
        const upgrBlock  = document.querySelector('[data-term="upgrade"]');
        if (!typeEl) return;

        const providerPool = {
            hosting:   ['vercel/project', 'railway/hosting', 'flyio/app', 'cloudflare/worker', 'netlify/project', 'render/static-site'],
            database:  ['neon/postgres', 'supabase/project', 'turso/database', 'planetscale/postgresql', 'chroma/database'],
            auth:      ['clerk/auth', 'auth0/client', 'workos/auth'],
            analytics: ['posthog/analytics', 'amplitude/analytics', 'mixpanel/analytics'],
            sandbox:   ['runloop/sandbox', 'daytona/sandbox'],
            ai:        ['openrouter/api', 'huggingface/platform', 'inngest/app', 'browserbase/project', 'elevenlabs/tts'],
            search:    ['firecrawl/api', 'algolia/application'],
            communications: ['agentmail/api', 'twilio/email'],
            payments:  ['privy/app'],
            cache:     ['upstash/redis'],
            cicd:      ['gitlab/project'],
            observability: ['sentry/project'],
        };
        function pickProviders() {
            // Pick 3 distinct categories at random, then one provider from each
            const categories = Object.keys(providerPool).sort(() => Math.random() - 0.5).slice(0, 3);
            return categories.map(cat => {
                const opts = providerPool[cat];
                return opts[Math.floor(Math.random() * opts.length)];
            });
        }

        // Initial hide
        gsap.set([provBlock, readyBlock, upgrBlock], { autoAlpha: 0 });
        gsap.set('[data-term-line]', { autoAlpha: 0 });
        gsap.set('[data-check-icon]', { autoAlpha: 0 });

        // Blinking select-a-service dot
        const selectDot = upgrBlock ? upgrBlock.querySelector('[data-blink-dot]') : null;
        if (selectDot) {
            const frames = ['○', '●'];
            let di = 0;
            setInterval(() => {
                di = (di + 1) % frames.length;
                selectDot.textContent = frames[di];
                selectDot.style.opacity = di === 1 ? '0.35' : '1';
            }, 600);
        }

        // Adds a check line to the timeline: appear instantly, dot blinks ~1s, swaps to checkmark
        function addCheckLine(tl, line, holdBefore) {
            const dot  = line.querySelector('[data-check-dot]');
            const icon = line.querySelector('[data-check-icon]');
            tl.set(line, { autoAlpha: 1 }, `+=${holdBefore}`);
            if (dot && icon) {
                tl.set(dot,  { autoAlpha: 1, opacity: 1 });
                tl.set(icon, { autoAlpha: 0 });
                tl.to(dot, { opacity: 0.25, duration: 0.25, repeat: 1, yoyo: true, ease: 'none' });
                tl.set(dot,  { autoAlpha: 0 });
                tl.set(icon, { autoAlpha: 1 });
            }
        }

        function erase(tl, text, holdBefore) {
            tl.to({ v: text.length }, {
                v: 0,
                duration: Math.max(0.2, text.length * 0.04),
                ease: 'none',
                snap: { v: 1 },
                onUpdate() { typeEl.textContent = text.substring(0, this.targets()[0].v); }
            }, `+=${holdBefore}`);
        }

        function type(tl, slug) {
            tl.to(typeEl, { text: slug, duration: slug.length * 0.06, ease: 'none' });
        }

        function runSequence() {
            const tl = gsap.timeline({ onComplete: runSequence });

            // Pick 3 random providers for this cycle
            const [p0, p1, p2] = pickProviders();
            const tierItems = upgrBlock ? upgrBlock.querySelectorAll('[data-tier-item]') : [];

            // Reset everything
            tl.set(typeEl, { text: p0 });
            tl.set('[data-term-cursor]', { autoAlpha: 1 });
            tl.set([provBlock, readyBlock, upgrBlock], { autoAlpha: 0 });
            tl.set('[data-term-line]', { autoAlpha: 0 });
            tl.set('[data-check-dot]',  { autoAlpha: 1, opacity: 1 });
            tl.set('[data-check-icon]', { autoAlpha: 0 });
            tl.set('[data-upgrade-type]', { text: '' });
            tl.set('[data-upgrade-cursor]', { autoAlpha: 0 });
            tl.set('[data-select-header]', { autoAlpha: 0 });
            tierItems.forEach(t => tl.set(t, { autoAlpha: 0 }));

            // Cycle provider p0 → p1 → p2
            erase(tl, p0, 1.5);
            type(tl, p1);
            erase(tl, p1, 1.5);
            type(tl, p2);

            // Provisioning block — lines appear instantly, check items blink then resolve
            tl.set(provBlock, { autoAlpha: 1 }, '+=0.6');
            tl.set('[data-term-cursor]', { autoAlpha: 0 });
            const provLines = provBlock.querySelectorAll('[data-term-line]');
            tl.set(provLines[0], { autoAlpha: 1 });
            addCheckLine(tl, provLines[1], 0.5);
            addCheckLine(tl, provLines[2], 0.4);

            // Provider ready block appears immediately after provisioning completes
            tl.set(readyBlock, { autoAlpha: 1 });
            const readyLines = readyBlock.querySelectorAll('[data-term-line]');
            tl.set(readyLines[0], { autoAlpha: 1 });
            tl.set(readyLines[1], { autoAlpha: 1 }, '+=0.1'); tl.set(readyLines[1].querySelector('[data-check-dot]'), { autoAlpha: 0 }); tl.set(readyLines[1].querySelector('[data-check-icon]'), { autoAlpha: 1 });
            tl.set(readyLines[2], { autoAlpha: 1 }, '+=0.1'); tl.set(readyLines[2].querySelector('[data-check-dot]'), { autoAlpha: 0 }); tl.set(readyLines[2].querySelector('[data-check-icon]'), { autoAlpha: 1 });
            tl.set(readyLines[3], { autoAlpha: 1 }, '+=0.1'); tl.set(readyLines[3].querySelector('[data-check-dot]'), { autoAlpha: 0 }); tl.set(readyLines[3].querySelector('[data-check-icon]'), { autoAlpha: 1 });

            // Show upgrade command line with blinking cursor — brief pause, then type full command
            tl.set(upgrBlock, { autoAlpha: 1 });
            tl.set('[data-upgrade-cursor]', { autoAlpha: 1 });

            const upgradeCmd = 'stripe projects upgrade';
            tl.to({}, { duration: 1 });  // cursor blinks once before typing starts
            tl.to('[data-upgrade-type]', { text: upgradeCmd, duration: upgradeCmd.length * 0.055, ease: 'none' });

            // After typing: cursor blinks twice (2 × 1s carat cycle) before submitting
            tl.to({}, { duration: 2 });
            tl.set('[data-upgrade-cursor]', { autoAlpha: 0 });

            // Show "Select a service" header, then cascade tier items in after 0.5s
            tl.set('[data-select-header]', { autoAlpha: 1 });
            tierItems.forEach((t, i) => tl.set(t, { autoAlpha: 1 }, `+=${i === 0 ? 0.5 : 0.15}`));

            // Hold 5s then loop
            tl.to({}, { duration: 5 });
        }

        runSequence();
    }
    terminalSequence();


    // Input gradient follow cursor (supports multiple [data-container-hover-follow] elements)
    function followCursorOnHover() {
        const containers = document.querySelectorAll('[data-container-hover-follow]');
        if (!containers.length) return;

        const ease = 0.12;

        containers.forEach((container) => {
            const follower = container.querySelector('[data-hover-follow]');
            if (!follower) return;

            let currentX = 0;
            let currentY = 0;
            let targetX = 0;
            let targetY = 0;
            let isHovering = false;
            let animationId = null;

            function getFollowerSize() {
                const r = follower.getBoundingClientRect();
                return { width: r.width, height: r.height };
            }

            function updatePosition() {
                const { width: followerWidth, height: followerHeight } = getFollowerSize();
                if (!isHovering && Math.abs(targetX - currentX) < 0.5 && Math.abs(targetY - currentY) < 0.5) {
                    cancelAnimationFrame(animationId);
                    animationId = null;
                    return;
                }
                currentX += (targetX - currentX) * ease;
                currentY += (targetY - currentY) * ease;
                follower.style.transform = `translate(${currentX - followerWidth / 2}px, ${currentY - followerHeight / 2}px)`;
                animationId = requestAnimationFrame(updatePosition);
            }

            container.addEventListener('mouseenter', (e) => {
                isHovering = true;
                const rect = container.getBoundingClientRect();
                targetX = e.clientX - rect.left;
                targetY = e.clientY - rect.top;
                currentX = targetX;
                currentY = targetY;
                const { width: followerWidth, height: followerHeight } = getFollowerSize();
                follower.style.transform = `translate(${currentX - followerWidth / 2}px, ${currentY - followerHeight / 2}px)`;
                follower.style.transition = 'opacity 0.3s ease-out';
                follower.style.opacity = '1';
                if (!animationId) {
                    animationId = requestAnimationFrame(updatePosition);
                }
            });

            container.addEventListener('mousemove', (e) => {
                const rect = container.getBoundingClientRect();
                targetX = e.clientX - rect.left;
                targetY = e.clientY - rect.top;
                if (!animationId) {
                    animationId = requestAnimationFrame(updatePosition);
                }
            });

            container.addEventListener('mouseleave', () => {
                isHovering = false;
                follower.style.transition = 'opacity 0.4s ease-out';
                follower.style.opacity = '0';
            });
        });
    }
    followCursorOnHover();

    // Provider logo click — copy install command + show toast
    (function providerCopy() {
        document.querySelectorAll('[data-provider-slug]').forEach(el => {
            el.addEventListener('click', () => {
                const slug = el.getAttribute('data-provider-slug');
                const name = slug.split('/')[0].replace(/^\w/, c => c.toUpperCase());
                navigator.clipboard.writeText(`stripe projects add ${slug}`).then(() => {
                    showCopyToast(`${name} install command copied`);
                });
            });
        });
    })();

    // Request access modal (request-modal variant) — built entirely in JS to avoid WebC attribute stripping
    (function requestModalSetup() {
        let modal = null;

        window.openRequestModal = function() {
            if (modal) { modal.remove(); modal = null; }

            modal = document.createElement('div');
            modal.style.cssText = 'position:fixed;inset:0;z-index:100;display:flex;align-items:center;justify-content:center;opacity:0;';
            modal.innerHTML = '<style>'
                + '[data-modal-iframe]{height:640px}'
                + '@media(max-width:900px){[data-modal-iframe]{height:680px}}'
                + '@media(max-width:600px){[data-modal-iframe]{height:780px}}'
                + '</style>'
                + '<div data-request-modal-backdrop style="position:absolute;inset:0;background:rgba(6,27,49,0.6);backdrop-filter:blur(4px);"></div>'
                + '<div style="position:relative;width:calc(100% - 2rem);max-width:50rem;max-height:calc(100dvh - 2rem);background:#fff;border-radius:0.75rem;box-shadow:0 25px 50px -12px rgba(0,0,0,0.25);overflow:hidden;">'
                + '<button onclick="closeRequestModal()" style="position:absolute;top:0.75rem;right:0.75rem;z-index:10;display:flex;align-items:center;justify-content:center;width:2rem;height:2rem;border-radius:0.25rem;border:none;background:rgba(255,255,255,0.9);color:#6b7280;cursor:pointer;backdrop-filter:blur(4px);" onmouseover="this.style.color=\'#111\';this.style.background=\'rgba(243,244,246,0.95)\'" onmouseout="this.style.color=\'#6b7280\';this.style.background=\'rgba(255,255,255,0.9)\'">'
                + '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" width="20" height="20"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg>'
                + '</button>'
                + '<iframe data-modal-iframe src="https://go.stripe.global/Stripe-Projects.html" style="width:100%;border:0;display:block;" allow="clipboard-write"></iframe>'
                + '</div>';
            document.body.appendChild(modal);

            modal.querySelector('[data-request-modal-backdrop]').addEventListener('click', closeRequestModal);
            document.body.style.overflow = 'hidden';
            gsap.to(modal, { opacity: 1, duration: 0.25, ease: 'power2.out' });
        };

        window.closeRequestModal = function() {
            if (!modal) return;
            gsap.to(modal, { opacity: 0, duration: 0.2, ease: 'power2.in',
                onComplete: () => { modal.remove(); modal = null; document.body.style.overflow = ''; }
            });
        };

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && modal) closeRequestModal();
        });
    })();

    // Rotating example prompt
    (function promptRotate() {
        const btn = document.querySelector('[data-prompt-rotate]');
        if (!btn) return;

        const prompts = [
            'neon postgres',
            'vercel project',
            'supabase project',
            'clerk auth',
            'upstash redis',
            'cloudflare worker',
            'turso database',
            'sentry project',
            'agentmail api',
            'algolia application',
            'amplitude analytics',
            'auth0 client',
            'browserbase project',
            'chroma database',
            'daytona sandbox',
            'elevenlabs tts',
            'firecrawl api',
            'flyio app',
            'gitlab project',
            'huggingface platform',
            'inngest app',
            'mixpanel analytics',
            'netlify project',
            'openrouter api',
            'planetscale postgresql',
            'posthog analytics',
            'privy app',
            'railway hosting',
            'render static-site',
            'runloop sandbox',
            'twilio email',
            'workos auth',
        ];

        const providerEl = btn.querySelector('[data-prompt-rotate-provider]');
        const defaultEl = btn.querySelector('[data-prompt-rotate-default]');
        const clickedEl = btn.querySelector('[data-prompt-rotate-clicked]');
        let index = 0;

        function getFullPrompt() {
            return 'use Stripe Projects to add ' + prompts[index];
        }

        // Rotate provider text
        function rotate() {
            const next = (index + 1) % prompts.length;
            gsap.to(providerEl, {
                duration: prompts[next].length * 0.04,
                text: prompts[next],
                ease: 'none',
                onComplete: () => { index = next; }
            });
        }

        setInterval(rotate, 3000);

        // Click to copy
        btn.addEventListener('click', () => {
            navigator.clipboard.writeText(getFullPrompt());
            showCopyToast('Prompt copied');
            const tl = gsap.timeline({
                onStart: () => btn.classList.add('pointer-events-none'),
                onComplete: () => btn.classList.remove('pointer-events-none')
            });
            tl
            .to(defaultEl, { y: -24, autoAlpha: 0, scale: 0.75, duration: 0.25, ease: 'power3.inOut' })
            .to(clickedEl, { y: 0, autoAlpha: 1, scale: 1, duration: 0.25, ease: 'power3.inOut' }, 0)
            .to(defaultEl, { y: 0, autoAlpha: 1, scale: 1, duration: 0.25, ease: 'power3.inOut' }, 2)
            .to(clickedEl, { y: 24, autoAlpha: 0, scale: 0.75, duration: 0.25, ease: 'power3.inOut' }, 2);
        });
    })();

</script>