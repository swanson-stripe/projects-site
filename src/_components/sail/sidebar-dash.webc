<div class="absolute top-0 left-0 w-224 h-full text-14/120" webc:root="override">
    <div class="relative w-full h-full flex flex-col">
        <!--- User button -->
        <div class="relative px-8 h-64 py-12">
            <div class="relative h-full w-full px-8 flex justify-between items-center rounded-4 border border-transparent hover:text-primary-hover hover:bg-highlight/50 hover:border-brand-100 has-focus-visible:bg-highlight/70 has-focus-visible:shadow-focus transition-all duration-200 ease-out">
                <div class="relative flex items-center gap-8">
                    <div class="relative w-24 h-24 flex items-center justify-center bg-highlight shadow-inset-border rounded-4">
                        <span class="font-serif text-headline text-center translate-x-0.5">M</span>
                    </div>
                    <div class="font-normal pb-1">
                        Mike Stilling
                    </div>
                </div>
                <div class="relative flex items-center justify-center w-16 h-16 -translate-y-1">
                    <div class="absolute w-6 h-1.75 bg-current translate-y-1.5 -translate-x-1.75 rotate-45 group-has-checked:translate-y-0 group-has-checked:-rotate-45 transition-all duration-250 ease-out"></div>
                    <div class="absolute w-6 h-1.75 bg-current translate-y-1.5 translate-x-1.75 -rotate-45 group-has-checked:translate-y-0 group-has-checked:rotate-45 transition-all duration-250 ease-out"></div>
                </div>
                <input type="checkbox" name="user-button" id="user-button" class="absolute top-0 left-0 w-full h-full cursor-pointer opacity-0">
            </div>
        </div>
        <!--- Divider -->
        <div class="relative px-16 mb-12 mt-0.5">
