                <div class="relative flex gap-8">
                    <a href="https://dashboard.stripe.com/register" class="relative flex items-center justify-center gap-6 h-48 px-20 text-16 font-normal text-neutral-0 bg-primary rounded-4 hover:bg-primary-hover focus-visible:bg-primary-hover focus-visible:shadow-focus transition-all duration-250 cursor-pointer group outline-none">
