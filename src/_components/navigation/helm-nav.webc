        <!--- Dropdowns --->
        <div data-nav-dropdown class="absolute top-52 left-0 w-full px-16 pt-12 pointer-events-none group-has-checked/header:pointer-events-auto">
            <div class="relative w-full bg-highlight/90 backdrop-blur-xl border border-edge rounded-6 shadow-[0_16px_32px_rgba(0,0,0,0.06)] overflow-hidden opacity-0 translate-y-[-5%] scale-90 pointer-events-none
                        group-has-checked/header:opacity-100 group-has-checked/header:translate-y-0 group-has-checked/header:scale-100 group-has-checked/header:block group-has-checked/header:pointer-events-auto
                        --group-has-[#nav-products:checked]/header:h-768
                        --group-has-[#nav-solutions:checked]/header:h-640
                        --group-has-[#nav-developers:checked]/header:h-512
                        --group-has-[#nav-resources:checked]/header:h-384
                        transition-all duration-300 ease-out transition-discrete">
                <div class="absolute top-0 left-0 w-full">
                    <ul class="absolute top-0 left-0 w-full text-14 text-detail">
                        <!--- Products --->
