</header>

<script>

    // Follow mouse on navigation tabs
    function navTabs() {
        const tabgroup = document.querySelectorAll('[data-tab-group]');
        tabgroup.forEach(group => {
            const tab = group.querySelector('[data-nav-tab]');
            const options = group.querySelectorAll('a, button, input');

            // Set initial styles for GPU-accelerated animation
            tab.style.willChange = 'transform, width, height';
            tab.style.transition = 'transform 300ms ease, width 300ms ease, height 300ms ease, opacity 300ms ease';

            function getRelativePosition(option) {
                const groupRect = group.getBoundingClientRect();
                const optionRect = option.getBoundingClientRect();
                return {
                    x: optionRect.left - groupRect.left,
                    y: optionRect.top - groupRect.top,
                    width: optionRect.width,
                    height: optionRect.height
                };
            }

            function set() {
                const pos = getRelativePosition(options[0]);
                tab.style.width = pos.width + 'px';
                tab.style.height = pos.height + 'px';
                tab.style.transform = `translate3d(${pos.x}px, ${pos.y}px, 0)`;
            }
            set();

            function indicate(option) {
                const pos = getRelativePosition(option);
                tab.style.transform = `translate3d(${pos.x}px, ${pos.y}px, 0)`;
                tab.style.width = pos.width + 'px';
                tab.style.height = pos.height + 'px';
            }

            options.forEach(option => {
                option.addEventListener('mouseover', () => { indicate(option); });
                window.addEventListener('resize', () => { set(); });
            });

        });
    }

    // Toggle navigation items
    function toggleNavItems() {
        const navItems = document.querySelectorAll('[data-nav-item]');
        const allRadios = document.querySelectorAll('input[name="nav-item"]');
        const dropdown = document.querySelector('[data-nav-dropdown]');
        const dropdownContents = document.querySelector('[data-nav-dropdown]>div');
        const allDropdownItems = document.querySelectorAll('[data-nav-dropdown-item]');
        let previousDropdown = null;
        let currentDropdown = null;
        const hideTimeouts = new Map(); // element -> timeout ID, so we can cancel stale hides when switching quickly

        function scheduleHide(el, delay, fn) {
            if (hideTimeouts.has(el)) clearTimeout(hideTimeouts.get(el));
            const id = setTimeout(() => {
                hideTimeouts.delete(el);
                fn();
            }, delay);
            hideTimeouts.set(el, id);
        }

        function cancelHide(el) {
            if (hideTimeouts.has(el)) {
                clearTimeout(hideTimeouts.get(el));
                hideTimeouts.delete(el);
            }
        }

        function uncheckAll() {
            allRadios.forEach(r => r.checked = false);
        }
        
        function hideAllDropdownItems() {
            allDropdownItems.forEach(el => {
                cancelHide(el);
                el.style.opacity = '0';
                el.style.visibility = 'hidden';
            });
        }
        
        navItems.forEach((item, index) => {
            const radio = item.querySelector('input[name="nav-item"]');
            const selectedDropdown = document.querySelectorAll('[data-nav-dropdown-item]')[index];
            const dropdownOffset = '264px';

            if (!radio) return;
            
            // Open dropdowns
            const transitionIn = 'all 600ms cubic-bezier(0.33, 1, 0.68, 1)';
            const transitionOut = 'transform 600ms cubic-bezier(0.33, 1, 0.68, 1), opacity 300ms linear';
            const durationOut = 600;
            item.addEventListener('mouseenter', () => {
                radio.checked = true;
                const prevIndex = currentDropdown;
                previousDropdown = currentDropdown;
                currentDropdown = index;

                // Animate out previous dropdown (if any): exit left when we moved right, exit right when we moved left
                if (prevIndex !== null) {
                    const prevDropdown = allDropdownItems[prevIndex];
                    const exitRight = prevIndex > index; // we moved left, so previous exits right
                    prevDropdown.style.transition = transitionOut;
                    prevDropdown.style.transitionBehavior = 'normal'; // override transition-discrete so opacity animates
                    prevDropdown.style.transform = `translate3d(${exitRight ? dropdownOffset : `-${dropdownOffset}`},0,0)`;
                    prevDropdown.style.opacity = '0';
                    scheduleHide(prevDropdown, durationOut, () => {
                        prevDropdown.style.visibility = 'hidden';
                        prevDropdown.style.transition = 'none';
                    });
                }

                dropdownContents.style.height = selectedDropdown.offsetHeight + 'px';
                // New content: enter from right when moving right (or first open), from left when moving left
                cancelHide(selectedDropdown); // don't let a stale hide from rapid switching run
                const enterFromLeft = previousDropdown !== null && index < previousDropdown;
                selectedDropdown.style.visibility = 'visible';
                selectedDropdown.style.opacity = '0';
                selectedDropdown.style.transform = `translate3d(${enterFromLeft ? `-${dropdownOffset}` : dropdownOffset},0,0)`;
                selectedDropdown.style.transition = transitionIn;
                selectedDropdown.style.transitionBehavior = 'normal'; // override transition-discrete so opacity animates
                requestAnimationFrame(() => {
                    requestAnimationFrame(() => {
                        selectedDropdown.style.opacity = '1';
                        selectedDropdown.style.transform = 'translate3d(0,0,0)';
                    });
                });
            });

            // Hide dropdown (or keep it open if moving into the dropdown pane)
            item.addEventListener('mouseleave', (e) => {
                const relatedTarget = e.relatedTarget;

                // Keep dropdown visible when moving into the dropdown pane
                if (relatedTarget && dropdown?.contains(relatedTarget)) { return; }

                // Hide when moving to another nav item or leaving entirely (exit opposite to how we entered)
                radio.checked = false;
                const enteredFromLeft = previousDropdown !== null && index < previousDropdown;
                selectedDropdown.style.transition = transitionOut;
                selectedDropdown.style.transitionBehavior = 'normal'; // override transition-discrete so opacity animates
                selectedDropdown.style.opacity = '0';
                selectedDropdown.style.transform = `translate3d(${enteredFromLeft ? dropdownOffset : `-${dropdownOffset}`},0,0)`; // exit opposite side
                scheduleHide(selectedDropdown, durationOut, () => {
                    selectedDropdown.style.visibility = 'hidden';
                    selectedDropdown.style.transition = 'none';
                });
            });
            
            radio.addEventListener('blur', () => {
                uncheckAll();
            });
        });
        
        // When leaving the dropdown
        if (dropdown) {
            dropdown.addEventListener('mouseleave', (e) => {
                const relatedTarget = e.relatedTarget;
                if (relatedTarget && relatedTarget.closest('[data-nav-item]')) {
                    // Moving to a nav item: hide all panels so the new item's content can show
                    hideAllDropdownItems();
                    return;
                }
                hideAllDropdownItems();
                uncheckAll();
            });
        }
    }

    // once the page is fully loaded run the functions
    document.addEventListener('DOMContentLoaded', () => {
        navTabs();
        toggleNavItems();
    });
    
</script>