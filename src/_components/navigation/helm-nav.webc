<header class="relative flex items-center justify-center px-16 border-b border-neutral-990/10 z-50 group/header" webc:root="override">
    <!--- Background --->
    <div class="fixed top-0 left-0 w-full h-dvh backdrop-blur-sm pointer-events-none bg-linear-to-b from-transparent to-[rgb(236,239,241,0.8)] opacity-0 group-has-checked/header:opacity-100 transition-all duration-300 ease-out transition-discrete"></div>
    <!--- Content --->
    <helm-container class="relative py-12 px-16 flex items-center justify-between">
        <!--- Left --->
        <div class="relative flex items-center h-40 gap-4">
            <!--- Logo --->
            <a href="/" class="relative flex items-center gap-6 h-full border border-transparent px-10 -ml-9 rounded-4 outline-none hover:opacity-60 focus-visible:shadow-focus transition-all duration-250">
                <icon-logo class="h-[1em] w-auto text-headline"></icon-logo>
                <span class="text-16 font-semibold text-headline pb-1">Stripe Projects</span>
            </a>
            <!--- Navigation --->
            <div class="relative h-full">
                <nav data-tab-group class="relative h-full group/nav">
                    <!--- Tab --->
                    <div data-nav-tab class="absolute top-0 left-0 h-full bg-neutral-0/50 backdrop-blur-sm rounded-4 opacity-0 group-hover/nav:opacity-100 shadow-[0px_0px_0_1px_rgb(from_var(--hex-brand-600)_r_g_b/0.2)]"></div>
                    <!--- List --->
                    <ul class="relative h-full flex text-14 font-normal tracking-[0]">
                        <!--- Item --->
                        <li class="relative h-full">
                            <div data-nav-item class="relative h-full flex items-center justify-center gap-6 px-12 pb-2 border border-transparent rounded-4 outline-none has-hover:text-primary-hover has-focus-visible:shadow-focus transition-all duration-250 cursor-pointer group">
                                <label for="nav-products">
                                    Products
                                </label>
                                <div class="relative flex items-center justify-center w-12 h-12">
                                    <div class="absolute w-6 h-1.75 bg-current translate-y-1.5 -translate-x-1.75 rotate-45 group-has-checked:translate-y-0 group-has-checked:-rotate-45 transition-all duration-250 ease-out"></div>
                                    <div class="absolute w-6 h-1.75 bg-current translate-y-1.5 translate-x-1.75 -rotate-45 group-has-checked:translate-y-0 group-has-checked:rotate-45 transition-all duration-250 ease-out"></div>
                                </div>
                                <input type="radio" name="nav-item" value="nav-products" id="nav-products" class="absolute -top-1 left-0 w-full h-40 cursor-pointer opacity-0">
                            </div>
                        </li>
                        <!--- Item --->
                        <li class="relative h-full">
                            <div data-nav-item class="relative h-full flex items-center justify-center gap-6 px-12 pb-2 border border-transparent rounded-4 outline-none has-hover:text-primary-hover has-focus-visible:shadow-focus transition-all duration-250 cursor-pointer group">
                                <label for="nav-solutions">
                                    Solutions
                                </label>
                                <div class="relative flex items-center justify-center w-12 h-12">
                                    <div class="absolute w-6 h-1.75 bg-current translate-y-1.5 -translate-x-1.75 rotate-45 group-has-checked:translate-y-0 group-has-checked:-rotate-45 transition-all duration-250 ease-out"></div>
                                    <div class="absolute w-6 h-1.75 bg-current translate-y-1.5 translate-x-1.75 -rotate-45 group-has-checked:translate-y-0 group-has-checked:rotate-45 transition-all duration-250 ease-out"></div>
                                </div>
                                <input type="radio" name="nav-item" value="nav-solutions" id="nav-solutions" class="absolute -top-1 left-0 w-full h-40 cursor-pointer opacity-0">
                            </div>
                        </li>
                        <!--- Item --->
                        <li class="relative h-full">
                            <div data-nav-item class="relative h-full flex items-center justify-center gap-6 px-12 pb-2 border border-transparent rounded-4 outline-none has-hover:text-primary-hover has-focus-visible:shadow-focus transition-all duration-250 cursor-pointer group">
                                <label for="nav-developers">
                                    Developers
                                </label>
                                <div class="relative flex items-center justify-center w-12 h-12">
                                    <div class="absolute w-6 h-1.75 bg-current translate-y-1.5 -translate-x-1.75 rotate-45 group-has-checked:translate-y-0 group-has-checked:-rotate-45 transition-all duration-250 ease-out"></div>
                                    <div class="absolute w-6 h-1.75 bg-current translate-y-1.5 translate-x-1.75 -rotate-45 group-has-checked:translate-y-0 group-has-checked:rotate-45 transition-all duration-250 ease-out"></div>
                                </div>
                                <input type="radio" name="nav-item" value="nav-developers" id="nav-developers" class="absolute -top-1 left-0 w-full h-40 cursor-pointer opacity-0">
                            </div>
                        </li>
                        <!--- Item --->
                        <li class="relative h-full">
                            <div data-nav-item class="relative h-full flex items-center justify-center gap-6 px-12 pb-2 border border-transparent rounded-4 outline-none has-hover:text-primary-hover has-focus-visible:shadow-focus transition-all duration-250 cursor-pointer group">
                                <label for="nav-resources">
                                    Resources
                                </label>
                                <div class="relative flex items-center justify-center w-12 h-12">
                                    <div class="absolute w-6 h-1.75 bg-current translate-y-1.5 -translate-x-1.75 rotate-45 group-has-checked:translate-y-0 group-has-checked:-rotate-45 transition-all duration-250 ease-out"></div>
                                    <div class="absolute w-6 h-1.75 bg-current translate-y-1.5 translate-x-1.75 -rotate-45 group-has-checked:translate-y-0 group-has-checked:rotate-45 transition-all duration-250 ease-out"></div>
                                </div>
                                <input type="radio" name="nav-item" value="nav-resources" id="nav-resources" class="absolute -top-1 left-0 w-full h-40 cursor-pointer opacity-0">
                            </div>
                        </li>
                        <!--- Item --->
                        <li class="relative h-full">
                            <a data-nav-link class="relative h-full flex items-center justify-center gap-6 px-12 pb-2 border border-transparent rounded-4 outline-none hover:text-primary-hover focus-visible:shadow-focus transition-all duration-250 cursor-pointer group" href="https://stripe.com/pricing">
                                <span>
                                    Pricing
                                </span>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
        <!--- Right --->
        <div class="relative flex items-center gap-8">
            <a href="https://stripe.com/contact/sales" class="relative flex items-center justify-center gap-6 h-40 px-20 text-14 font-normal text-primary bg-neutral-0/65 border border-transparent shadow-border backdrop-blur-sm rounded-4 hover:bg-neutral-0 focus-visible:bg-neutral-0 focus-visible:shadow-focus transition-all duration-250 cursor-pointer group outline-none">
                <span class="pb-2">
                    Sign in
                </span>
            </a>
            <a href="https://stripe.com/contact/sales" class="relative flex items-center justify-center gap-6 h-40 px-20 text-14 font-normal text-neutral-0 bg-primary rounded-4 hover:bg-primary-hover focus-visible:bg-primary-hover focus-visible:shadow-focus transition-all duration-250 cursor-pointer group outline-none">
                <span class="pb-2">
                    Contact Sales
                </span>
                <icon-arrowanimate @size="md" class=""></icon-arrowanimate>
