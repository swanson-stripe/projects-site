<div webc:root="override">
    <div webc:if="size === 'sm'" class="relative w-8 h-8 inline-flex items-center justify-center aspect-square">
        <div class="absolute w-7 h-1.5 -translate-y-0.25 bg-current scale-x-0 -translate-x-3 origin-right group-hover:scale-x-100 group-hover:translate-x-0 transition duration-200 ease-out"></div>
        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 8 8" width="8" height="8" class="w-8 h-8 group-hover:translate-x-3 transition duration-200 ease-out">
            <path d="m1.54 1 3 3-3 3 .48.47.48.48 3.48-3.47.48-.48-.48-.48L2.5.05z"/>
        </svg>
    </div>
    <div webc:elseif="size === 'md'" class="relative w-12 h-12 inline-flex items-center justify-center aspect-square">
        <div class="absolute w-8 h-2 bg-current scale-x-0 -translate-x-3 origin-right group-hover:scale-x-100 group-hover:translate-x-0 transition duration-200 ease-out"></div>
        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 12 12" width="12" height="12" class="w-12 h-12 group-hover:translate-x-3 transition duration-200 ease-out">
            <path d="M3.07 2.62 6.45 6 3.07 9.38l1.24 1.24 4-4L8.93 6l-.62-.62-4-4z"/>
        </svg>
    </div>
    <div webc:elseif="size === 'lg'" class="relative w-16 h-16 inline-flex items-center justify-center aspect-square">
        <div class="absolute w-12 h-2 bg-current scale-x-0 -translate-x-5 origin-right group-hover:scale-x-100 group-hover:translate-x-0 transition duration-200 ease-out"></div>
        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="16" height="16" class="w-16 h-16 group-hover:translate-x-5 transition duration-200 ease-out">
            <path d="M4.18 3.18 9 8l-4.82 4.82 1.41 1.41L11.82 8 5.6 1.77z"/>
        </svg>
    </div>
    <div webc:else class="relative w-12 h-12 inline-flex items-center justify-center aspect-square">
        <div class="absolute w-8 h-2 bg-current scale-x-0 -translate-x-3 origin-right group-hover:scale-x-100 group-hover:translate-x-0 transition duration-200 ease-out"></div>
        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 12 12" width="12" height="12" class="w-12 h-12 group-hover:translate-x-3 transition duration-200 ease-out">
            <path d="M3.07 2.62 6.45 6 3.07 9.38l1.24 1.24 4-4L8.93 6l-.62-.62-4-4z"/>
        </svg>
    </div>
</div>