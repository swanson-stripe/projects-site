<!--
  Athena lockup: the gradient mark, then the "Athena AI" wordmark.

  athenachat.bot publishes only the mark as SVG (assets/athena/athena-logo.svg);
  the wordmark beside it in their nav is live text — Rubik Bold 23px at -0.6px
  tracking in #340083. That text is set as outlines here from the same font, at
  the lockup's own measured geometry, so this is the brand's mark-and-name rather
  than the mark on its own. The mark's three stacked drop-shadow filters are
  dropped: they are a treatment for their page, and every mark in the marquee is
  flat. The viewBox is cropped to the ink, so `h-*` sizes the lockup and not the
  padding around it — at this 8.7 aspect the marquee's 8rem width cap binds first.
-->
<svg xmlns="http://www.w3.org/2000/svg" fill="none" aria-label="Athena AI" viewBox="0 0 145.087 16.56" webc:root="override">
    <defs>
        <!-- userSpaceOnUse, so these coordinates are the mark's own 1000-unit
             space — the space the path's transform establishes, not the viewBox. -->
        <linearGradient id="athena-mark" x1="501.002" y1="423.315" x2="926.585" y2="735.623" gradientUnits="userSpaceOnUse">
            <stop stop-color="#00A699"/>
            <stop offset="0.639643" stop-color="#6A1A9A"/>
        </linearGradient>
    </defs>
