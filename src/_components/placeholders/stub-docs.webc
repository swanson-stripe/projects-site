                    </li>
                </ul>
            </div>
            <div class="relative py-64">
                <div class="text-18 font-normal text-headline text-balance">
                    Developers
                </div>
                <ul class="text-16 text-primary mt-16">
                    <li>
                        <a href="#" class="block py-4 hover:text-primary-hover transition duration-200 ease-out">
                            Set up your development environment
                        </a>
                    </li>
                    <li>
                        <a href="#" class="block py-4 hover:text-primary-hover transition duration-200 ease-out">
                            Build on Stripe with LLMs
                        </a>
                    </li>
                    <li>
                        <a href="#" class="block py-4 hover:text-primary-hover transition duration-200 ease-out">
                            Integration quickstarts
                        </a>
                    </li>
                </ul>
            </div>
        </helm-container>
    </helm-section>
    <helm-section class="overflow-hidden">
        <helm-container class="relative px-16 pt-64 pb-128">
            <div class="absolute top-0 left-16 w-[calc(100%-2rem)] border-t border-edge"></div>
            <div class="text-18 font-normal text-headline text-balance mb-32">
                Try it out
            </div>
            <div class="grid grid-cols-3 gap-16 h-448">
                <div class="border border-edge rounded-6"></div>
                <div class="col-span-2 border border-edge rounded-6 bg-foreground"></div>
            </div>
        </helm-container>
    </helm-section>
</div>