---
layout: "main.webc"
title: "Templates"
seoTitle: "Stripe Projects: Templates"
ogTitle: "Stripe Projects: Templates"
seoDesc: "Browse Stripe Projects templates and inspect every variant, provider, and build command."
ogDesc: "Browse Stripe Projects templates and inspect every variant, provider, and build command."
ogImage: "/assets/images/og/default.jpg"
ogImageAlt: ""
changefreq: "weekly"
wave: true
---

<div class="relative w-full">

    <!--- Header --->
    <header class="relative w-full flex items-center justify-center px-16 z-50 group/header">
        <helm-container class="relative pt-24 pb-0 grid grid-cols-3 items-center">
            <!--- Back button --->
            <div class="relative flex justify-start items-center">
                <a href="/" class="hidden sm:flex items-center justify-end gap-6 text-14 font-normal text-primary hover:text-primary-hover transition-colors duration-200 group">
                    <icon-arrowanimate @size="sm" class="-scale-x-100"></icon-arrowanimate>
                    <span>Home</span>
                </a>
            </div>
            <!--- Logo --->
            <div data-header="logo" class="relative flex items-center justify-center h-40 gap-4">
                <div class="relative flex items-center gap-8 h-full px-10 whitespace-nowrap">
                    <icon-logo class="h-[1em] w-auto text-headline shrink-0"></icon-logo>
                    <span class="text-16 font-normal text-headline">Stripe Projects</span>
                </div>
            </div>
            <!--- Registry repo link --->
            <div class="relative flex justify-end items-center">
                <a href="https://github.com/stripe/projects-template-registry/" class="hidden sm:flex items-center justify-end gap-6 text-14 font-normal text-primary hover:text-primary-hover transition-colors duration-200 group">
                    <span>Registry repo</span>
                    <icon-arrowanimate @size="sm" class=""></icon-arrowanimate>
                </a>
            </div>
        </helm-container>
    </header>

    <main id="main">


        <!--- Headline --->
        <helm-section class="relative">
            <!--- Wave --->
            <div class="absolute -top-64 left-0 w-full h-[calc(100%+18.5rem)]">
                <div
                    data-js-target="nouveau-bloom-wave"
                    class="relative w-full h-full"
                    data-position-x="350"
                    data-position-y="-225"
                    data-position-y-640="-250"
                    data-blur="0"
                    data-camera-zoom="0.85"
                    data-wave-rotation="-75"
                    data-color-offset="0"
                    data-dither-gradient="2"
                    data-dither-scale="3"
                    data-dither-full="true">
                </div>
            </div>
            <!--- Content --->
            <helm-container class="relative pt-72 sm:pt-96">
                <div class="min-[768px]:w-9/12 max-w-832">
                    <h1 class="text-36/110 sm:text-48/110 tracking-tighter text-headline mb-12">
                        Templates
                    </h1>
                    <p class="text-16 sm:text-18/150 text-content mb-20">
                        Browse every starter currently published in the public Stripe Projects template registry. Each template page shows its variants, included services, and the exact <code class="sm:whitespace-nowrap text-headline text-[0.9375em] bg-foreground border border-edge rounded-2 py-2 px-6">stripe projects build</code> command to run.
                    </p>
                    <div class="flex flex-wrap items-center gap-24">
                        <link-btn size="48" color="primary" href="https://github.com/stripe/projects-template-registry">
                            <span slot="label">View public registry</span>
                            <icon-arrowanimate slot="icon-right" @size="md" class=""></icon-arrowanimate>
                        </link-btn>
                    </div>
                </div>
            </helm-container>
        </helm-section>

        <!--- Cards --->
        <helm-section class="relative pt-64">
            <div class="absolute top-232 left-0 w-full h-[calc(100%-14.5rem)] bg-foreground border-y border-edge"></div>
            <helm-container class="relative">
                <ul class="relative grid grid-cols-1 min-[864px]:grid-cols-2 gap-16 pb-72 sm:pb-96">
                    <!--- Loop through templates and create a card for each --->
                    <li webc:for="template of templates.families" class="relative p-24 sm:p-32 flex flex-col bg-highlight border border-edge rounded-6">

                        <!--- Top of card --->
                        <div class="relative flex-1 mb-24">
                            <!--- Owner, tags, and variants --->
                            <div class="flex items-center justify-between mb-24">
                                <!--- Left side --->
                                <div class="flex items-center gap-8">
                                    <!--- If owner logo exists, show it --->
                                    <img webc:if="logoExists(template.owner)"
                                        eleventy:ignore
                                        :src="`/assets/images/provider-logos/logo-${template.owner.split('-')[0].trim()}.svg`" 
                                        :alt="template.owner.split('-')[0].trim().replace(/^\w/, c => c.toUpperCase())"
                                        class="w-auto h-28"/>
                                    <!--- If owner logo doesn't exist, show the owner name --->
                                    <div webc:else class="h-28 flex items-center text-16 font-normal">
                                        <p @text="template.owner.split('-')[0].trim().replace(/^\w/, c => c.toUpperCase())"></p>
                                    </div>
                                    <!--- Category --->
                                    <div webc:if="template.categoryLabel" class="h-24 pb-1 px-6 flex items-center justify-center text-12/100 text-detail border border-headline/15 rounded-4">
                                        <p @text="template.categoryLabel"></p>
                                    </div>
                                    <!--- Framework --->
                                    <div webc:if="template.frameworkLabel" class="h-24 pb-1 px-6 hidden min-[1024px]:flex items-center justify-center text-12/100 text-detail border border-headline/15 rounded-4">
                                        <p @text="template.frameworkLabel"></p>
                                    </div>
                                </div>
                            </div>
                            <!--- Title --->
                            <h2 @text="template.name" class="text-22/110 sm:text-24/110 tracking-tight mb-6 text-pretty"></h2>
                            <!--- Description --->
                            <p @text="template.description" class="text-18/140 text-content text-pretty"></p>
                        </div>

                        <!--- Bottom of card --->
                        <div class="relative shrink-0">
                            <!--- Command --->
                            <div class="flex bg-foreground text-headline rounded-6 border border-edge overflow-hidden mb-8 sm:mb-24">
                                <!--- Text --->
                                <div tabindex="-1" class="w-full pl-16 pr-32 h-48 flex items-center font-mono text-[0.9375rem] whitespace-nowrap overflow-x-scroll no-scrollbar outline-none">
                                    <p @text="template.buildCommand" class="selection:bg-brand-100 selection:text-primary-hover"></p>
                                </div>
                                <!--- Copy --->
                                <div class="shrink-0 relative h-48 p-4 flex aspect-square flex items-center justify-center">
                                    <!--- Fade left --->
                                    <div class="absolute top-0 right-full h-full w-32 bg-gradient-to-l from-foreground to-transparent"></div>
                                    <!--- Button --->
                                    <button :data-command="template.buildCommand" class="relative w-full h-full flex items-center justify-center overflow-hidden bg-primary rounded-4 text-highlight cursor-pointer overflow-hidden hover:bg-primary-hover outline-none focus-visible:shadow-focus-hl transition-all ease-out duration-200">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" class="relative w-16 h-16">
                                            <path d="M13 0a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-1.5v1a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V5.25c0-.97.78-1.75 1.75-1.75a.75.75 0 0 1 0 1.5.25.25 0 0 0-.25.25V14c0 .28.22.5.5.5h6.5a.5.5 0 0 0 .5-.5v-1H6.5a2 2 0 0 1-2-2V2c0-1.1.9-2 2-2zM6.5 1.5A.5.5 0 0 0 6 2v9c0 .28.22.5.5.5H13a.5.5 0 0 0 .5-.5V2a.5.5 0 0 0-.5-.5z"/>
                                        </svg>
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 12 12" class="absolute w-12 h-12 translate-y-20 scale-75 opacity-0 invisible">
                                            <path fill-rule="evenodd" d="M11.7 1.2c.36.3.4.84.1 1.2l-6.65 7.8a.85.85 0 0 1-1.26.04L.24 6.44a.85.85 0 0 1 1.22-1.18l3 3.12L10.5 1.3c.3-.36.84-.4 1.2-.1" clip-rule="evenodd"/>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                            <!--- Services and CTA --->
                            <div class="relative flex items-center justify-between">
                                <!--- Services --->
                                <div class="relative overflow-hidden w-full hidden sm:block">
                                    <ul class="flex items-center justify-start pl-2">
                                        <li webc:for="service of template.services" class="relative -ml-2 shrink-0">
                                            <img webc:if="faviconExists(service.providerSlug)"
                                                eleventy:ignore
                                                :src="`/assets/images/provider-favicons/${service.providerSlug}.svg`"
                                                :alt="service.providerName"
                                                class="w-26 h-26 rounded-full"/>
                                            <div class="absolute top-0 left-0 w-full h-full rounded-full shadow-[inset_0_0_0_1px_rgba(0,0,0,0.1),0_0_0_2px_var(--color-highlight)]"></div>
                                        </li>
                                    </ul>
                                </div>
                                <div class="shrink-0 w-full sm:w-auto">
                                    <link-btn size="48" color="outline" :href="'/templates/' + template.ownerSlug + '/' + template.templateSlug + '/'">
                                        <span slot="label">View template</span>
                                        <icon-arrowanimate slot="icon-right" @size="md" class=""></icon-arrowanimate>
                                    </link-btn>
                                </div>
                            </div>
                        </div>

                    </li>
                </ul>
            </helm-container>
        </helm-section>

    </main>

</div>

<!--- Footer --->
<footer class="relative w-full flex items-center justify-center flex-col px-16">
    <helm-container class="relative flex flex-col sm:flex-row sm:items-center sm:justify-between gap-16 py-24">
        <p class="text-14/150 text-detail" @text="`© ` + base.currentYear() + ` Stripe`"></p>
        <div class="flex flex-col sm:flex-row sm:items-center gap-16 sm:gap-24">
            <a href="/developers/" class="text-14/150 font-normal text-primary hover:text-primary-hover transition-colors duration-250 outline-none">Developers</a>
            <a href="https://stripe.com/privacy" class="text-14/150 font-normal text-primary hover:text-primary-hover transition-colors duration-250 outline-none">Privacy &amp; Terms</a>
            <a href="https://stripe.com" class="text-14/150 font-normal text-primary hover:text-primary-hover transition-colors duration-250 outline-none">Go to Stripe</a>
        </div>
    </helm-container>
</footer>


<script>

    function copyCommand() {
        const copyButtons = document.querySelectorAll('[data-command]');
        copyButtons.forEach(button => {
            button.addEventListener('click', () => {
                const command = button.dataset.command;
                if (!command) return;
                navigator.clipboard.writeText(command);
                const svgs = button.querySelectorAll('svg');
                const copyIcon = svgs[0];
                const checkIcon = svgs[1];
                const tl = gsap.timeline();
                tl
                .to(copyIcon, {y: -20, autoAlpha: 0, scale: 0.75, duration: 0.2, ease: 'power3.out'})
                .to(checkIcon, {y: 0, autoAlpha: 1, scale: 1, duration: 0.2, ease: 'power3.out'}, 0)
                .to(checkIcon, {y: 20, autoAlpha: 0, scale: 0.75, duration: 0.2, ease: 'power3.out'}, 0.75)
                .to(copyIcon, {y: 0, autoAlpha: 1, scale: 1, duration: 0.2, ease: 'power3.out'}, 0.75);
            });
        });
    }

    copyCommand();

</script>