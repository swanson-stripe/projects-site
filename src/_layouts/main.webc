<!DOCTYPE html>
<html lang="en" color-scheme="dark">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="canonical" :href="this.canonicalUrl || (base.siteOrigin + this.page.url)"/>

    <!--- Search + Tab --->
    <title @html="this.seoTitle"></title>
    <meta name="description" :content="this.seoDesc">
    <!--- Only pages that opt in, so the 404 stays out of the index. --->
    <meta webc:if="this.robots" name="robots" :content="this.robots">

    <!--- OpenGraph --->
    <!--- siteName lets the unbranded marketplace pages name themselves. --->
    <meta property="og:site_name" :content="this.siteName || base.name" />
    <meta property="og:type" content="website" />
    <meta property="og:title" :content="this.ogTitle" />
    <meta property="og:description" :content="this.ogDesc" />
    <meta property="og:url" :content="this.ogUrl || (base.siteOrigin + this.page.url)" />
    <!--- No ogImage means no card: better than a branded card on a page that
          carries none of that branding. --->
    <meta webc:if="this.ogImage" property="og:image" :content="base.siteOrigin + this.ogImage" />
    <meta webc:if="this.ogImage" property="og:image:width" content="1024" />
    <meta webc:if="this.ogImage" property="og:image:height" content="535" />
    <meta webc:if="this.ogImage" property="og:image:alt" :content="this.ogImageAlt" />

    <!--- Twitter --->
    <meta name="twitter:card" content="summary_large_image" />
    <meta webc:if="this.twitterSite !== false" name="twitter:site" content="@stripe" />
    <meta name="twitter:title" :content="this.ogTitle" />
    <meta name="twitter:description" :content="this.ogDesc" />
    <meta webc:if="this.twitterImage || this.ogImage" name="twitter:image" :content="base.siteOrigin + (this.twitterImage || this.ogImage)" />


    <!--- Load fonts --->
    <link rel="preload" href="/assets/fonts/Sohne.woff2" as="font" type="font/woff2" crossorigin>
    <!--- Font families --->
    <style>
        @font-face {
            font-family: "Sohne";
            src: url("/assets/fonts/Sohne.woff2") format("woff2-variations");
            font-weight: 1 1000;
            font-display: block;
        }
        body {
            font-family: "Sohne", "ui-sans-serif", "system-ui", "sans-serif", "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
            -webkit-font-smoothing: antialiased;
        }
    </style>

    <!--- Styles --->
    <link rel="stylesheet" href="/assets/css/main.css" webc:keep/>
    <link webc:if="markdown" rel="stylesheet" href="/assets/css/markdown.css" webc:keep/>
    <style @raw="getBundle('css')" webc:keep></style>

    <!--- Icons --->
    <link rel="icon" type="image/svg+xml" href="/assets/images/favicon/favicon.svg" />

    <!--- JSON-LD identity. Opt in with `structuredData: "software-application"` in
          front matter so the unbranded marketplace pages never claim to be
          Stripe Projects. --->
    <script webc:if="this.structuredData === 'software-application'" type="application/ld+json" webc:keep @raw='JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "@id": base.siteOrigin + "/#software",
        name: base.name,
        alternateName: "Stripe Projects CLI",
        applicationCategory: "DeveloperApplication",
        applicationSubCategory: "Command Line Tool",
        operatingSystem: "macOS, Linux, Windows",
        url: base.siteOrigin + "/",
        description: this.seoDesc,
        softwareHelp: "https://docs.stripe.com/projects",
        downloadUrl: "https://docs.stripe.com/stripe-cli/install",
        installUrl: "https://docs.stripe.com/stripe-cli/install",
        softwareRequirements: "Stripe CLI",
        publisher: {
            "@type": "Organization",
            name: "Stripe",
            url: "https://stripe.com",
            sameAs: [
                "https://github.com/stripe",
                "https://en.wikipedia.org/wiki/Stripe,_Inc."
            ]
        }
    })'></script>

    <!--- Plausible --->
    <script webc:if="base.env !== 'local'" webc:keep async src="https://plausible.io/js/pa-tq9B_F5RcJtNJMu8LenIq.js"></script>
    <script webc:if="base.env !== 'local'" webc:keep>window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}}; plausible.init();</script>

    <!--- Vercel Speed Insights --->
    <script webc:if="base.env !== 'local'" webc:keep defer src="https://cdn.vercel-insights.com/v1/script.js"></script>

    <!--- Vercel Web Analytics --->
    <script webc:if="base.env !== 'local'" webc:keep>
        window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
    </script>
    <script webc:if="base.env !== 'local'" webc:keep defer src="/_vercel/insights/script.js"></script>
</head>

<body class="text-headline bg-highlight font-sans font-light antialiased">
    <div>
        <!--- Content --->
        <div @html="this.content">
        </div>
    </div>
    <script webc:keep src="/assets/js/gsap.min.js"></script>
    <script webc:keep src="/assets/js/Draggable.min.js"></script>
    <script webc:keep src="/assets/js/InertiaPlugin.min.js"></script>
    <script webc:keep src="/assets/js/ScrollTrigger.min.js"></script>
    <script webc:keep src="/assets/js/ScrollToPlugin.min.js"></script>
    <script webc:keep src="/assets/js/SplitText.min.js"></script>
    <script webc:keep src="/assets/js/TextPlugin.min.js"></script>
    <script @raw="getBundle('js')" webc:keep>gsap.registerPlugin(ScrollTrigger,ScrollToPlugin,TextPlugin,SplitText,Draggable,InertiaPlugin,);</script>
    <script webc:if="wave !== false" type="module" webc:keep src="/assets/js/NouveauBloomWave/NouveauBloomWave.js"></script>
    <script webc:if="binaryCanvas" type="module" webc:keep src="/assets/js/BinaryFadeCanvas/BinaryFadeCanvas.js"></script>
</body>
</html>
