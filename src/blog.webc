---
layout: "main.webc"
title: "Blog"
seoTitle: "Blog | Stripe Projects"
ogTitle: "Blog | Stripe Projects"
seoDesc: "Articles about building with Stripe Projects — from provisioning to deployment."
ogDesc: "Articles about building with Stripe Projects — from provisioning to deployment."
ogImage: "/assets/images/og/og.jpg"
ogImageAlt: ""
wave: false
changefreq: "weekly"
---

<div class="relative w-full">

    <!--- Header --->
    <header class="relative w-full flex items-center justify-center px-16 z-50">
        <helm-container class="relative pt-24 pb-0 grid grid-cols-3 items-center">
            <a href="/" class="flex items-center gap-6 text-14 font-normal text-primary hover:text-primary-hover transition-colors duration-200 group">
                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" class="w-14 h-14 rotate-180"><path fill-rule="evenodd" d="M5.47 3.47a.75.75 0 0 1 1.06 0l4 4a.75.75 0 0 1 0 1.06l-4 4a.75.75 0 1 1-1.06-1.06L8.94 8 5.47 4.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/></svg>
                <span>Home</span>
            </a>
            <div class="relative flex items-center justify-center h-40 gap-4">
                <a href="/" class="relative flex items-center gap-8 h-full px-10 whitespace-nowrap">
                    <icon-logo class="h-[1em] w-auto text-headline shrink-0"></icon-logo>
                    <span class="text-16 font-normal text-headline">Stripe Projects</span>
                </a>
            </div>
            <div></div>
        </helm-container>
    </header>

    <!--- Blog listing --->
    <main id="main">
        <helm-section class="relative z-20">
            <helm-container class="relative flex flex-col items-start pt-64 pb-96 max-w-768 mx-auto">
                <h1 class="text-32/110 sm:text-40/110 tracking-[-0.02em] text-headline mb-48">Blog</h1>
                <div class="w-full flex flex-col gap-32">
                    <template webc:type="11ty" 11ty:type="liquid">
                        {% assign posts = collections.blog %}
                        {% for post in posts %}
                        <a href="/blog/{{ post.data.slug }}/" class="group relative flex flex-col gap-8 p-24 -mx-24 rounded-8 hover:bg-foreground transition-colors duration-200">
                            <span class="text-14 text-detail">{{ post.data.postDate }}</span>
                            <h2 class="text-20/130 sm:text-24/130 tracking-[-0.01em] text-headline group-hover:text-primary transition-colors duration-200">{{ post.data.title }}</h2>
                            <p class="text-16/150 text-content">{{ post.data.description }}</p>
                            <span class="text-14 text-detail">By {{ post.data.author }}</span>
                        </a>
                        {% endfor %}
                    </template>
                </div>
            </helm-container>
        </helm-section>
    </main>

    <!--- Footer --->
    <footer class="w-full flex items-center justify-center flex-col px-16">
        <helm-container class="relative flex flex-col sm:flex-row sm:items-center sm:justify-between gap-16 py-24 border-t border-edge">
            <p class="text-14/150 text-detail" @text="`© ` + base.currentYear() + ` Stripe`"></p>
            <div class="flex flex-col sm:flex-row sm:items-center gap-16 sm:gap-24">
                <a href="/developers/" class="text-14/150 font-normal text-primary hover:text-primary-hover transition-colors duration-250 outline-none">Developers</a>
                <a href="https://stripe.com/privacy" class="text-14/150 font-normal text-primary hover:text-primary-hover transition-colors duration-250 outline-none">Privacy &amp; Terms</a>
                <a href="https://stripe.com" class="text-14/150 font-normal text-primary hover:text-primary-hover transition-colors duration-250 outline-none">Go to Stripe</a>
            </div>
        </helm-container>
    </footer>

</div>
