---
layout: "main.webc"
title: "Stack Share"
seoTitle: "Stack Share | Stripe Projects"
ogTitle: "Stack Share | Stripe Projects"
seoDesc: "View and clone a shared Stripe Projects stack."
ogDesc: "View and clone a shared Stripe Projects stack."
ogImage: "/assets/images/og/og.jpg"
ogImageAlt: "Stripe Projects — Stack Share"
changefreq: "weekly"
wave: false
binaryCanvas: false
---

<!--- Header --->
<header class="absolute top-0 left-0 w-full flex items-center justify-center px-16 z-50 group/header">
    <helm-container class="relative pt-24 pb-0 flex justify-center items-center">
        <a href="/" class="relative flex items-center justify-center h-40 gap-4">
            <div class="relative flex items-center gap-8 h-full px-10 whitespace-nowrap">
                <icon-logo class="h-[1em] w-auto text-headline shrink-0"></icon-logo>
                <span class="text-16 font-normal text-headline">Stripe Projects</span>
            </div>
        </a>
    </helm-container>
</header>

<main>

    <helm-section class="relative">
        <!--- Wave --->
        <div class="absolute inset-0 pointer-events-none opacity-0 transition-opacity duration-700 ease-out" data-wave-fade>
            <div
                data-js-target="nouveau-bloom-wave"
                data-position-x="200"
                data-position-y="-250"
                data-blur="0"
                data-camera-zoom="1.5"
                data-wave-rotation="0"
                data-color-offset="0"
                data-dither-gradient="2"
                data-dither-scale="3"
                data-dither-full="true"
                class="relative w-full h-full -scale-y-100">
            </div>
        </div>
        <!--- Content --->
        <helm-container class="relative min-h-476 h-dvh flex items-start sm:items-center justify-center py-96">
            <!--- Modal --->
            <div class="relative w-full max-w-540 rounded-12 bg-highlight shadow-hds-xl overflow-hidden">
                <div data-modal-scroll class="relative w-full min-h-252 sm:min-h-284 max-h-[calc(100dvh-7rem)] sm:max-h-[calc(100dvh-12rem)] overflow-y-auto">
                    <!--- Modal contents --->
                    <div data-modal-content class="px-24 sm:px-64 pt-32 sm:pt-48 pb-24 sm:pb-64">
                        <!--- Modal title --->
                        <div class="relative mb-24">
                            <h1 class="text-22/110 tracking-tight mb-8">
                                Stack Share
                            </h1>
                            <p class="text-16/140 text-content text-pretty sm:text-balance">
                                Copy the command or agent prompt below to use this <a href="https://docs.stripe.com/projects#set-up-from-shared-stack" class="underline underline-offset-4 decoration-1 decoration-neutral-300 hover:decoration-neutral-600 hover:text-headline transition-all duration-200 outline-none focus-visible:shadow-focus focus-visible:outline-brand-300 focus-visible:text-primary focus-visible:no-underline rounded-2">Stripe Projects stack</a> in your own project.
                            </p>
                        </div>
                        <!--- Providers table --->
                        <ul data-provider-list class="relative w-full flex flex-col border border-edge overflow-hidden rounded-6 min-h-70">
                            <!--- Loading state --->
                            <li data-provider-loading class="absolute top-0 left-0 w-full h-70 flex items-center gap-12 sm:gap-16 px-16 border-b border-edge border-dashed -mb-1">
                                <!--- Icon --->
                                <div class="relative w-36 h-36 flex items-center justify-center bg-foreground rounded-4 overflow-hidden shrink-0 border border-edge">
                                    <div class="relative p-1 bg-conic from-headline/0 to-headline w-16 h-16 rounded-full animate-spin">
                                        <div class="w-full h-full bg-foreground rounded-full"></div>
                                    </div>
                                </div>
                                <!--- Name + description --->
                                <div class="w-full">
                                    <h2 class="text-16/110 pb-1 shimmer text-detail">
                                        Loading stack...
                                    </h2>
                                </div>
                            </li>
                            <!--- Provider list --->
                            <li data-provider :data-provider-slug="provider.slug" webc:for="provider of [...providers].sort((a, b) => a.name.localeCompare(b.name))" class="relative h-70 shrink-0 flex items-center gap-12 sm:gap-16 px-16 border-b border-edge border-dashed -mb-1 hidden opacity-0 invisible">
                                <!--- Icon --->
                                <div class="relative w-36 h-36 flex items-center justify-center bg-foreground rounded-4 overflow-hidden shrink-0">
                                    <img eleventy:ignore :src="`/assets/images/provider-icons/${provider.logoTag.replace('logo-', '')}.svg`" :alt="provider.name" loading="lazy" class="w-full h-full object-cover" />
                                    <div class="absolute top-0 left-0 w-full h-full shadow-[inset_0_0_0_1px_rgba(0,0,0,0.08)] rounded-4"></div>
                                </div>
                                <!--- Name + description --->
                                <div class="min-w-0 w-full">
                                    <h2 @text="provider.name" class="text-16/100 font-normal mb-4"></h2>
                                    <p @text="provider.description" class="text-content text-14/120 truncate"></p>
                                </div>
                            </li>
                            <!--- Empty state --->
                            <li data-provider-empty class="relative w-full h-70 shrink-0 flex items-center gap-12 sm:gap-16 px-16 border-b border-transparent border-dashed -mb-1 hidden opacity-0 invisible">
                                <!--- Icon --->
                                <div class="relative w-36 h-36 flex items-center justify-center bg-foreground rounded-4 overflow-hidden shrink-0 border border-edge">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" class="w-16 h-16 texty-detail">
                                        <path d="M5.58 1.85a2.75 2.75 0 0 1 4.84 0l5.24 9.65q.34.62.34 1.32l-.01.29a2.8 2.8 0 0 1-2.47 2.46l-.29.02H2.77l-.29-.02a2.8 2.8 0 0 1-2.47-2.46L0 12.82q0-.61.26-1.16l.08-.16zm3.52.71a1.25 1.25 0 0 0-2.2 0l-5.25 9.66a1.27 1.27 0 0 0 1.12 1.87h10.46a1.27 1.27 0 0 0 1.12-1.87zm-1.13 7.97a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5m.5-.64H7.44l-.52-4.86H9z"/>
                                    </svg>
                                </div>
                                <!--- Name + description --->
                                <div class="w-full">
                                    <h2 class="text-16/100 font-normal mb-4">
                                        No stack was found
                                    </h2>
                                    <p class="text-content text-14/120 truncate">
                                        Please check the URL and try again.
                                    </p>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <!--- Modal CTAs --->
                <div data-modal-ctas class="absolute bottom-0 left-0 w-full translate-y-121 sm:translate-y-81">
                    <!--- Fader --->
                    <div class="absolute bottom-full left-0 w-full h-32 bg-linear-to-b from-highlight/0 to-highlight"></div>
                    <!--- CTAs --->
                    <div class="relative w-full py-16 grid sm:grid-cols-2 gap-8 px-24 sm:px-16 border-t border-edge bg-highlight">
                        <!--- ClI -->
                        <button data-copy-cli data-container-hover-follow class="relative overflow-hidden h-40 sm:h-48 p-1 font-normal text-14/100 sm:text-16/100 text-primary bg-brand-100 rounded-4 cursor-pointer group outline-none hover:bg-brand-200 hover:text-brand-800 focus-visible:bg-brand-300 focus-visible:text-brand-800 focus-visible:shadow-focus transition duration-200 ease-out">
                            <!-- Gradient hover follow -->
                            <div class="absolute top-0 left-0 w-full h-full rounded-4 opacity-0 group-hover:opacity-100 group-focus-visible:opacity-0 transition-all duration-200 ease-out">
                                <div data-hover-follow class="absolute w-128 h-128 bg-radial/shorter from-primary/80 via-ruby-400/50 to-ruby-400/0 from-30% to-66% origin-center"></div>
                            </div>
                            <!--- Icon + label -->
                            <div class="relative h-full flex items-center justify-center bg-highlight rounded-3">
                                <!--- Normal state --->
                                <div class="relative flex items-center justify-center gap-8">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" class="w-16 h-16 mb-1 -ml-2">
                                        <path fill-rule="evenodd" d="M13 2.5H3c-.83 0-1.5.67-1.5 1.5v8c0 .83.67 1.5 1.5 1.5h10c.83 0 1.5-.67 1.5-1.5V4c0-.83-.67-1.5-1.5-1.5M3 1a3 3 0 0 0-3 3v8a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V4a3 3 0 0 0-3-3z" clip-rule="evenodd"/>
                                        <path fill-rule="evenodd" d="M3.43 4.51a.75.75 0 0 1 1.06-.08l3.5 3a.75.75 0 0 1 0 1.14l-3.5 3a.75.75 0 1 1-.98-1.14L6.35 8 3.5 5.57a.75.75 0 0 1-.08-1.06M8 10.75c0-.41.34-.75.75-.75h3.5a.75.75 0 0 1 0 1.5h-3.5a.75.75 0 0 1-.75-.75" clip-rule="evenodd"/>
                                    </svg>
                                    <span class="pb-1 sm:pb-2">Copy CLI command</span>
                                </div>
                                <!--- Clicked state --->
                                <div class="absolute flex items-center justify-center gap-8 translate-y-32">
                                    <icon-check size="16" weight="strong"></icon-check>
                                    <span class="pb-1 sm:pb-2">Copied</span>
                                </div>
                            </div>
                        </button>
                        <!--- Agent --->
                        <button data-copy-prompt data-container-hover-follow class="relative overflow-hidden h-40 sm:h-48 p-1 font-normal text-14/100 sm:text-16/100 text-primary bg-brand-100 rounded-4 cursor-pointer group outline-none hover:bg-brand-200 hover:text-brand-800 focus-visible:bg-brand-300 focus-visible:text-brand-800 focus-visible:shadow-focus transition duration-200 ease-out">
                            <!-- Gradient hover follow -->
                            <div class="absolute top-0 left-0 w-full h-full rounded-4 opacity-0 group-hover:opacity-100 group-focus-visible:opacity-0 transition-all duration-200 ease-out">
                                <div data-hover-follow class="absolute w-128 h-128 bg-radial/shorter from-primary/80 via-ruby-400/50 to-ruby-400/0 from-30% to-66% origin-center"></div>
                            </div>
                            <!--- Icon + label -->
                            <div class="relative h-full flex items-center justify-center gap-8 bg-highlight rounded-3">
                                <!--- Normal state --->
                                <div class="relative flex items-center justify-center gap-8">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" class="w-16 h-16 mb-1 -ml-2">
                                        <path d="M11.47 2.62a.3.3 0 0 0 .15-.15l.64-1.8A.3.3 0 0 1 12.5.5q.16 0 .24.17l.64 1.8q.04.11.15.15l1.8.64q.17.08.17.24 0 .17-.16.24l-1.81.64a.3.3 0 0 0-.15.15l-.64 1.8a.3.3 0 0 1-.24.17q-.16 0-.24-.17l-.64-1.8a.3.3 0 0 0-.15-.15l-1.8-.64a.3.3 0 0 1-.17-.24q0-.17.17-.24z"/>
                                        <path fill-rule="evenodd" d="m7 5.5-.56 1.57a2.3 2.3 0 0 1-1.37 1.37L3.5 9l1.58.56c.64.23 1.14.73 1.37 1.37L7 12.5l.56-1.58c.23-.64.73-1.14 1.37-1.37L10.5 9l-1.58-.56a2.3 2.3 0 0 1-1.37-1.37zM7.7 3a.7.7 0 0 0-.7-.5c-.3 0-.59.16-.7.5L5.02 6.57a.8.8 0 0 1-.46.46L1 8.29A.74.74 0 0 0 .5 9c0 .3.16.59.5.7l3.57 1.27q.33.13.46.46L6.29 15c.12.34.42.5.71.5.3 0 .59-.16.7-.5l1.27-3.57a.8.8 0 0 1 .46-.46L13 9.71c.34-.12.5-.42.5-.71 0-.3-.16-.59-.5-.7L9.43 7.02a.8.8 0 0 1-.46-.46z" clip-rule="evenodd"/>
                                    </svg>
                                    <span class="pb-1 sm:pb-2">Copy agent prompt</span>
                                </div>
                                <!--- Clicked state --->
                                <div class="absolute flex items-center justify-center gap-6 translate-y-32">
                                    <icon-check size="16" weight="strong"></icon-check>
                                    <span class="pb-1 sm:pb-2">Copied</span>
                                </div>
                            </div>
                        </button>
                    </div>
                </div>
            </div>
        </helm-container>
    </helm-section>

</main>

<!--- Footer --->
<footer class="w-full flex items-center justify-center flex-col px-16 border-t border-edge">
    <helm-container class="relative flex flex-col sm:flex-row sm:items-center sm:justify-between gap-16 py-24">
        <p class="text-14/150 text-detail" @text="`© ` + base.currentYear() + ` Stripe`"></p>
        <div class="flex flex-col sm:flex-row sm:items-center gap-16 sm:gap-24">
            <a href="https://stripe.com/privacy" class="text-14/150 font-normal text-primary hover:text-primary-hover transition-colors duration-250 outline-none">Privacy &amp; Terms</a>
            <a href="https://stripe.com" class="text-14/150 font-normal text-primary hover:text-primary-hover transition-colors duration-250 outline-none">Go to Stripe</a>
        </div>
    </helm-container>
</footer>

<script>

    // Provider list — parse URL hash and reveal matched providers or empty state
    function providerListReveal() {
        const LOADING_MIN_MS = 1000;
        const ITEM_DURATION = 0.35;
        const ITEM_STAGGER = 0.06;

        const listEl = document.querySelector('[data-provider-list]');
        const loadingEl = document.querySelector('[data-provider-loading]');
        const emptyEl = document.querySelector('[data-provider-empty]');
        const scrollParent = document.querySelector('[data-modal-scroll]');
        const contentWrap = document.querySelector('[data-modal-content]');
        const allProviderEls = [...document.querySelectorAll('[data-provider]')];
        const ctaBar = document.querySelector('[data-modal-ctas]');

        if (!listEl || !loadingEl || !emptyEl) return;

        const providerByKey = new Map();
        allProviderEls.forEach((el) => {
            const key = el.dataset.providerSlug.split('/')[0];
            providerByKey.set(key, el);
        });

        function decodeHash() {
            const hash = window.location.hash.slice(1);
            if (!hash) return null;
            const colonIdx = hash.indexOf(':');
            if (colonIdx <= 0) return null;
            const version = hash.slice(0, colonIdx);
            if (version !== 'v1') return null;
            const payload = hash.slice(colonIdx + 1);
            if (!payload) return null;

            const services = [];
            for (const part of payload.split(',')) {
                const tildeIdx = part.indexOf('~');
                if (tildeIdx <= 0) continue;
                let provider;
                let service;
                try {
                    provider = decodeURIComponent(part.slice(0, tildeIdx)).toLowerCase();
                    service = decodeURIComponent(part.slice(tildeIdx + 1));
                } catch (e) {
                    continue;
                }
                if (!providerByKey.has(provider)) continue;
                services.push({ provider, service });
            }
            return services.length > 0 ? services : null;
        }

        function getMatchedProviders(services) {
            const matchedKeys = new Set(services.map(({ provider }) => provider));
            return allProviderEls.filter((el) => {
                const key = el.dataset.providerSlug.split('/')[0];
                return matchedKeys.has(key);
            });
        }

        function measureListHeight(els) {
            els.forEach((el) => {
                el.classList.remove('hidden', 'invisible', 'opacity-0');
                el.style.visibility = 'hidden';
            });
            const height = listEl.offsetHeight;
            els.forEach((el) => {
                el.classList.add('hidden', 'invisible', 'opacity-0');
                el.style.visibility = '';
            });
            return height;
        }

        function staggerDuration(count) {
            if (count <= 1) return ITEM_DURATION;
            return ITEM_DURATION + (count - 1) * ITEM_STAGGER;
        }

        function prepareVisibleEl(el) {
            el.classList.remove('hidden', 'invisible', 'opacity-0');
            gsap.set(el, { autoAlpha: 0, y: 70 });
        }

        function resetListHeight() {
            gsap.set(listEl, { clearProps: 'height,overflow' });
        }

        function reveal() {
            gsap.killTweensOf([listEl, loadingEl, emptyEl, ctaBar, contentWrap, ...allProviderEls]);

            const services = decodeHash();
            const matchedProviders = services ? getMatchedProviders(services) : [];
            const startHeight = listEl.offsetHeight;

            gsap.set(loadingEl, { autoAlpha: 1, y: 0, display: 'flex' });
            gsap.set(emptyEl, { autoAlpha: 0, y: 70 });
            if (ctaBar) gsap.set(ctaBar, { autoAlpha: 0, y: 81 });
            resetListHeight();
            allProviderEls.forEach((el) => {
                el.classList.add('hidden', 'invisible', 'opacity-0');
                gsap.set(el, { clearProps: 'opacity,visibility,transform' });
            });
            emptyEl.classList.add('hidden', 'invisible', 'opacity-0');

            const tl = gsap.timeline({
                onComplete: () => {
                    loadingEl.style.display = 'none';
                    resetListHeight();
                },
            });

            tl.to({}, { duration: LOADING_MIN_MS / 1000 });
            tl.to(loadingEl, { autoAlpha: 0, y: -70, duration: 0.3, ease: 'power2.in' });

            if (matchedProviders.length > 0) {
                const targetHeight = measureListHeight(matchedProviders);
                const heightDuration = staggerDuration(matchedProviders.length);

                let clampedHeight = targetHeight;
                if (scrollParent && contentWrap) {
                    const maxH = parseFloat(getComputedStyle(scrollParent).maxHeight);
                    if (maxH > 0 && !isNaN(maxH)) {
                        const listTop = listEl.offsetTop - contentWrap.offsetTop;
                        const availableHeight = maxH - listTop;
                        if (availableHeight > 0) {
                            clampedHeight = Math.min(targetHeight, availableHeight);
                        }
                    }
                }

                gsap.set(listEl, { height: startHeight, overflow: 'hidden' });
                matchedProviders.forEach(prepareVisibleEl);

                tl.to(listEl, {
                    height: clampedHeight,
                    duration: heightDuration,
                    ease: 'power2.out',
                }, '-=0.1');
                tl.to(matchedProviders, {
                    autoAlpha: 1,
                    y: 0,
                    duration: ITEM_DURATION,
                    stagger: ITEM_STAGGER,
                    ease: 'power2.out',
                }, '<');
                if (ctaBar) {
                    tl.fromTo(ctaBar,
                        { autoAlpha: 0, y: 81 },
                        { autoAlpha: 1, y: 0, duration: 0.4, ease: 'power2.out' },
                        '<+=0.15'
                    );
                }
                if (contentWrap) {
                    tl.to(contentWrap,
                        { paddingBottom: '8rem', duration: 0.4, ease: 'power2.out' },
                        '<'
                    );
                }
            } else {
                emptyEl.classList.remove('hidden', 'invisible', 'opacity-0');
                tl.fromTo(emptyEl,
                    { autoAlpha: 0, y: 70 },
                    { autoAlpha: 1, y: 0, duration: ITEM_DURATION, ease: 'power2.out' },
                    '-=0.1'
                );
            }
        }

        gsap.set(loadingEl, { autoAlpha: 1, y: 0 });
        gsap.set(emptyEl, { autoAlpha: 0, y: 70 });
        reveal();
    };
    providerListReveal();

    // Copy buttons — CLI and agent prompt
    function copyButtons() {
        const cliBtn = document.querySelector('[data-copy-cli]');
        const promptBtn = document.querySelector('[data-copy-prompt]');
        if (!cliBtn || !promptBtn) return;

        function getStackUrl() {
            return window.location.origin + '/s' + window.location.hash;
        }

        function animateCopyButton(button, text) {
            const wrapper = button.querySelector(':scope > div:last-child');
            if (!wrapper) return;
            const normalState = wrapper.children[0];
            const clickedState = wrapper.children[1];
            if (!normalState || !clickedState) return;

            navigator.clipboard.writeText(text);
            button.style.pointerEvents = 'none';

            const tl = gsap.timeline({
                onComplete: () => {
                    button.style.pointerEvents = '';
                },
            });

            tl.to(normalState, { autoAlpha: 0, y: -32, duration: 0.2, ease: 'power2.in' });
            tl.to(clickedState, { autoAlpha: 1, y: 0, duration: 0.2, ease: 'power2.out' }, '-=0.1');
            tl.to(clickedState, { autoAlpha: 0, y: 32, duration: 0.2, ease: 'power2.in', delay: 0.5 });
            tl.to(normalState, { autoAlpha: 1, y: 0, duration: 0.2, ease: 'power2.out' }, '-=0.1');
        }

        [cliBtn, promptBtn].forEach((btn) => {
            const wrapper = btn.querySelector(':scope > div:last-child');
            if (!wrapper) return;
            const normalState = wrapper.children[0];
            const clickedState = wrapper.children[1];
            if (!normalState || !clickedState) return;
            gsap.set(normalState, { autoAlpha: 1, y: 0 });
            gsap.set(clickedState, { autoAlpha: 0, y: 32 });
        });

        cliBtn.addEventListener('click', () => {
            const cmd = `stripe projects init --from ${getStackUrl()}`;
            animateCopyButton(cliBtn, cmd);
        });

        promptBtn.addEventListener('click', () => {
            const prompt = `use https://projects.dev/skill.md to clone this stack: stripe projects init --from ${getStackUrl()}`;
            animateCopyButton(promptBtn, prompt);
        });
    };
    copyButtons();

    // Input gradient follow cursor (supports multiple [data-container-hover-follow] elements)
    function followCursorOnHover() {
        const containers = document.querySelectorAll('[data-container-hover-follow]');
        if (!containers.length) return;

        const ease = 0.12;

        containers.forEach((container) => {
            const follower = container.querySelector('[data-hover-follow]');
            if (!follower) return;

            let currentX = 0;
            let currentY = 0;
            let targetX = 0;
            let targetY = 0;
            let isHovering = false;
            let animationId = null;

            function getFollowerSize() {
                const r = follower.getBoundingClientRect();
                return { width: r.width, height: r.height };
            }

            function updatePosition() {
                const { width: followerWidth, height: followerHeight } = getFollowerSize();
                if (!isHovering && Math.abs(targetX - currentX) < 0.5 && Math.abs(targetY - currentY) < 0.5) {
                    cancelAnimationFrame(animationId);
                    animationId = null;
                    return;
                }
                currentX += (targetX - currentX) * ease;
                currentY += (targetY - currentY) * ease;
                follower.style.transform = `translate(${currentX - followerWidth / 2}px, ${currentY - followerHeight / 2}px)`;
                animationId = requestAnimationFrame(updatePosition);
            }

            container.addEventListener('mouseenter', (e) => {
                isHovering = true;
                const rect = container.getBoundingClientRect();
                targetX = e.clientX - rect.left;
                targetY = e.clientY - rect.top;
                currentX = targetX;
                currentY = targetY;
                const { width: followerWidth, height: followerHeight } = getFollowerSize();
                follower.style.transform = `translate(${currentX - followerWidth / 2}px, ${currentY - followerHeight / 2}px)`;
                follower.style.transition = 'opacity 0.3s ease-out';
                follower.style.opacity = '1';
                if (!animationId) {
                    animationId = requestAnimationFrame(updatePosition);
                }
            });

            container.addEventListener('mousemove', (e) => {
                const rect = container.getBoundingClientRect();
                targetX = e.clientX - rect.left;
                targetY = e.clientY - rect.top;
                if (!animationId) {
                    animationId = requestAnimationFrame(updatePosition);
                }
            });

            container.addEventListener('mouseleave', () => {
                isHovering = false;
                follower.style.transition = 'opacity 0.4s ease-out';
                follower.style.opacity = '0';
            });
        });
    }
    followCursorOnHover();

    // Fade in the wave once the WebGL canvas has rendered its first frame
    function fadeInWave() {
        const wrapper = document.querySelector('[data-wave-fade]');
        const waveEl = wrapper && wrapper.querySelector("[data-js-target='nouveau-bloom-wave']");
        if (!wrapper || !waveEl) return;

        function reveal() {
            requestAnimationFrame(() => {
                wrapper.classList.remove('opacity-0');
            });
        }

        const canvas = waveEl.querySelector('canvas');
        if (canvas) { reveal(); return; }

        const observer = new MutationObserver((_, obs) => {
            if (waveEl.querySelector('canvas')) {
                obs.disconnect();
                requestAnimationFrame(reveal);
            }
        });
        observer.observe(waveEl, { childList: true });
    };
    fadeInWave();

</script>