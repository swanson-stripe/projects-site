{
  "name": "getricher",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "watch:html": "eleventy --serve --incremental",
    "build:html": "eleventy",
    "dev:css": "tailwindcss -i src/assets/css/main.css -o dist/assets/css/main.css",
    "watch:css": "tailwindcss -i src/assets/css/main.css -o dist/assets/css/main.css --watch",
    "build:css": "tailwindcss -i src/assets/css/main.css -o dist/assets/css/main.css --minify",
    "watch:all": "npm run watch:html & npm run watch:css",
    "start": "npm run clean && npm run dev:css && npm run watch:all",
    "build": "npm run clean && npm run build:html && npm run build:css",
    "sync:providers": "node scripts/sync-provider-docs.mjs",
    "sync:skill": "node scripts/sync-skill-digest.mjs",
    "sync": "npm run sync:providers && npm run sync:skill",
    "test:unit": "node --test test/api-handlers.test.mjs",
    "test:dist": "node --test test/agent-readiness.test.mjs",
    "test": "npm run build && node --test \"test/*.test.mjs\""
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-img": "^6.0.1",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
    "@11ty/eleventy-plugin-webc": "^0.12.0-beta.7",
    "@tailwindcss/cli": "^4.0.14",
    "@types/react": "^19.2.14",
    "gray-matter": "^4.0.3",
    "html-minifier-terser": "^7.2.0",
    "js-yaml": "^4.1.1",
    "markdown-it": "^14.1.1",
    "tailwindcss": "^4.0.14"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "^0.11.1"
  }
}
