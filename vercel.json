{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "provisioning.dev" }],
      "destination": "/marketplace/bold/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.provisioning.dev" }],
      "destination": "/marketplace/bold/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "provisioning.stripe.dev" }],
      "destination": "/marketplace/bold/",
      "permanent": false
    },
    {
      "source": "/marketplace/:path*",
      "has": [{ "type": "host", "value": "projects.dev" }],
      "destination": "https://provisioning.dev/marketplace/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</.well-known/api-catalog>; rel=\"api-catalog\", </docs/api/>; rel=\"service-doc\", </index.html.md>; rel=\"alternate\"; type=\"text/markdown\""
        },
        {
          "key": "Vary",
          "value": "Accept, User-Agent"
        }
      ]
    },
    {
      "source": "/.well-known/api-catalog",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/linkset+json; charset=utf-8"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/auth.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/index.html.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/leaderboard/_vercel/insights/:path*", "destination": "https://stripe-projects-leaderboard.vercel.app/_vercel/insights/:path*" },
    { "source": "/leaderboard", "destination": "https://stripe-projects-leaderboard.vercel.app/leaderboard" },
    { "source": "/hackathon", "destination": "https://stripe-projects-leaderboard.vercel.app/hackathon" },
    { "source": "/hackathon-participants", "destination": "https://stripe-projects-leaderboard.vercel.app/hackathon-participants" },
    { "source": "/hackathon-admin", "destination": "https://stripe-projects-leaderboard.vercel.app/hackathon-admin" },
    { "source": "/shipaton2026-participants", "destination": "https://stripe-projects-leaderboard.vercel.app/shipaton2026-participants" },
    { "source": "/community-participants", "destination": "https://stripe-projects-leaderboard.vercel.app/community-participants" },
    { "source": "/api/leaderboard", "destination": "https://stripe-projects-leaderboard.vercel.app/api/leaderboard" },
    { "source": "/api/projects", "destination": "https://stripe-projects-leaderboard.vercel.app/api/projects" },
    { "source": "/api/vote", "destination": "https://stripe-projects-leaderboard.vercel.app/api/vote" },
    { "source": "/api/validate-repo", "destination": "https://stripe-projects-leaderboard.vercel.app/api/validate-repo" },
    { "source": "/api/auth/:path*", "destination": "https://stripe-projects-leaderboard.vercel.app/api/auth/:path*" },
    { "source": "/api/admin/:path*", "destination": "https://stripe-projects-leaderboard.vercel.app/api/admin/:path*" },
    { "source": "/_next/:path*", "destination": "https://stripe-projects-leaderboard.vercel.app/_next/:path*" },
    { "source": "/__clerk/:path*", "destination": "https://stripe-projects-leaderboard.vercel.app/__clerk/:path*" },
    { "source": "/textures/:path*", "destination": "https://stripe-projects-leaderboard.vercel.app/textures/:path*" },
    { "source": "/favicon.svg", "destination": "https://stripe-projects-leaderboard.vercel.app/favicon.svg" }
  ]
}
